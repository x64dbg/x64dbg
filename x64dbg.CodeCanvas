		"src/gui/Src/Tracer/TraceFileReader.cpp-simstep-7e90949a-cf84-42cb-9210-856c20a675fd": {
			"path": "src/gui/Src/Tracer/TraceFileReader.cpp-simstep-7e90949a-cf84-42cb-9210-856c20a675fd",
			"fileName": "TraceFileReader.cpp",
			"wiki": "The `TraceFileReader` opens the file and parses the trace records in a background thread. As data becomes available, it populates the `TraceBrowser` (the main instruction list view) with the traced instructions.",
			"cellName": "Trace Viewing: File Parsing and Display - TraceFileReader.cpp:L26-33",
			"cellId": "3a154fc7-aabe-4b92-bb52-ba8280d633ad",
			"visible": true,
