			"parentPath": "src/dbg/TraceRecord.cpp",
			"simSteps": [
				{
					"simulationKey": "Execution Tracing and Logging",
					"simStepId": "2dc749ec-65d6-4902-b26b-6427c831142a"
				}
			]
		},
		"823d2f63-d399-438b-94be-c8fc2a281fcc": {
			"path": "823d2f63-d399-438b-94be-c8fc2a281fcc",
			"cellName": "Trace Recording: Instruction Context Recorded and Written to File - TraceRecord.cpp:L257-428",
			"cellId": "823d2f63-d399-438b-94be-c8fc2a281fcc",
			"visible": true,
			"parentCellId": "18f222b5-232b-4cc4-b667-ded522d09c93"
		},
		"src/dbg/TraceRecord.cpp-simstep-68e04453-512f-4dbf-9865-f0f587efbd71": {
			"path": "src/dbg/TraceRecord.cpp-simstep-68e04453-512f-4dbf-9865-f0f587efbd71",
			"fileName": "TraceRecord.cpp",
			"wiki": "`dbgtraceexecute` checks if recording is enabled. If so, it calls `TraceRecord.TraceExecuteRecord`, which gathers the complete CPU context (registers, flags, memory operands), serializes it, and writes the data to the previously opened trace file.",
			"cellName": "Trace Recording: Instruction Context Recorded and Written to File - TraceRecord.cpp:L257-428",
			"cellId": "823d2f63-d399-438b-94be-c8fc2a281fcc",
			"visible": true,
			"startLine": 257,
			"endLine": 428,
			"parentCellId": "18f222b5-232b-4cc4-b667-ded522d09c93",
			"parentPath": "src/dbg/TraceRecord.cpp",
			"simSteps": [
				{
					"simulationKey": "Execution Tracing and Logging",
					"simStepId": "68e04453-512f-4dbf-9865-f0f587efbd71"
				}
			]
		},
		"9afcf68d-2e7f-4d8f-8bc8-8dd57b0c8c16": {
			"path": "9afcf68d-2e7f-4d8f-8bc8-8dd57b0c8c16",
			"cellName": "Trace Viewing: User Opens Trace File - TraceManager.cpp:L48-62",
			"cellId": "9afcf68d-2e7f-4d8f-8bc8-8dd57b0c8c16",
			"visible": true,
			"parentCellId": "b01947dd-09b9-435e-8008-12065f2c19e8"
		},
		"src/gui/Src/Tracer/TraceManager.cpp-simstep-73c95760-f511-4b95-869f-52546f34f559": {
			"path": "src/gui/Src/Tracer/TraceManager.cpp-simstep-73c95760-f511-4b95-869f-52546f34f559",
			"fileName": "TraceManager.cpp",
			"wiki": "The user opens the 'Trace' view and selects a previously saved trace file. The `TraceManager` handles this action by creating a new `TraceWidget` to display the file's contents.",
			"cellName": "Trace Viewing: User Opens Trace File - TraceManager.cpp:L48-62",
			"cellId": "9afcf68d-2e7f-4d8f-8bc8-8dd57b0c8c16",
