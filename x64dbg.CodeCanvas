							"DbgCmdExec"
						]
					},
					"inputDataExample": "{\"event\": \"User clicks 'Debug -> Run' menu item\"}",
					"outputDataExample": "{\"command\": \"run\"}"
				},
				{
					"simStepId": "235fbc1c-e3da-4897-a1c3-db15aa9a9d59",
					"diagramNodeId": "58e3ab7e-8448-46fa-9dae-98ea15a97cfe",
					"simStepLabel": "Data Flow: Command String to Bridge",
					"simStepDescription": "The command string, 'run', is passed as an argument to the `DbgCmdExec` function. This function serves as the entry point into the bridge layer, which facilitates communication between the GUI and the debugger backend.",
					"isEdge": 1,
					"sourceCodeMapping": {
						"filePath": "",
						"startLine": "0",
						"endLine": "0",
						"relevantVariables": []
					},
					"inputDataExample": "{\"command\": \"run\"}",
					"outputDataExample": "{\"command\": "
