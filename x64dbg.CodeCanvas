		},
		"47d8fec6-fede-487f-b606-e6ea172da821": {
			"path": "47d8fec6-fede-487f-b606-e6ea172da821",
			"cellName": "Memory Breakpoint: Command Handling - cmd-breakpoint-control.cpp:L700-757",
			"cellId": "47d8fec6-fede-487f-b606-e6ea172da821",
			"visible": true,
			"parentCellId": "ba99272b-eb91-4c4f-a611-d18a633ce338"
		},
		"src/dbg/commands/cmd-breakpoint-control.cpp-simstep-315773ce-f795-4397-a2d2-b7bccc97116c": {
			"path": "src/dbg/commands/cmd-breakpoint-control.cpp-simstep-315773ce-f795-4397-a2d2-b7bccc97116c",
			"fileName": "cmd-breakpoint-control.cpp",
			"wiki": "The `cbDebugSetMemoryBpx` function handles the command. It determines the base address and size of the memory page containing the specified address. It then creates an internal record for the breakpoint and calls the engine to apply a page guard.",
			"cellName": "Memory Breakpoint: Command Handling - cmd-breakpoint-control.cpp:L700-757",
			"cellId": "47d8fec6-fede-487f-b606-e6ea172da821",
			"visible": true,
			"startLine": 700,
			"endLine": 757,
			"parentCellId": "ba99272b-eb91-4c4f-a611-d18a633ce338",
			"parentPath": "src/dbg/commands/cmd-breakpoint-control.cpp",
			"simSteps": [
				{
					"simulationKey": "Advanced Breakpoint Management",
					"simStepId": "315773ce-f795-4397-a2d2-b7bccc97116c"
				}
			]
		},
		"ec6378da-2ccc-481a-9fdb-0eeb78a27d33": {
			"path": "ec6378da-2ccc-481a-9fdb-0eeb78a27d33",
			"cellName": "Memory Breakpoint: Apply PAGE_GUARD Protection - cmd-breakpoint-control.cpp:L753-757",
			"cellId": "ec6378da-2ccc-481a-9fdb-0eeb78a27d33",
			"visible": true,
			"parentCellId": "ba99272b-eb91-4c4f-a611-d18a633ce338"
		},
		"src/dbg/commands/cmd-breakpoint-control.cpp-simstep-7d626bab-56a5-4a7c-b269-cc260bf45f51": {
			"path": "src/dbg/commands/cmd-breakpoint-control.cpp-simstep-7d626bab-56a5-4a7c-b269-cc260bf45f51",
			"fileName": "cmd-breakpoint-control.cpp",
			"wiki": "The `SetMemoryBPXEx` function uses `VirtualProtectEx` to add the `PAGE_GUARD` protection flag to the specified memory page. When the debuggee attempts to access this page, a `STATUS_GUARD_PAGE_VIOLATION` exception is raised, which the debugger catches. This allows breaking on read, write, or execution access to an entire memory page.",
			"cellName": "Memory Breakpoint: Apply PAGE_GUARD Protection - cmd-breakpoint-control.cpp:L753-757",
			"cellId": "ec6378da-2ccc-481a-9fdb-0eeb78a27d33",
			"visible": true,
			"startLine": 753,
			"endLine": 757,
			"parentCellId": "ba99272b-eb91-4c4f-a611-d18a633ce338",
			"parentPath": "src/dbg/commands/cmd-breakpoint-control.cpp",
			"simSteps": [
				{
					"simulationKey": "Advanced Breakpoint Management",
					"simStepId": "7d626bab-56a5-4a7c-b269-cc260bf45f51"
				}
			]
		},
