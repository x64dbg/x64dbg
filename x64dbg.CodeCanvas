		"Execution Tracing and Logging": {
			"name": "Execution Tracing and Logging",
			"simSteps": [
				{
					"simStepId": "b43b6f23-5aa2-4a45-8404-d5e3a94f7921",
					"diagramNodeId": "f44718f5-f67d-43bd-9b9e-fd8d6752a5ae",
					"simStepLabel": "Trace Recording: User Enables Trace Coverage",
					"simStepDescription": "The user right-clicks on the CPU disassembly view and selects a trace coverage type (e.g., 'Byte'). This action triggers a slot that initiates the process of setting up trace recording for the memory pages visible in the view.",
					"isEdge": 0,
					"sourceCodeMapping": {
						"filePath": "src/gui/Src/Gui/CPUDisassembly.cpp",
						"startLine": "1944",
						"endLine": "1953",
						"relevantVariables": [
							"CPUDisassembly::traceCoverageByteSlot",
							"DbgFunctions",
							"SetTraceRecordType"
						]
					},
					"inputDataExample": "{\"user_action\": \"Right-click -> Trace coverage -> Byte\"}",
					"outputDataExample": "{\"page_address\": \"0x1000\", \"trace_type\": \"TraceRecordByteWithExecTypeAndCounter\"}"
				},
				{
					"simStepId": "214168a9-bd6b-49e4-90ee-275d4bdf2551",
					"diagramNodeId": "1bd9ce72-ff60-4887-a9f4-27e55a253cc1",
					"simStepLabel": "Trace Recording: Coverage Request to Backend",
					"simStepDescription": "The GUI calls the `SetTraceRecordType` bridge function for each relevant memory page, sending the request from the GUI process to the debugger backend process.",
					"isEdge": 1,
					"sourceCodeMapping": {
						"filePath": "src/dbg/_dbgfunctions.cpp",
						"startLine": "372",
						"endLine": "375",
						"relevantVariables": [
							"_dbgfunctions.SetTraceRecordType"
						]
					},
					"inputDataExample": "{\"page_address\": \"0x1000\", \"type\": \"TraceRecordByteWithExecTypeAndCounter\"}",
					"outputDataExample": "{\"page_address\": \"0x1000\", \"type\": \"TraceRecordByteWithExecTypeAndCounter\"}"
				},
				{
					"simStepId": "79986a05-5268-479a-bb68-3efc9aef5db0",
					"diagramNodeId": "0551e5aa-4e62-46cb-a881-a39c1152226c",
					"simStepLabel": "Trace Recording: Backend Allocates Trace Page",
					"simStepDescription": "The `TraceRecordManager` in the debugger backend receives the request. It finds or creates a `TraceRecordPage` for the specified memory address and allocates a corresponding buffer to store the trace data for that page.",
					"isEdge": 0,
					"sourceCodeMapping": {
						"filePath": "src/dbg/TraceRecord.cpp",
						"startLine": "35",
						"endLine": "82",
						"relevantVariables": [
							"TraceRecordManager::setTraceRecordType",
							"TraceRecord",
							"newPage",
							"emalloc"
						]
					},
					"inputDataExample": "{\"pageAddress\": \"0x1000\", \"type\": \"TraceRecordByteWithExecTypeAndCounter\"}",
					"outputDataExample": "{\"pageInfo\": {\"rawPtr\": \"0x...\", \"rva\": \"0x1000\", \"dataType\": \"TraceRecordByteWithExecTypeAndCounter\"}, \"status\": true}"
				},
				{
					"simStepId": "31b3c977-951d-44f3-90ed-dfe0c07edb1f",
					"diagramNodeId": "db5794a5-4249-45e6-b51c-944d66161a2d",
					"simStepLabel": "Trace Recording: Start Recording Command",
					"simStepDescription": "The user issues the 'StartRunTrace' command, providing a file path to save the execution trace.",
					"isEdge": 1,
					"sourceCodeMapping": {
						"filePath": "src/dbg/commands/cmd-tracing.cpp",
						"startLine": "177",
						"endLine": "182",
						"relevantVariables": [
							"cbDebugStartTraceRecording"
						]
					},
					"inputDataExample": "{\"command\": \"StartRunTrace C:\\\\traces\\\\mytrace.trace\"}",
					"outputDataExample": "{\"command\": \"StartRunTrace C:\\\\traces\\\\mytrace.trace\"}"
				},
				{
					"simStepId": "2dc749ec-65d6-4902-b26b-6427c831142a",
					"diagramNodeId": "c1313ed4-38f3-477d-a018-6fa1b0b0fd5f",
					"simStepLabel": "Trace Recording: Backend Enables Recording",
					"simStepDescription": "The command handler calls `TraceRecord.enableTraceRecording`. This function opens the specified file for writing and sets a boolean flag (`rtEnabled`) to indicate that trace recording is active.",
					"isEdge": 0,
					"sourceCodeMapping": {
						"filePath": "src/dbg/TraceRecord.cpp",
						"startLine": "502",
						"endLine": "550",
						"relevantVariables": [
							"TraceRecordManager::enableTraceRecording",
							"rtEnabled",
							"rtFile",
							"rtHandle"
						]
					},
					"inputDataExample": "{\"enabled\": true, \"fileName\": \"C:\\\\traces\\\\mytrace.trace\"}",
					"outputDataExample": "{\"status\": true}"
				},
				{
					"simStepId": "9506ea48-556a-466c-9e96-9cbfca4e9df3",
					"diagramNodeId": "409e8354-1b29-43e4-9ac2-8afbd9eb715b",
					"simStepLabel": "Trace Recording: Instruction Execution",
					"simStepDescription": "As the debugger single-steps or runs, its main debug loop invokes the `dbgtraceexecute` hook for each executed instruction, passing the current instruction pointer (CIP).",
					"isEdge": 1,
					"sourceCodeMapping": {
						"filePath": "src/dbg/TraceRecord.cpp",
						"startLine": "705",
						"endLine": "705",
						"relevantVariables": [
							"dbgtraceexecute",
							"CIP"
						]
					},
					"inputDataExample": "{\"CIP\": \"0x004015A0\"}",
					"outputDataExample": "{\"CIP\": \"0x004015A0\"}"
				},
				{
					"simStepId": "68e04453-512f-4dbf-9865-f0f587efbd71",
					"diagramNodeId": "823d2f63-d399-438b-94be-c8fc2a281fcc",
					"simStepLabel": "Trace Recording: Instruction Context Recorded and Written to File",
					"simStepDescription": "`dbgtraceexecute` checks if recording is enabled. If so, it calls `TraceRecord.TraceExecuteRecord`, which gathers the complete CPU context (registers, flags, memory operands), serializes it, and writes the data to the previously opened trace file.",
					"isEdge": 0,
					"sourceCodeMapping": {
						"filePath": "src/dbg/TraceRecord.cpp",
						"startLine": "257",
						"endLine": "428",
						"relevantVariables": [
							"TraceRecordManager::TraceExecuteRecord",
							"WriteBuffer",
							"rtHandle",
							"dbgtracebrowserneedsupdate"
						]
					},
					"inputDataExample": "{\"CIP\": \"0x004015A0\", \"instruction_bytes\": \"\\x55\\x8B\\xEC\"}",
					"outputDataExample": "{\"bytes_written\": 256}"
				},
				{
					"simStepId": "73c95760-f511-4b95-869f-52546f34f559",
					"diagramNodeId": "9afcf68d-2e7f-4d8f-8bc8-8dd57b0c8c16",
					"simStepLabel": "Trace Viewing: User Opens Trace File",
					"simStepDescription": "The user opens the 'Trace' view and selects a previously saved trace file. The `TraceManager` handles this action by creating a new `TraceWidget` to display the file's contents.",
					"isEdge": 0,
					"sourceCodeMapping": {
						"filePath": "src/gui/Src/Tracer/TraceManager.cpp",
						"startLine": "48",
						"endLine": "62",
						"relevantVariables": [
							"TraceManager::openSlot",
							"newView",
							"TraceWidget"
						]
					},
					"inputDataExample": "{\"user_action\": \"File -> Open Trace -> C:\\\\traces\\\\mytrace.trace\"}",
					"outputDataExample": "{\"path\": \"C:\\\\traces\\\\mytrace.trace\"}"
				},
				{
					"simStepId": "ad7bf8c6-9920-429a-baf4-53965e4d98ac",
					"diagramNodeId": "35413cee-49a6-43b4-a23d-756f0172c5ae",
					"simStepLabel": "Trace Viewing: File Path Transmission",
					"simStepDescription": "The file path is passed to the `TraceWidget` constructor. The widget then instantiates a `TraceFileReader` to handle the file I/O and parsing.",
					"isEdge": 1,
					"sourceCodeMapping": {
						"filePath": "src/gui/Src/Tracer/TraceWidget.cpp",
						"startLine": "15",
						"endLine": "22",
						"relevantVariables": [
							"TraceWidget::TraceWidget",
							"fileName"
						]
					},
					"inputDataExample": "{\"fileName\": \"C:\\\\traces\\\\mytrace.trace\"}",
					"outputDataExample": "{\"fileName\": \"C:\\\\traces\\\\mytrace.trace\"}"
				},
				{
					"simStepId": "7e90949a-cf84-42cb-9210-856c20a675fd",
					"diagramNodeId": "3a154fc7-aabe-4b92-bb52-ba8280d633ad",
					"simStepLabel": "Trace Viewing: File Parsing and Display",
					"simStepDescription": "The `TraceFileReader` opens the file and parses the trace records in a background thread. As data becomes available, it populates the `TraceBrowser` (the main instruction list view) with the traced instructions.",
					"isEdge": 0,
					"sourceCodeMapping": {
						"filePath": "src/gui/Src/Tracer/TraceFileReader.cpp",
						"startLine": "26",
						"endLine": "33",
						"relevantVariables": [
							"TraceFileReader::Open",
							"parser"
						]
					},
					"inputDataExample": "{\"file_handle\": \"...\"}",
					"outputDataExample": "{\"trace_record_count\": 15000}"
				},
				{
					"simStepId": "f896d2dd-5f27-4f6c-bd5b-2cf23914d7c2",
					"diagramNodeId": "e8d7757d-7ab4-4faf-839d-53b10867f9f8",
					"simStepLabel": "Trace Viewing: User Selection",
					"simStepDescription": "The user clicks on an instruction in the `TraceBrowser` list. This action emits a signal containing the index of the selected trace record.",
					"isEdge": 1,
					"sourceCodeMapping": {
						"filePath": "src/gui/Src/Tracer/TraceBrowser.cpp",
						"startLine": "66",
						"endLine": "66",
						"relevantVariables": [
							"selectionChanged"
						]
					},
					"inputDataExample": "{\"user_action\": \"Click on row 1234 in TraceBrowser\"}",
					"outputDataExample": "{\"selection_index\": 1234}"
				},
				{
					"simStepId": "b970b3a9-9fe3-48cc-97a5-3bea99563a26",
					"diagramNodeId": "74c968ed-51f7-4121-a5bb-6565bafc8bd6",
					"simStepLabel": "Trace Viewing: UI Updates with Context",
					"simStepDescription": "A slot in `TraceWidget` receives the selected index. It fetches the corresponding register dump and memory context from the `TraceFileReader` and updates all context-sensitive views, including the Registers, Dump, Stack, and Info Box, to reflect the state of the program at that point in the trace.",
					"isEdge": 0,
					"sourceCodeMapping": {
						"filePath": "src/gui/Src/Tracer/TraceWidget.cpp",
						"startLine": "121",
						"endLine": "145",
						"relevantVariables": [
							"TraceWidget::traceSelectionChanged",
							"mTraceFile",
							"mGeneralRegs->setRegisters"
						]
					},
					"inputDataExample": "{\"selection\": 1234}",
					"outputDataExample": "{\"registers\": {\"EAX\": \"0x0019FF00\", \"ECX\": \"0x...\"}}"
				},
				{
					"simStepId": "f08df488-9eef-4381-8a68-284a47de7294",
					"diagramNodeId": "98eac7f7-8a91-46ca-ac22-a9a33a7b02d8",
					"simStepLabel": "Logging: Backend Generates Log Message",
					"simStepDescription": "Various components in the debugger backend generate messages to inform the user of events (e.g., breakpoint hit, module loaded, errors). These components call the `GuiAddLogMessage` bridge function.",
					"isEdge": 0,
					"sourceCodeMapping": {
						"filePath": "src/gui/Src/Gui/CPUDisassembly.cpp",
						"startLine": "1932",
						"endLine": "1932",
						"relevantVariables": [
							"GuiAddLogMessage"
						]
					},
					"inputDataExample": "{\"event\": \"Breakpoint hit at 0x77E71D3A\"}",
					"outputDataExample": "{\"message\": \"Breakpoint hit at 0x77E71D3A\\n\"}"
				},
				{
					"simStepId": "547c625c-f825-44df-aafb-f3d75e9d8d33",
					"diagramNodeId": "9c61c68b-d911-4a03-a607-1f1adeeb5952",
					"simStepLabel": "Logging: Message Transmitted via Bridge",
					"simStepDescription": "The message string is sent from the debugger backend process to the GUI process via the bridge, which uses signals and slots for inter-process communication.",
					"isEdge": 1,
					"sourceCodeMapping": {
						"filePath": "src/gui/Src/Bridge/Bridge.cpp",
						"startLine": "119",
						"endLine": "119",
						"relevantVariables": [
							"addMsgToLog"
						]
					},
					"inputDataExample": "{\"message\": \"Log is not redirected.\\n\"}",
					"outputDataExample": "{\"message\": \"Log is not redirected.\\n\"}"
				},
				{
					"simStepId": "fe1aa067-438e-4fb2-99b7-29e5d83a6b4e",
					"diagramNodeId": "17616057-f8d8-4e2c-8ebd-3a6eb2209bc8",
					"simStepLabel": "Logging: GUI Buffers Log Message",
					"simStepDescription": "The `LogView` widget in the GUI has a slot connected to the bridge's signal. To prevent the UI from freezing due to a high volume of messages, it adds the incoming message to a temporary buffer (`logBuffer`) instead of rendering it immediately.",
					"isEdge": 0,
					"sourceCodeMapping": {
						"filePath": "src/gui/Src/Gui/LogView.cpp",
						"startLine": "257",
						"endLine": "366",
						"relevantVariables": [
							"LogView::addMsgToLogSlotRaw",
							"logBuffer",
							"flushLog"
						]
					},
					"inputDataExample": "{\"message\": \"Log is not redirected.\\n\"}",
					"outputDataExample": "{\"logBuffer_size\": 1}"
				},
				{
					"simStepId": "3297b567-dd4f-409a-8b4a-90f53365772f",
					"diagramNodeId": "11205589-2a3d-46da-8fab-8aa411d2fbd2",
					"simStepLabel": "Logging: Flush Timer Signal",
					"simStepDescription": "A `QTimer` fires at a regular interval, triggering a slot responsible for flushing the buffered log messages to the screen.",
					"isEdge": 1,
					"sourceCodeMapping": {
						"filePath": "src/gui/Src/Gui/LogView.cpp",
						"startLine": "41",
						"endLine": "41",
						"relevantVariables": [
							"flushTimer"
						]
					},
					"inputDataExample": "{\"event\": \"QTimer::timeout\"}",
					"outputDataExample": "{\"event\": \"QTimer::timeout\"}"
				},
				{
					"simStepId": "e9aa1e85-4fc3-47e7-9451-90c4a9ed7ec8",
					"diagramNodeId": "bd7cd074-fdfd-41a5-b5bf-ba05edcfee82",
					"simStepLabel": "Logging: GUI Renders Buffered Logs",
					"simStepDescription": "The flush timer's slot takes all the messages accumulated in `logBuffer`, appends them in a single operation to the `QTextBrowser` widget, and clears the buffer. This batch update strategy improves performance significantly.",
					"isEdge": 0,
					"sourceCodeMapping": {
						"filePath": "src/gui/Src/Gui/LogView.cpp",
						"startLine": "572",
						"endLine": "597",
						"relevantVariables": [
							"LogView::flushTimerSlot",
							"logBuffer",
							"this->append"
						]
					},
					"inputDataExample": "{\"logBuffer\": [\"Message 1\\n\", \"Message 2\\n\"]}",
					"outputDataExample": "{\"logBuffer\": []}"
				}
			],
			"description": "<ul><li>For complex code paths, tracing allows for a historical view of execution, while logging provides a record of all significant events</li><li>- Perform a 'run trace' to record every executed instruction along with its context (register values)</li><li>- Use conditional tracing to only log instructions that match a certain condition, reducing noise</li><li>- Step backwards and forwards through the execution history in the trace view</li><li>- Monitor all debugger events, API calls, debug strings, and script outputs in a centralized log window</li></ul>",
			"simulationNodesAndEdges": {
				"f44718f5-f67d-43bd-9b9e-fd8d6752a5ae": {
