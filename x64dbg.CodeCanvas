					},
					"inputDataExample": "{\"command\": \"run\"}",
					"outputDataExample": "{\"command\": \"run\"}"
				},
				{
					"simStepId": "70cdea0e-833e-4fb6-885f-e2755c888c93",
					"diagramNodeId": "47bbaadd-4e02-4a1c-9432-e72d36071b06",
					"simStepLabel": "Backend: Command Received by Command Loop",
					"simStepDescription": "A dedicated command processing thread in the debugger backend continuously runs `cmdloop()`. Inside this loop, `cbCommandProvider` waits for and retrieves the next command string from a message queue, which was sent by the GUI via the bridge.",
					"isEdge": 0,
					"sourceCodeMapping": {
						"filePath": "src/dbg/x64dbg.cpp",
						"startLine": "508",
						"endLine": "517",
						"relevantVariables": [
							"cbCommandProvider",
							"gMsgQueue",
							"MsgWait",
							"cmd"
						]
					},
					"inputDataExample": "{\"messageQueueContent\": \"run\"}",
					"outputDataExample": "{\"retrievedCommand\": \"run\"}"
				},
				{
					"simStepId": "6ba834f5-2358-469b-b838-6a18e45e7602",
					"diagramNodeId": "a0c79d85-cbc9-4f94-a7f9-1b0a7bf4a284",
					"simStepLabel": "Data Flow: Command String to Processor",
					"simStepDescription": "The retrieved command string is passed from the command provider into the main body of the `cmdloop` function for processing and execution.",
					"isEdge": 1,
					"sourceCodeMapping": {
						"filePath": "src/dbg/command.cpp",
						"startLine": "285",
						"endLine": "288",
						"relevantVariables": [
							"cmdloop",
							"cbCommandProvider",
							"command_"
						]
					},
					"inputDataExample": "{\"retrievedCommand\": \"run\"}",
					"outputDataExample": "{\"retrievedCommand\": \"run\"}"
				},
				{
					"simStepId": "1765271b-8671-42f9-996a-2d0fd40f7e96",
					"diagramNodeId": "dcfc3b35-e1be-49c3-938b-60d54342a83e",
					"simStepLabel": "Backend: Command Handler Lookup",
					"simStepDescription": "The `cmdloop` function takes the command string and uses `cmdget` to search through a globally registered list of `COMMAND` structures. It looks for a structure whose name matches the command ('run'). This list is populated at startup by functions like `dbgcmdnew`.",
					"isEdge": 0,
					"sourceCodeMapping": {
						"filePath": "src/dbg/command.cpp",
						"startLine": "296",
						"endLine": "297",
						"relevantVariables": [
