					"simulationKey": "Binary Patching and In-Memory Modification",
					"simStepId": "6191ef16-1f19-44d3-9419-95dec55272bd"
				}
			]
		},
		"4d638c55-18c7-4008-b502-7af9c23e0e6f": {
			"path": "4d638c55-18c7-4008-b502-7af9c23e0e6f",
			"cellName": "User Toggles a Patch - PatchDialog.cpp:L283-318",
			"cellId": "4d638c55-18c7-4008-b502-7af9c23e0e6f",
			"visible": true,
			"parentCellId": "d62ef82d-d2bf-4d04-8c80-837253eb26fe"
