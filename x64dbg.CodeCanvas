		"src/gui/Src/Gui/SettingsDialog.cpp-simstep-923044f5-e271-48fb-abf2-a6c57b5d1420": {
			"path": "src/gui/Src/Gui/SettingsDialog.cpp-simstep-923044f5-e271-48fb-abf2-a6c57b5d1420",
			"fileName": "SettingsDialog.cpp",
			"wiki": "The user interacts with the settings dialog to add a new exception filter. The dialog's logic adds the new filter to an in-memory list, merging it with any existing overlapping ranges and then refreshes the UI.",
			"cellName": "Config Flow: User Modifies Exception Filter - SettingsDialog.cpp:L508-531",
			"cellId": "025a9a5c-2355-47e6-b091-ee4fb34ed045",
			"visible": true,
			"startLine": 508,
