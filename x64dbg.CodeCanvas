		"src/gui/Src/Gui/PatchDialog.cpp-simstep-f12d75be-9e3d-4205-9ea0-24222da97009": {
			"path": "src/gui/Src/Gui/PatchDialog.cpp-simstep-f12d75be-9e3d-4205-9ea0-24222da97009",
			"fileName": "PatchDialog.cpp",
			"wiki": "The user unchecks a patch in the `PatchDialog` list. This triggers the `on_listPatches_itemChanged` slot. The function determines the new state and prepares to write the original byte back to memory to disable the patch.",
			"cellName": "User Toggles a Patch - PatchDialog.cpp:L283-318",
			"cellId": "4d638c55-18c7-4008-b502-7af9c23e0e6f",
			"visible": true,
			"startLine": 283,
