			"startLine": 1101,
			"endLine": 1103,
			"parentCellId": "1aca0727-220e-4e86-9f51-5f817495d75b",
			"parentPath": "src/dbg/_exports.cpp",
			"simSteps": [
				{
					"simulationKey": "Exception Handling Control",
					"simStepId": "00d3408e-5903-429b-9c09-d396735bcb05"
				}
			]
		},
		"f225cc3e-0917-4292-90f0-6ea5bb5fbc95": {
			"path": "f225cc3e-0917-4292-90f0-6ea5bb5fbc95",
			"cellName": "Config Flow: Backend Deserializes String into Filter Objects - _exports.cpp:L1105-1133",
			"cellId": "f225cc3e-0917-4292-90f0-6ea5bb5fbc95",
			"visible": true,
			"parentCellId": "1aca0727-220e-4e86-9f51-5f817495d75b"
		},
		"src/dbg/_exports.cpp-simstep-d4ec81fd-91b4-438a-ba5e-45d29b70204d": {
			"path": "src/dbg/_exports.cpp-simstep-d4ec81fd-91b4-438a-ba5e-45d29b70204d",
			"fileName": "_exports.cpp",
			"wiki": "The backend code iterates through each entry in the serialized string, using sscanf_s and string comparisons to parse the values and construct structured ExceptionFilter objects.",
			"cellName": "Config Flow: Backend Deserializes String into Filter Objects - _exports.cpp:L1105-1133",
