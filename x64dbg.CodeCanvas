			"simSteps": [
				{
					"simulationKey": "Execution Tracing and Logging",
					"simStepId": "7e90949a-cf84-42cb-9210-856c20a675fd"
				}
			]
		},
		"74c968ed-51f7-4121-a5bb-6565bafc8bd6": {
			"path": "74c968ed-51f7-4121-a5bb-6565bafc8bd6",
			"cellName": "Trace Viewing: UI Updates with Context - TraceWidget.cpp:L121-145",
			"cellId": "74c968ed-51f7-4121-a5bb-6565bafc8bd6",
			"visible": true,
			"parentCellId": "7ffd6e36-cc02-4f06-8975-5e802cef000c"
		},
		"src/gui/Src/Tracer/TraceWidget.cpp-simstep-b970b3a9-9fe3-48cc-97a5-3bea99563a26": {
			"path": "src/gui/Src/Tracer/TraceWidget.cpp-simstep-b970b3a9-9fe3-48cc-97a5-3bea99563a26",
			"fileName": "TraceWidget.cpp",
			"wiki": "A slot in `TraceWidget` receives the selected index. It fetches the corresponding register dump and memory context from the `TraceFileReader` and updates all context-sensitive views, including the Registers, Dump, Stack, and Info Box, to reflect the state of the program at that point in the trace.",
			"cellName": "Trace Viewing: UI Updates with Context - TraceWidget.cpp:L121-145",
			"cellId": "74c968ed-51f7-4121-a5bb-6565bafc8bd6",
			"visible": true,
			"startLine": 121,
			"endLine": 145,
			"parentCellId": "7ffd6e36-cc02-4f06-8975-5e802cef000c",
			"parentPath": "src/gui/Src/Tracer/TraceWidget.cpp",
			"simSteps": [
				{
					"simulationKey": "Execution Tracing and Logging",
					"simStepId": "b970b3a9-9fe3-48cc-97a5-3bea99563a26"
				}
			]
		},
		"98eac7f7-8a91-46ca-ac22-a9a33a7b02d8": {
			"path": "98eac7f7-8a91-46ca-ac22-a9a33a7b02d8",
			"cellName": "Logging: Backend Generates Log Message - CPUDisassembly.cpp:L1932",
			"cellId": "98eac7f7-8a91-46ca-ac22-a9a33a7b02d8",
