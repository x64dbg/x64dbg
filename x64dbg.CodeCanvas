			"simSteps": [
				{
					"simulationKey": "Advanced Breakpoint Management",
					"simStepId": "47f9d19d-b518-4577-8ece-462aad663bd3"
				}
			]
		},
		"4cd1c5fd-efdf-476e-8472-ffd17cb8607a": {
			"path": "4cd1c5fd-efdf-476e-8472-ffd17cb8607a",
			"cellName": "Hardware Breakpoint: Command Handling - cmd-breakpoint-control.cpp:L400-489",
			"cellId": "4cd1c5fd-efdf-476e-8472-ffd17cb8607a",
			"visible": true,
			"parentCellId": "ba99272b-eb91-4c4f-a611-d18a633ce338"
		},
		"src/dbg/commands/cmd-breakpoint-control.cpp-simstep-49be00f0-66e1-4410-8a77-ff27ef60fd26": {
			"path": "src/dbg/commands/cmd-breakpoint-control.cpp-simstep-49be00f0-66e1-4410-8a77-ff27ef60fd26",
			"fileName": "cmd-breakpoint-control.cpp",
			"wiki": "The `cbDebugSetHardwareBreakpoint` function is executed. It parses the address, access type, and size. It then finds an available hardware debug register (DR0-DR3), creates an internal breakpoint record, and calls the engine to configure the debug registers on the active thread.",
			"cellName": "Hardware Breakpoint: Command Handling - cmd-breakpoint-control.cpp:L400-489",
			"cellId": "4cd1c5fd-efdf-476e-8472-ffd17cb8607a",
			"visible": true,
			"startLine": 400,
			"endLine": 489,
			"parentCellId": "ba99272b-eb91-4c4f-a611-d18a633ce338",
			"parentPath": "src/dbg/commands/cmd-breakpoint-control.cpp",
			"simSteps": [
				{
					"simulationKey": "Advanced Breakpoint Management",
					"simStepId": "49be00f0-66e1-4410-8a77-ff27ef60fd26"
				}
			]
		},
		"e714eb1f-927b-4264-82ea-1b73cd210a20": {
			"path": "e714eb1f-927b-4264-82ea-1b73cd210a20",
			"cellName": "Hardware Breakpoint: Configure Debug Registers - cmd-breakpoint-control.cpp:L485-489",
			"cellId": "e714eb1f-927b-4264-82ea-1b73cd210a20",
			"visible": true,
			"parentCellId": "ba99272b-eb91-4c4f-a611-d18a633ce338"
		},
		"src/dbg/commands/cmd-breakpoint-control.cpp-simstep-8c484b18-ebdc-4a1f-b058-e5af183edf97": {
			"path": "src/dbg/commands/cmd-breakpoint-control.cpp-simstep-8c484b18-ebdc-4a1f-b058-e5af183edf97",
			"fileName": "cmd-breakpoint-control.cpp",
			"wiki": "The `SetHardwareBreakPoint` function modifies the debug registers (DR0-DR7) of the debuggee's thread context. DR0-DR3 store the breakpoint addresses, and DR7 controls the type (read, write, execute), size, and status of these breakpoints. This is a stealthier method as it doesn't modify the code itself.",
			"cellName": "Hardware Breakpoint: Configure Debug Registers - cmd-breakpoint-control.cpp:L485-489",
			"cellId": "e714eb1f-927b-4264-82ea-1b73cd210a20",
			"visible": true,
			"startLine": 485,
			"endLine": 489,
			"parentCellId": "ba99272b-eb91-4c4f-a611-d18a633ce338",
			"parentPath": "src/dbg/commands/cmd-breakpoint-control.cpp",
			"simSteps": [
				{
					"simulationKey": "Advanced Breakpoint Management",
					"simStepId": "8c484b18-ebdc-4a1f-b058-e5af183edf97"
				}
			]
		},
		"e5eca1e5-90ab-42b0-9151-87a559182102": {
			"path": "e5eca1e5-90ab-42b0-9151-87a559182102",
			"cellName": "Hardware Breakpoint: Refresh UI - BreakpointsView.cpp:L212-265",
			"cellId": "e5eca1e5-90ab-42b0-9151-87a559182102",
