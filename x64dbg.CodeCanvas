					"simulationKey": "Exception Handling Control",
					"simStepId": "923044f5-e271-48fb-abf2-a6c57b5d1420"
				}
			]
		},
		"ddaf5636-8f59-4f8f-a14d-2f70738d6749": {
			"path": "ddaf5636-8f59-4f8f-a14d-2f70738d6749",
			"cellName": "Config Flow: Exception Filters Serialized to String - SettingsDialog.cpp:L410-417",
			"cellId": "ddaf5636-8f59-4f8f-a14d-2f70738d6749",
			"visible": true,
			"parentCellId": "6dc5e429-f26e-42c0-a611-68217d8907c6"
		},
		"src/gui/Src/Gui/SettingsDialog.cpp-simstep-31da5905-9136-48e9-acfe-030f36fd4616": {
			"path": "src/gui/Src/Gui/SettingsDialog.cpp-simstep-31da5905-9136-48e9-acfe-030f36fd4616",
			"fileName": "SettingsDialog.cpp",
			"wiki": "The list of ExceptionFilter objects is iterated, and each filter's properties (range, break-on chance, logging, handled-by status) are formatted into a single comma-separated string for storage in the configuration file.",
			"cellName": "Config Flow: Exception Filters Serialized to String - SettingsDialog.cpp:L410-417",
			"cellId": "ddaf5636-8f59-4f8f-a14d-2f70738d6749",
