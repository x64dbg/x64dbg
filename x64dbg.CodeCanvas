	"simulations": {
		"Core Dynamic Analysis: Interactive Program Execution and State Inspection": {
			"name": "Core Dynamic Analysis: Interactive Program Execution and State Inspection",
			"simSteps": [
				{
					"simStepId": "0c2483ee-b7b3-44c9-8ff1-db8f3042700e",
					"diagramNodeId": "549e11c4-72dd-46ca-8635-210aab0924c0",
					"simStepLabel": "User Issues 'Step Into' Command",
					"simStepDescription": "The user executes the 'StepInto' command, either by clicking the 'Step Into' button in the GUI or by typing 'StepInto' in the command bar. The command system dispatches this to the `cbDebugStepInto` function.",
					"isEdge": 0,
					"sourceCodeMapping": {
						"filePath": "src/dbg/commands/cmd-debug-control.cpp",
						"startLine": "453",
						"endLine": "461",
						"relevantVariables": [
							"cbDebugStepInto",
							"steprepeat",
							"StepIntoWow64",
							"cbStep"
						]
					},
					"inputDataExample": "{\"command\": \"StepInto\", \"args\": []}",
					"outputDataExample": "{\"status\": \"command_received\", \"handler\": \"cbDebugStepInto\"}"
				},
				{
					"simStepId": "3af10fbc-ffc7-4f05-884f-3139e5344825",
					"diagramNodeId": "7fd6fc6a-efbd-4dec-9f56-8c9031fdee60",
					"simStepLabel": "Invoking Core Stepping Logic",
					"simStepDescription": "The command handler `cbDebugStepInto` calls the core stepping function `StepIntoWow64`, passing `cbStep` as the callback to be executed upon completion. This transitions from command processing to the actual debug action.",
					"isEdge": 1,
					"sourceCodeMapping": {
						"filePath": "src/dbg/commands/cmd-debug-control.cpp",
						"startLine": "458",
						"endLine": "458",
						"relevantVariables": [
							"StepIntoWow64",
							"cbStep"
						]
					},
					"inputDataExample": "{\"callback_function\": \"cbStep\"}",
					"outputDataExample": "{\"callback_function\": \"cbStep\"}"
				},
				{
					"simStepId": "c5733e0b-1b42-48f0-a586-0b8613308f4e",
					"diagramNodeId": "9dc27ba2-b51e-44db-a85f-e8bd87ca6247",
					"simStepLabel": "Executing 'StepInto' via TitanEngine",
					"simStepDescription": "The `StepIntoWow64` wrapper function calls the `StepInto` function from the TitanEngine API. This function is responsible for setting the trap flag on the debugged thread's context to enable single-stepping and then resuming the thread.",
					"isEdge": 0,
					"sourceCodeMapping": {
						"filePath": "src/dbg/debugger.cpp",
						"startLine": "3118",
						"endLine": "3143",
						"relevantVariables": [
							"StepIntoWow64",
							"StepInto"
						]
					},
					"inputDataExample": "{\"callback\": \"cbStep\"}",
					"outputDataExample": "{\"status\": \"trap_flag_set\", \"thread_resumed\": true}"
				},
				{
					"simStepId": "f432e468-eeb7-4fc4-b550-cc7deb2ef98a",
					"diagramNodeId": "ccde1ddf-58d7-4979-a0c4-ea4852946bd1",
					"simStepLabel": "Single-Step Exception Event",
					"simStepDescription": "After the CPU executes one instruction, the trap flag triggers a single-step exception. The operating system catches this and reports it to the debugger as a debug event, which is received by the main debug loop.",
					"isEdge": 1,
					"sourceCodeMapping": {
						"filePath": "src/dbg/debugger.cpp",
						"startLine": "2980",
						"endLine": "2980",
						"relevantVariables": [
							"DebugLoop"
						]
					},
					"inputDataExample": "{\"debug_event\": {\"dwDebugEventCode\": \"EXCEPTION_DEBUG_EVENT\", \"dwProcessId\": 5432, \"dwThreadId\": 1234, \"u.Exception.ExceptionRecord.ExceptionCode\": \"EXCEPTION_SINGLE_STEP\", \"u.Exception.ExceptionRecord.ExceptionAddress\": \"0x00401050\"}}",
					"outputDataExample": "{\"debug_event\": {\"dwDebugEventCode\": \"EXCEPTION_DEBUG_EVENT\", \"dwProcessId\": 5432, \"dwThreadId\": 1234, \"u.Exception.ExceptionRecord.ExceptionCode\": \"EXCEPTION_SINGLE_STEP\", \"u.Exception.ExceptionRecord.ExceptionAddress\": \"0x00401050\"}}"
				},
				{
					"simStepId": "14b996b0-1ab2-4423-bde3-aa26a27815cb",
					"diagramNodeId": "6f61ea39-5f1d-460b-99f5-d0124e8439c2",
					"simStepLabel": "Debug Loop Processes Exception",
					"simStepDescription": "The main `debugLoopFunction` receives and processes the single-step exception. The TitanEngine core identifies this event and invokes the callback function (`cbStep`) that was originally provided to `StepInto`.",
					"isEdge": 0,
					"sourceCodeMapping": {
						"filePath": "src/dbg/debugger.cpp",
						"startLine": "2795",
						"endLine": "2984",
						"relevantVariables": [
							"debugLoopFunction",
							"DebugLoop"
						]
					},
					"inputDataExample": "{\"debug_event\": {\"u.Exception.ExceptionRecord.ExceptionCode\": \"EXCEPTION_SINGLE_STEP\"}}",
					"outputDataExample": "{\"handler_invoked\": \"cbStep\"}"
				},
				{
					"simStepId": "5f3406c5-e418-40ba-98ba-b11070389079",
					"diagramNodeId": "2a36d9d2-b4c6-49da-9ddc-8f8f9045a42c",
					"simStepLabel": "Invoking Post-Step Callback",
					"simStepDescription": "After processing the single-step exception, the debug engine invokes the `cbStep` callback function, signaling that the step operation is complete and the debugger can update its state.",
					"isEdge": 1,
					"sourceCodeMapping": {
						"filePath": "src/dbg/debugger.cpp",
						"startLine": "1394",
						"endLine": "1394",
						"relevantVariables": [
							"cbStep"
						]
					},
					"inputDataExample": "{\"event\": \"STEP_COMPLETE\", \"thread_id\": 1234, \"new_cip\": \"0x00401050\"}",
					"outputDataExample": "{\"event\": \"STEP_COMPLETE\", \"thread_id\": 1234, \"new_cip\": \"0x00401050\"}"
				},
				{
					"simStepId": "207cecc9-4b82-4bc7-ac79-d53dc5fc354d",
					"diagramNodeId": "06485482-89c2-461c-9e7f-d8c5adb60acc",
					"simStepLabel": "Step Completion and State Update",
					"simStepDescription": "The `cbStep` function executes. It retrieves the new instruction pointer (CIP), updates the GUI to reflect the new program state (registers, memory, disassembly), pauses the debuggee by locking the run event, and triggers plugin callbacks before waiting for the next command.",
					"isEdge": 0,
					"sourceCodeMapping": {
						"filePath": "src/dbg/debugger.cpp",
						"startLine": "1394",
						"endLine": "1422",
						"relevantVariables": [
							"cbStep",
							"GetContextDataEx",
							"DebugUpdateGuiSetStateAsync",
							"lock",
							"wait"
						]
					},
					"inputDataExample": "null",
					"outputDataExample": "{\"new_program_state\": {\"cip\": \"0x00401050\", \"eax\": \"0x00000001\"}, \"debugger_state\": \"paused\"}"
				},
				{
					"simStepId": "ae0261b6-1bfa-4bd3-86ae-13572d70632c",
					"diagramNodeId": "9282e764-94d6-41fd-9020-2036d94d7b89",
					"simStepLabel": "User Modifies Register Value",
					"simStepDescription": "When a user modifies a register in the GUI or via a command like 'mov eax, 1337', the `setregister` function is ultimately called. It parses the register name and prepares to call the underlying debug engine function.",
					"isEdge": 0,
					"sourceCodeMapping": {
						"filePath": "src/dbg/value.cpp",
						"startLine": "1152",
						"endLine": "1402",
						"relevantVariables": [
							"setregister",
							"scmp",
							"SetContextDataEx"
						]
					},
					"inputDataExample": "{\"registerName\": \"eax\", \"newValue\": 1337}",
					"outputDataExample": "{\"hActiveThread\": \"0x0000022C\", \"IndexOfRegister\": \"UE_EAX\", \"value\": 1337}"
				},
				{
					"simStepId": "9d62245d-0896-4dcc-b028-4de513eb800a",
					"diagramNodeId": "1b5ca007-3ed1-4be0-a28b-c369827f7ffc",
					"simStepLabel": "Requesting Thread Context Update",
					"simStepDescription": "The `setregister` function calls `SetContextDataEx` from the TitanEngine API to apply the new value to the debugged thread's context.",
					"isEdge": 1,
					"sourceCodeMapping": {
						"filePath": "src/dbg/value.cpp",
						"startLine": "1154",
						"endLine": "1154",
						"relevantVariables": [
							"SetContextDataEx",
							"hActiveThread",
							"UE_EAX"
						]
					},
					"inputDataExample": "{\"hActiveThread\": \"0x0000022C\", \"IndexOfRegister\": \"UE_EAX\", \"NewRegisterValue\": 1337}",
					"outputDataExample": "{\"hActiveThread\": \"0x0000022C\", \"IndexOfRegister\": \"UE_EAX\", \"NewRegisterValue\": 1337}"
				},
				{
					"simStepId": "c1f29436-7db5-40d2-8f93-ed52f2b0c5cd",
					"diagramNodeId": "369d59c4-ab3c-4466-8aa6-622b64bfad77",
					"simStepLabel": "TitanEngine Core Context Update",
					"simStepDescription": "The `SetContextDataEx` function in TitanEngine handles the low-level details. It uses the Windows API functions `GetThreadContext`, modifies the appropriate field in the `CONTEXT` structure, and then applies the changes with `SetThreadContext`.",
					"isEdge": 0,
					"sourceCodeMapping": {
						"filePath": "src/dbg/TitanEngine/TitanEngine.h",
						"startLine": "334",
						"endLine": "334",
						"relevantVariables": [
							"SetContextDataEx"
						]
					},
					"inputDataExample": "{\"hActiveThread\": \"0x0000022C\", \"IndexOfRegister\": \"UE_EAX\", \"NewRegisterValue\": 1337}",
					"outputDataExample": "{\"success\": true}"
				},
				{
					"simStepId": "532c5b19-7e72-4bf4-a112-2ea8fa8c776e",
					"diagramNodeId": "9527b51b-e148-45bc-8509-a671927b8880",
					"simStepLabel": "Confirmation and GUI Refresh Request",
					"simStepDescription": "After the context is successfully updated by the engine, control returns. A subsequent call is made to refresh the UI elements to reflect the change, such as `GuiUpdateAllViews`.",
					"isEdge": 1,
					"sourceCodeMapping": {
						"filePath": "src/dbg/commands/cmd-general-purpose.cpp",
						"startLine": "510",
						"endLine": "510",
						"relevantVariables": [
							"GuiUpdateAllViews"
						]
					},
					"inputDataExample": "{\"success\": true}",
					"outputDataExample": "{\"action\": \"REFRESH_UI\"}"
				},
				{
					"simStepId": "cebfbaeb-6977-41ec-8fac-426190038a2e",
					"diagramNodeId": "3f443e22-c9a9-48cd-8440-295b79b14f70",
					"simStepLabel": "GUI Displays Updated Value",
					"simStepDescription": "The GUI's register view receives the update signal. It then queries the new state using functions like `GetContextDataEx` and `DbgGetRegDump` and displays the updated value (1337 for EAX) to the user.",
					"isEdge": 0,
					"sourceCodeMapping": {
						"filePath": "src/gui/Src/Gui/CPURegistersView.cpp",
						"startLine": "322",
						"endLine": "332",
						"relevantVariables": [
							"update",
							"DbgGetRegDump"
						]
					},
					"inputDataExample": "{\"action\": \"REFRESH_UI\"}",
					"outputDataExample": "{\"displayed_registers\": {\"EAX\": \"00000539\", \"EBX\": \"...\"}}"
				}
			],
			"description": "<ul><li>This is the most fundamental feature of a debugger, providing the core value for dynamic analysis</li><li>- Users can launch or attach to a Windows executable (32-bit or 64-bit)</li><li>- Full control over program execution: running, pausing, and stepping through code instruction-by-instruction (step-in, step-over, step-out)</li><li>- Real-time inspection of the program's state, including CPU registers (general purpose, FPU, XMM), flags, and the call stack</li><li>- The central CPU view combines disassembly, registers, memory dump, and the stack, providing a comprehensive overview at any point in the execution</li></ul>",
			"simulationNodesAndEdges": {
				"549e11c4-72dd-46ca-8635-210aab0924c0": {
