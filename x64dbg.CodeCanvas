		"Advanced Breakpoint Management": {
			"name": "Advanced Breakpoint Management",
			"simSteps": [
				{
					"simStepId": "742542f7-e7a5-44f7-9293-8e3a368ef7fb",
					"diagramNodeId": "89392fe4-0a2a-4520-8b46-1ee66982f03b",
					"simStepLabel": "Software Breakpoint: Command Registration",
					"simStepDescription": "At application startup, the debugger registers the 'SetBPX' command (with aliases 'bp', 'bpx') and associates it with the `cbDebugSetBPX` callback function. This sets up the command handling for software breakpoints.",
					"isEdge": 0,
					"sourceCodeMapping": {
						"filePath": "src/dbg/x64dbg.cpp",
						"startLine": "167",
						"endLine": "167",
						"relevantVariables": [
							"dbgcmdnew",
							"cbDebugSetBPX"
						]
					},
					"inputDataExample": "{\n  \"commandName\": \"SetBPX,bp,bpx\",\n  \"callbackFunction\": \"cbDebugSetBPX\",\n  \"debugOnly\": true\n}",
					"outputDataExample": "{\n  \"registrationStatus\": \"success\"\n}"
				},
				{
					"simStepId": "79a6bbbd-586a-4993-b000-e6d1cadd166c",
					"diagramNodeId": "723116dd-be9e-405f-ae85-b9181a286e4c",
					"simStepLabel": "Software Breakpoint: User Command Execution",
					"simStepDescription": "The user enters a command to set a software breakpoint at a specific address, optionally giving it a name.",
					"isEdge": 1,
					"sourceCodeMapping": {
						"filePath": "src/gui/Src/Gui/CommandLineEdit.cpp",
						"startLine": "45",
						"endLine": "56",
						"relevantVariables": [
							"executeCommand",
							"DbgCmdExec"
						]
					},
					"inputDataExample": "{\n  \"command\": \"bp 0x401500, \\\"EntryPointBreakpoint\\\"\"\n}",
					"outputDataExample": "{\n  \"command\": \"bp 0x401500, \\\"EntryPointBreakpoint\\\"\"\n}"
				},
				{
					"simStepId": "ce1f9fb6-b89f-4148-ac2c-0aacc7137000",
					"diagramNodeId": "29b6611a-5a8a-4bd2-9e49-0557ce72499a",
					"simStepLabel": "Software Breakpoint: Command Handling",
					"simStepDescription": "The registered callback `cbDebugSetBPX` is executed. It parses the command arguments (address and name), reads the original bytes at the target address, creates an internal data structure for the breakpoint, and then calls the debugging engine to place the physical breakpoint.",
					"isEdge": 0,
					"sourceCodeMapping": {
						"filePath": "src/dbg/commands/cmd-breakpoint-control.cpp",
						"startLine": "105",
						"endLine": "151",
						"relevantVariables": [
							"cbDebugSetBPX",
							"valfromstring",
							"MemRead",
							"BpNew",
							"SetBPX"
						]
					},
					"inputDataExample": "{\n  \"argc\": 4,\n  \"argv\": [\n    \"bp\",\n    \"0x401500\",\n    \",\",\n    \"\\\"EntryPointBreakpoint\\\"\"\n  ]\n}",
					"outputDataExample": "{\n  \"status\": \"Breakpoint at 0000000000401500 (EntryPointBreakpoint) set!\"\n}"
				},
				{
					"simStepId": "68451248-06b8-43a9-9268-4a2ced301665",
					"diagramNodeId": "14085f80-6df1-4bca-b4eb-2958072ba5b3",
					"simStepLabel": "Software Breakpoint: Internal Record Creation",
					"simStepDescription": "The command handler calls `BpNew` to create and store the breakpoint's metadata internally within the debugger.",
					"isEdge": 1,
					"sourceCodeMapping": {
						"filePath": "src/dbg/commands/cmd-breakpoint-control.cpp",
						"startLine": "138",
						"endLine": "138",
						"relevantVariables": [
							"BpNew"
						]
					},
					"inputDataExample": "{\n  \"Address\": \"0x401500\",\n  \"Enable\": true,\n  \"Singleshot\": false,\n  \"OldBytes\": 22617,\n  \"Type\": \"BPNORMAL\",\n  \"TitanType\": 1,\n  \"Name\": \"EntryPointBreakpoint\"\n}",
					"outputDataExample": "{\n  \"Address\": \"0x401500\",\n  \"Enable\": true,\n  \"Singleshot\": false,\n  \"OldBytes\": 22617,\n  \"Type\": \"BPNORMAL\",\n  \"TitanType\": 1,\n  \"Name\": \"EntryPointBreakpoint\"\n}"
				},
				{
					"simStepId": "10099a29-5677-496c-bb58-f5164e0cb444",
					"diagramNodeId": "0afaab41-5a89-442a-8eaa-2a9d34927c03",
					"simStepLabel": "Software Breakpoint: Store Metadata",
					"simStepDescription": "The `BpNew` function creates a `BREAKPOINT` structure, populates it with details like address, type, and name, and adds it to a global map that tracks all active breakpoints.",
					"isEdge": 0,
					"sourceCodeMapping": {
						"filePath": "src/dbg/breakpoint.cpp",
						"startLine": "105",
						"endLine": "170",
						"relevantVariables": [
							"BpNew",
							"breakpoints",
							"BREAKPOINT"
						]
					},
					"inputDataExample": "{\n  \"Address\": \"0x401500\",\n  \"Type\": \"BPNORMAL\",\n  \"Name\": \"EntryPointBreakpoint\"\n}",
					"outputDataExample": "{\n  \"breakpoint_object\": {\n    \"addr\": \"0x401500\",\n    \"enabled\": true,\n    \"type\": \"BPNORMAL\",\n    \"name\": \"EntryPointBreakpoint\",\n    \"module\": \"my_app.exe\"\n  }\n}"
				},
				{
					"simStepId": "126317ac-ac8f-4b63-8679-daf7e4e4b70d",
					"diagramNodeId": "d654d9ca-7685-443a-a910-717ad8ba0d90",
					"simStepLabel": "Software Breakpoint: Set Physical Breakpoint",
					"simStepDescription": "After the internal record is created, the handler calls the `SetBPX` function from the underlying TitanEngine to physically modify the debuggee's memory.",
					"isEdge": 1,
					"sourceCodeMapping": {
						"filePath": "src/dbg/commands/cmd-breakpoint-control.cpp",
						"startLine": "140",
						"endLine": "145",
						"relevantVariables": [
							"SetBPX",
							"cbUserBreakpoint"
						]
					},
					"inputDataExample": "{\n  \"addr\": \"0x401500\",\n  \"type\": 1,\n  \"callback\": \"cbUserBreakpoint\"\n}",
					"outputDataExample": "{\n  \"addr\": \"0x401500\",\n  \"type\": 1,\n  \"callback\": \"cbUserBreakpoint\"\n}"
				},
				{
					"simStepId": "ffceb9d9-ad5f-4a9f-98e9-7e12a8bc3e8f",
					"diagramNodeId": "ac0c0dcc-d2af-4942-a673-fa7ccf6f2d15",
					"simStepLabel": "Software Breakpoint: Write INT3 Instruction",
					"simStepDescription": "The `SetBPX` function writes a `0xCC` (INT3) byte at the specified address in the debugged process's memory. When the CPU executes this instruction, it triggers an exception that pauses the process and transfers control to the debugger.",
					"isEdge": 0,
					"sourceCodeMapping": {
						"filePath": "src/dbg/commands/cmd-breakpoint-control.cpp",
						"startLine": "140",
						"endLine": "145",
						"relevantVariables": [
							"SetBPX"
						]
					},
					"inputDataExample": "{\n  \"address\": \"0x401500\",\n  \"instruction\": \"0xCC\"\n}",
					"outputDataExample": "{\n  \"success\": true\n}"
				},
				{
					"simStepId": "31f8ea4a-16db-451a-9b3d-e1edbc7c9742",
					"diagramNodeId": "a310f61a-57f7-43b5-9db5-74e2c5d02de6",
					"simStepLabel": "Software Breakpoint: GUI Update Notification",
					"simStepDescription": "To reflect the change, `GuiUpdateAllViews` is called, signaling all UI components to refresh their state.",
					"isEdge": 1,
					"sourceCodeMapping": {
						"filePath": "src/dbg/commands/cmd-breakpoint-control.cpp",
						"startLine": "146",
						"endLine": "146",
						"relevantVariables": [
							"GuiUpdateAllViews"
						]
					},
					"inputDataExample": "{}",
					"outputDataExample": "{}"
				},
				{
					"simStepId": "843d21ed-6be5-42ca-a450-8b900e814454",
					"diagramNodeId": "53cb0c62-1d24-4db6-b3d6-b2b195fc49f2",
					"simStepLabel": "Software Breakpoint: Refresh UI",
					"simStepDescription": "The `BreakpointsView` widget handles the update signal by fetching the latest list of breakpoints and repainting its view, making the new breakpoint visible to the user.",
					"isEdge": 0,
					"sourceCodeMapping": {
						"filePath": "src/gui/Src/Gui/BreakpointsView.cpp",
						"startLine": "212",
						"endLine": "265",
						"relevantVariables": [
							"updateBreakpointsSlot",
							"mBps"
						]
					},
					"inputDataExample": "{}",
					"outputDataExample": "{\n  \"view_updated\": \"BreakpointsView\"\n}"
				},
				{
					"simStepId": "47f9d19d-b518-4577-8ece-462aad663bd3",
					"diagramNodeId": "279c1d9c-df35-4e4c-bf7a-c3d685b15b3b",
					"simStepLabel": "Hardware Breakpoint: Command Registration",
					"simStepDescription": "The debugger registers the `SetHardwareBreakpoint` command (aliases `bph`, `bphws`) and links it to the `cbDebugSetHardwareBreakpoint` callback function during initialization.",
					"isEdge": 0,
					"sourceCodeMapping": {
						"filePath": "src/dbg/x64dbg.cpp",
						"startLine": "171",
						"endLine": "171",
						"relevantVariables": [
							"dbgcmdnew",
							"cbDebugSetHardwareBreakpoint"
						]
					},
					"inputDataExample": "{\n  \"commandName\": \"SetHardwareBreakpoint,bph,bphws\",\n  \"callbackFunction\": \"cbDebugSetHardwareBreakpoint\",\n  \"debugOnly\": true\n}",
					"outputDataExample": "{\n  \"registrationStatus\": \"success\"\n}"
				},
				{
					"simStepId": "fc667676-58f1-4a5e-9698-23209c2e01ff",
					"diagramNodeId": "8490b72d-241a-4949-902c-332a7822bf89",
					"simStepLabel": "Hardware Breakpoint: User Command Execution",
					"simStepDescription": "A user issues a command to set a hardware breakpoint on memory access at a specific address.",
					"isEdge": 1,
					"sourceCodeMapping": {
						"filePath": "src/gui/Src/Gui/CommandLineEdit.cpp",
						"startLine": "45",
						"endLine": "56",
						"relevantVariables": [
							"executeCommand"
						]
					},
					"inputDataExample": "{\n  \"command\": \"bphws 0x402000, r, 1\"\n}",
					"outputDataExample": "{\n  \"command\": \"bphws 0x402000, r, 1\"\n}"
				},
				{
					"simStepId": "49be00f0-66e1-4410-8a77-ff27ef60fd26",
					"diagramNodeId": "4cd1c5fd-efdf-476e-8472-ffd17cb8607a",
					"simStepLabel": "Hardware Breakpoint: Command Handling",
					"simStepDescription": "The `cbDebugSetHardwareBreakpoint` function is executed. It parses the address, access type, and size. It then finds an available hardware debug register (DR0-DR3), creates an internal breakpoint record, and calls the engine to configure the debug registers on the active thread.",
					"isEdge": 0,
					"sourceCodeMapping": {
						"filePath": "src/dbg/commands/cmd-breakpoint-control.cpp",
						"startLine": "400",
						"endLine": "489",
						"relevantVariables": [
							"cbDebugSetHardwareBreakpoint",
							"GetUnusedHardwareBreakPointRegister",
							"BpNew",
							"SetHardwareBreakPoint"
						]
					},
					"inputDataExample": "{\n  \"argc\": 4,\n  \"argv\": [\n    \"bphws\",\n    \"0x402000\",\n    \"r\",\n    \"1\"\n  ]\n}",
					"outputDataExample": "{\n  \"status\": \"Hardware breakpoint at 0000000000402000 set!\"\n}"
				},
				{
					"simStepId": "fff470b7-e706-41a3-9b3f-e98f1a40ad33",
					"diagramNodeId": "f964a636-10b2-4b0d-8833-0c147d80d189",
					"simStepLabel": "Hardware Breakpoint: Set Physical Breakpoint",
					"simStepDescription": "The handler calls `SetHardwareBreakPoint` to configure the CPU's debug registers for the target thread.",
					"isEdge": 1,
					"sourceCodeMapping": {
						"filePath": "src/dbg/commands/cmd-breakpoint-control.cpp",
						"startLine": "485",
						"endLine": "485",
						"relevantVariables": [
							"SetHardwareBreakPoint",
							"cbHardwareBreakpoint"
						]
					},
					"inputDataExample": "{\n  \"addr\": \"0x402000\",\n  \"drx\": 0,\n  \"type\": \"UE_HARDWARE_READWRITE\",\n  \"size\": \"UE_HARDWARE_SIZE_1\",\n  \"callback\": \"cbHardwareBreakpoint\"\n}",
					"outputDataExample": "{\n  \"addr\": \"0x402000\",\n  \"drx\": 0,\n  \"type\": \"UE_HARDWARE_READWRITE\",\n  \"size\": \"UE_HARDWARE_SIZE_1\",\n  \"callback\": \"cbHardwareBreakpoint\"\n}"
				},
				{
					"simStepId": "8c484b18-ebdc-4a1f-b058-e5af183edf97",
					"diagramNodeId": "e714eb1f-927b-4264-82ea-1b73cd210a20",
					"simStepLabel": "Hardware Breakpoint: Configure Debug Registers",
					"simStepDescription": "The `SetHardwareBreakPoint` function modifies the debug registers (DR0-DR7) of the debuggee's thread context. DR0-DR3 store the breakpoint addresses, and DR7 controls the type (read, write, execute), size, and status of these breakpoints. This is a stealthier method as it doesn't modify the code itself.",
					"isEdge": 0,
					"sourceCodeMapping": {
						"filePath": "src/dbg/commands/cmd-breakpoint-control.cpp",
						"startLine": "485",
						"endLine": "489",
						"relevantVariables": [
							"SetHardwareBreakPoint"
						]
					},
					"inputDataExample": "{\n  \"DR0\": \"0x402000\",\n  \"DR7\": \"... (control flags for enabling DR0 on read access)\"\n}",
					"outputDataExample": "{\n  \"success\": true\n}"
				},
				{
					"simStepId": "698db62f-e58d-4a0f-9270-697872acf540",
					"diagramNodeId": "c0376050-15f6-48e0-b32f-55cde230014f",
					"simStepLabel": "Hardware Breakpoint: GUI Update Notification",
					"simStepDescription": "The command handler signals the UI to update its views to reflect the newly added hardware breakpoint.",
					"isEdge": 1,
					"sourceCodeMapping": {
						"filePath": "src/dbg/commands/cmd-breakpoint-control.cpp",
						"startLine": "487",
						"endLine": "487",
						"relevantVariables": [
							"GuiUpdateAllViews"
						]
					},
					"inputDataExample": "{}",
					"outputDataExample": "{}"
				},
				{
					"simStepId": "7c7df7cb-dc59-4fb0-add7-2ce385120253",
					"diagramNodeId": "e5eca1e5-90ab-42b0-9151-87a559182102",
					"simStepLabel": "Hardware Breakpoint: Refresh UI",
					"simStepDescription": "The `BreakpointsView` is updated to display the new hardware breakpoint, including its address, type, and status.",
					"isEdge": 0,
					"sourceCodeMapping": {
						"filePath": "src/gui/Src/Gui/BreakpointsView.cpp",
						"startLine": "212",
						"endLine": "265",
						"relevantVariables": [
							"updateBreakpointsSlot"
						]
					},
					"inputDataExample": "{}",
					"outputDataExample": "{\n  \"view_updated\": \"BreakpointsView\"\n}"
				},
				{
					"simStepId": "d592c91c-8f0d-4210-99c3-d5705be0db2c",
					"diagramNodeId": "d25cad8c-fae6-49f9-9c76-8950905bc4c8",
					"simStepLabel": "Memory Breakpoint: Command Registration",
					"simStepDescription": "The debugger registers the `SetMemoryBPX` command (aliases `membp`, `bpm`) and maps it to the `cbDebugSetMemoryBpx` callback for handling memory breakpoint requests.",
					"isEdge": 0,
					"sourceCodeMapping": {
						"filePath": "src/dbg/x64dbg.cpp",
						"startLine": "175",
						"endLine": "175",
						"relevantVariables": [
							"dbgcmdnew",
							"cbDebugSetMemoryBpx"
						]
					},
					"inputDataExample": "{\n  \"commandName\": \"SetMemoryBPX,membp,bpm\",\n  \"callbackFunction\": \"cbDebugSetMemoryBpx\",\n  \"debugOnly\": true\n}",
					"outputDataExample": "{\n  \"registrationStatus\": \"success\"\n}"
				},
				{
					"simStepId": "8610178a-8ff5-4420-8f40-48384f667485",
					"diagramNodeId": "1b6c9de0-4a09-4fde-9a56-87f54c2373e8",
					"simStepLabel": "Memory Breakpoint: User Command Execution",
					"simStepDescription": "A user issues a command to set a memory breakpoint on a specific memory page.",
					"isEdge": 1,
					"sourceCodeMapping": {
						"filePath": "src/gui/Src/Gui/CommandLineEdit.cpp",
						"startLine": "45",
						"endLine": "56",
						"relevantVariables": [
							"executeCommand"
						]
					},
					"inputDataExample": "{\n  \"command\": \"membp 0x19FF00\"\n}",
					"outputDataExample": "{\n  \"command\": \"membp 0x19FF00\"\n}"
				},
				{
					"simStepId": "315773ce-f795-4397-a2d2-b7bccc97116c",
					"diagramNodeId": "47d8fec6-fede-487f-b606-e6ea172da821",
					"simStepLabel": "Memory Breakpoint: Command Handling",
					"simStepDescription": "The `cbDebugSetMemoryBpx` function handles the command. It determines the base address and size of the memory page containing the specified address. It then creates an internal record for the breakpoint and calls the engine to apply a page guard.",
					"isEdge": 0,
					"sourceCodeMapping": {
						"filePath": "src/dbg/commands/cmd-breakpoint-control.cpp",
						"startLine": "700",
						"endLine": "757",
						"relevantVariables": [
							"cbDebugSetMemoryBpx",
							"MemFindBaseAddr",
							"BpNew",
							"SetMemoryBPXEx"
						]
					},
					"inputDataExample": "{\n  \"argc\": 2,\n  \"argv\": [\n    \"membp\",\n    \"0x19FF00\"\n  ]\n}",
					"outputDataExample": "{\n  \"status\": \"Memory breakpoint at 0000000000190000[1000] set!\"\n}"
				},
				{
					"simStepId": "51a30dfa-1038-4757-8da5-7bddf210d1e9",
					"diagramNodeId": "f0086040-342a-403a-b7aa-a26732e7cc89",
					"simStepLabel": "Memory Breakpoint: Set Page Guard",
					"simStepDescription": "The handler calls `SetMemoryBPXEx` to modify the protection flags of the target memory page.",
					"isEdge": 1,
					"sourceCodeMapping": {
						"filePath": "src/dbg/commands/cmd-breakpoint-control.cpp",
						"startLine": "753",
						"endLine": "753",
						"relevantVariables": [
							"SetMemoryBPXEx",
							"cbMemoryBreakpoint"
						]
					},
					"inputDataExample": "{\n  \"base\": \"0x19F000\",\n  \"size\": 4096,\n  \"type\": \"UE_MEMORY_ACCESS\",\n  \"restore\": true,\n  \"callback\": \"cbMemoryBreakpoint\"\n}",
					"outputDataExample": "{\n  \"base\": \"0x19F000\",\n  \"size\": 4096,\n  \"type\": \"UE_MEMORY_ACCESS\",\n  \"restore\": true,\n  \"callback\": \"cbMemoryBreakpoint\"\n}"
				},
				{
					"simStepId": "7d626bab-56a5-4a7c-b269-cc260bf45f51",
					"diagramNodeId": "ec6378da-2ccc-481a-9fdb-0eeb78a27d33",
					"simStepLabel": "Memory Breakpoint: Apply PAGE_GUARD Protection",
					"simStepDescription": "The `SetMemoryBPXEx` function uses `VirtualProtectEx` to add the `PAGE_GUARD` protection flag to the specified memory page. When the debuggee attempts to access this page, a `STATUS_GUARD_PAGE_VIOLATION` exception is raised, which the debugger catches. This allows breaking on read, write, or execution access to an entire memory page.",
					"isEdge": 0,
					"sourceCodeMapping": {
						"filePath": "src/dbg/commands/cmd-breakpoint-control.cpp",
						"startLine": "753",
						"endLine": "757",
						"relevantVariables": [
							"SetMemoryBPXEx"
						]
					},
					"inputDataExample": "{\n  \"address\": \"0x19F000\",\n  \"size\": 4096,\n  \"newProtect\": \"PAGE_EXECUTE_READWRITE | PAGE_GUARD\"\n}",
					"outputDataExample": "{\n  \"success\": true\n}"
				},
				{
					"simStepId": "4a28c522-2e6b-4a4d-a0cc-12347375c391",
					"diagramNodeId": "a737b307-a70f-4689-997a-a955719271b3",
					"simStepLabel": "Memory Breakpoint: GUI Update Notification",
					"simStepDescription": "The command handler signals the UI to update its views to reflect the new memory breakpoint.",
					"isEdge": 1,
					"sourceCodeMapping": {
						"filePath": "src/dbg/commands/cmd-breakpoint-control.cpp",
						"startLine": "756",
						"endLine": "756",
						"relevantVariables": [
							"GuiUpdateAllViews"
						]
					},
					"inputDataExample": "{}",
					"outputDataExample": "{}"
				},
				{
					"simStepId": "42c6efb2-7414-4b0e-b6fd-726fbd123072",
					"diagramNodeId": "4497637c-43b7-480e-8553-487e425a4c2c",
					"simStepLabel": "Memory Breakpoint: Refresh UI",
					"simStepDescription": "The `BreakpointsView` updates to display the new memory breakpoint, showing the base address and size of the guarded page.",
					"isEdge": 0,
					"sourceCodeMapping": {
						"filePath": "src/gui/Src/Gui/BreakpointsView.cpp",
						"startLine": "212",
						"endLine": "265",
						"relevantVariables": [
							"updateBreakpointsSlot"
						]
					},
					"inputDataExample": "{}",
					"outputDataExample": "{\n  \"view_updated\": \"BreakpointsView\"\n}"
				},
				{
					"simStepId": "d25578f4-b055-4a75-bfdd-94548915b730",
					"diagramNodeId": "809aa873-6a2c-40b5-8d18-7f795856845a",
					"simStepLabel": "Conditional Breakpoint: Command Registration",
					"simStepDescription": "The `SetBreakpointCondition` command (aliases `bpcond`, `bpcnd`) is registered with the `cbDebugSetBPXCondition` callback to handle setting conditions on breakpoints.",
					"isEdge": 0,
					"sourceCodeMapping": {
						"filePath": "src/dbg/x64dbg.cpp",
						"startLine": "189",
						"endLine": "189",
						"relevantVariables": [
							"dbgcmdnew",
							"cbDebugSetBPXCondition"
						]
					},
					"inputDataExample": "{\n  \"commandName\": \"SetBreakpointCondition,bpcond,bpcnd\",\n  \"callbackFunction\": \"cbDebugSetBPXCondition\",\n  \"debugOnly\": true\n}",
					"outputDataExample": "{\n  \"registrationStatus\": \"success\"\n}"
				},
				{
					"simStepId": "69a7a4e9-ac63-445d-9103-fa068d4d6b9b",
					"diagramNodeId": "00b36c9b-6518-42c6-a7dc-4cfa3779f589",
					"simStepLabel": "Conditional Breakpoint: User Command Execution",
					"simStepDescription": "The user sets a break condition on an existing software breakpoint.",
					"isEdge": 1,
					"sourceCodeMapping": {
						"filePath": "src/gui/Src/Gui/CommandLineEdit.cpp",
						"startLine": "45",
						"endLine": "56",
						"relevantVariables": [
							"executeCommand"
						]
					},
					"inputDataExample": "{\n  \"command\": \"bpcond 0x401500, \\\"eax==1\\\"\"\n}",
					"outputDataExample": "{\n  \"command\": \"bpcond 0x401500, \\\"eax==1\\\"\"\n}"
				},
				{
					"simStepId": "b61427da-26e4-4ec0-8207-91aa03f81063",
					"diagramNodeId": "f517fe90-cfea-4dbc-b252-ab89f2a22121",
					"simStepLabel": "Conditional Breakpoint: Command Handling",
					"simStepDescription": "The `cbDebugSetBPXCondition` function, via its common implementation, parses the breakpoint identifier and the condition string. It then calls `BpSetBreakCondition` to update the internal breakpoint record.",
					"isEdge": 0,
					"sourceCodeMapping": {
						"filePath": "src/dbg/commands/cmd-conditional-breakpoint-control.cpp",
						"startLine": "9",
						"endLine": "32",
						"relevantVariables": [
							"cbDebugSetBPXTextCommon",
							"BpGetAny",
							"setFunction"
						]
					},
					"inputDataExample": "{\n  \"argc\": 3,\n  \"argv\": [\n    \"bpcond\",\n    \"0x401500\",\n    \"eax==1\"\n  ]\n}",
					"outputDataExample": "{\n  \"success\": true\n}"
				},
				{
					"simStepId": "81210b9c-14fe-44c5-8cf8-c686a30d563e",
					"diagramNodeId": "efc208f8-6d70-4024-ba6c-df34fe9c1346",
					"simStepLabel": "Conditional Breakpoint: Update Internal Record",
					"simStepDescription": "The handler calls `BpSetBreakCondition` to find the specified breakpoint in the internal map and update its `breakCondition` property.",
					"isEdge": 1,
					"sourceCodeMapping": {
						"filePath": "src/dbg/commands/cmd-conditional-breakpoint-control.cpp",
						"startLine": "35",
						"endLine": "38",
						"relevantVariables": [
							"cbDebugSetBPXConditionCommon",
							"BpSetBreakCondition"
						]
					},
					"inputDataExample": "{\n  \"Address\": \"0x401500\",\n  \"Type\": \"BPNORMAL\",\n  \"Condition\": \"eax==1\"\n}",
					"outputDataExample": "{\n  \"Address\": \"0x401500\",\n  \"Type\": \"BPNORMAL\",\n  \"Condition\": \"eax==1\"\n}"
				},
				{
					"simStepId": "4a7afaaa-41ec-4055-b509-057bccc27d00",
					"diagramNodeId": "1a57abc8-beec-42d0-9bd3-60bca9fb8851",
					"simStepLabel": "Conditional Breakpoint: Store Condition",
					"simStepDescription": "The `BpSetBreakCondition` function locates the corresponding `BREAKPOINT` structure and updates its `breakCondition` string field. This condition will be evaluated each time the breakpoint is hit.",
					"isEdge": 0,
					"sourceCodeMapping": {
						"filePath": "src/dbg/breakpoint.cpp",
						"startLine": "421",
						"endLine": "432",
						"relevantVariables": [
							"BpSetBreakCondition",
							"bpInfo->breakCondition"
						]
					},
					"inputDataExample": "{\n  \"Address\": \"0x401500\",\n  \"Condition\": \"eax==1\"\n}",
					"outputDataExample": "{\n  \"breakpoint_object\": {\n    \"addr\": \"0x401500\",\n    \"breakCondition\": \"eax==1\"\n  }\n}"
				},
				{
					"simStepId": "8785bf05-d15f-4bfa-85f7-3a4b5ef33a97",
					"diagramNodeId": "25bf0ea6-3e5b-4def-9709-a0c69110908c",
					"simStepLabel": "Conditional Breakpoint: GUI Update Notification",
					"simStepDescription": "An asynchronous signal is sent to update the breakpoints view after the condition has been set.",
					"isEdge": 1,
					"sourceCodeMapping": {
						"filePath": "src/dbg/commands/cmd-conditional-breakpoint-control.cpp",
						"startLine": "30",
						"endLine": "30",
						"relevantVariables": [
							"DebugUpdateBreakpointsViewAsync"
						]
					},
					"inputDataExample": "{}",
					"outputDataExample": "{}"
				},
				{
					"simStepId": "cbeae747-837e-4315-a6b8-89c1d4c513ff",
					"diagramNodeId": "78d4646a-d204-4d27-ad40-fdf27c05c4c2",
					"simStepLabel": "Conditional Breakpoint: Refresh UI",
					"simStepDescription": "The `BreakpointsView` updates and displays the condition in the 'Summary' column for the corresponding breakpoint, making the conditional nature of the breakpoint visible to the user.",
					"isEdge": 0,
					"sourceCodeMapping": {
						"filePath": "src/gui/Src/Gui/BreakpointsView.cpp",
						"startLine": "212",
						"endLine": "265",
						"relevantVariables": [
							"updateBreakpointsSlot",
							"bp.breakCondition"
						]
					},
					"inputDataExample": "{}",
					"outputDataExample": "{\n  \"view_updated\": \"BreakpointsView\",\n  \"summary_column_text\": \"Break on eax==1\"\n}"
				}
			],
			"description": "<ul><li>Breakpoints are the primary mechanism for pausing execution at points of interest, crucial for targeted analysis</li><li>- Set standard software breakpoints (INT3) on any code address</li><li>- Set hardware breakpoints on memory access (read, write) or execution, which are stealthier than software breakpoints</li><li>- Set memory breakpoints to break when a specific memory range is accessed</li><li>- Create conditional breakpoints that only trigger when a specific expression is true, allowing for highly specific analysis</li><li>- Attach commands or logging actions to breakpoints for automation and data collection</li></ul>",
