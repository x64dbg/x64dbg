		"src/gui/Src/Gui/MemoryMapView.cpp-simstep-087b8105-db4a-4b92-889f-e04988846347": {
			"path": "src/gui/Src/Gui/MemoryMapView.cpp-simstep-087b8105-db4a-4b92-889f-e04988846347",
			"fileName": "MemoryMapView.cpp",
			"wiki": "The `doubleClickedSlot` function handles the user's action by constructing and executing a `dump` command, which instructs the debugger to open the selected address in a hex dump view.",
