		"src/bridge/bridgemain.cpp-simstep-d969b9d2-bd55-4a93-ad59-d02f0eea09cf": {
			"path": "src/bridge/bridgemain.cpp-simstep-d969b9d2-bd55-4a93-ad59-d02f0eea09cf",
			"fileName": "bridgemain.cpp",
			"wiki": "The DbgSetLabelAt bridge function receives the label information. It communicates with the debugger core, which then stores the label in its user database, associating it with the specified address.",
			"cellName": "Code Annotation: Bridge Sets Label in Database - bridgemain.cpp:L609-613",
