		"8158e3f0-1cd4-4af4-a4a8-806d36f7af07": {
			"path": "8158e3f0-1cd4-4af4-a4a8-806d36f7af07",
			"cellName": "Memory Map Flow: Write Memory to Target Process - bridgemain.cpp:L532-543",
			"cellId": "8158e3f0-1cd4-4af4-a4a8-806d36f7af07",
			"visible": true,
			"parentCellId": "c68504b2-9bf3-445f-9bb1-6f5a0254ebff"
		},
		"src/bridge/bridgemain.cpp-simstep-4542eaed-33a0-4b35-b5d2-31d945e6eb3a": {
			"path": "src/bridge/bridgemain.cpp-simstep-4542eaed-33a0-4b35-b5d2-31d945e6eb3a",
			"fileName": "bridgemain.cpp",
			"wiki": "The `mMemPage->write` call propagates to the `DbgMemWrite` bridge function. This function interfaces with the debugger core to write the new byte sequence into the target process's memory space.",
			"cellName": "Memory Map Flow: Write Memory to Target Process - bridgemain.cpp:L532-543",
