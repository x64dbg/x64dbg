			"parentCellId": "ed21533f-5732-4f5d-8721-37e04a6a471f"
		},
		"src/gui/Src/Gui/MainWindow.cpp-simstep-d51b3c69-dbb7-4b1b-af24-959adccefbaa": {
			"path": "src/gui/Src/Gui/MainWindow.cpp-simstep-d51b3c69-dbb7-4b1b-af24-959adccefbaa",
			"fileName": "MainWindow.cpp",
			"wiki": "A user interaction within the GUI, such as clicking a menu item or a button, triggers a function call that prepares to execute a command. In this example, selecting 'Run' from the debug menu calls the `runSlot` function.",
			"cellName": "GUI: User Action Initiates Command - MainWindow.cpp:L1353-1358",
			"cellId": "b1d82962-10f0-45b8-96b6-d830462ccf27",
