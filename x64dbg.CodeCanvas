		"Code Analysis and Visualization": {
			"name": "Code Analysis and Visualization",
			"simSteps": [
				{
					"simStepId": "9e778864-e196-4e2b-abb2-e4f68c1b2419",
					"diagramNodeId": "2d46360c-26ec-40f9-91f5-1c9107f0514f",
					"simStepLabel": "Code Visualization: User Requests Control Flow Graph",
					"simStepDescription": "The user initiates the code visualization process by requesting a control flow graph for a specific address. This is often done by using the 'graph' command or a menu option, which triggers the graphAtSlot in the DisassemblerGraphView.",
					"isEdge": 0,
					"sourceCodeMapping": {
						"filePath": "src/gui/Src/Gui/DisassemblerGraphView.cpp",
						"startLine": "2164",
						"endLine": "2167",
						"relevantVariables": [
							"addr",
							"DisassemblerGraphView::graphAtSlot",
							"this->navigate"
						]
					},
					"inputDataExample": "{\"addr\": \"0x00401050\"}",
					"outputDataExample": "{\"status\": \"Navigation to 0x00401050 initiated, preparing to render graph.\"}"
				},
				{
					"simStepId": "eb93b562-ec74-4aa5-b3cd-d2c497762425",
					"diagramNodeId": "11f1c610-0077-4e8d-b41d-170a892b7d05",
					"simStepLabel": "Code Visualization: GUI Requests Instruction Disassembly",
					"simStepDescription": "To render the graph, the GUI needs the disassembled text for each instruction. It calls the DbgDisasmAt function for various addresses within the function's code blocks to retrieve this information from the debugger core.",
					"isEdge": 1,
					"sourceCodeMapping": {
						"filePath": "src/gui/Src/Gui/DisassemblerGraphView.cpp",
						"startLine": "2269",
						"endLine": "2271",
						"relevantVariables": [
							"currentInstruction",
							"instr",
							"DbgDisasmAt"
						]
					},
					"inputDataExample": "{\"addr\": \"0x00401055\", \"instr\": {}}",
					"outputDataExample": "{\"addr\": \"0x00401055\", \"instr\": {}}"
				},
				{
					"simStepId": "70ce2c08-d15d-4d7b-9427-3fbdf57fdf65",
					"diagramNodeId": "b842b705-bbb1-4ac9-89af-e3ba5f7852b6",
					"simStepLabel": "Code Visualization: Bridge Handles Disassembly Request",
					"simStepDescription": "The DbgDisasmAt function in the bridge layer receives the request from the GUI. It acts as an intermediary, sending a message (DBG_DISASM_AT) to the main debugger engine to perform the actual disassembly.",
					"isEdge": 0,
					"sourceCodeMapping": {
						"filePath": "src/bridge/bridgemain.cpp",
						"startLine": "1149",
						"endLine": "1152",
						"relevantVariables": [
							"addr",
							"instr",
							"_dbg_sendmessage",
							"DBG_DISASM_AT"
						]
					},
					"inputDataExample": "{\"addr\": \"0x00401055\", \"instr\": {}}",
					"outputDataExample": "{\"addr\": \"0x00401055\", \"instr\": {\"type\": \"instr_call\", \"mnemonic\": \"call\", \"op_str\": \"0x004010A0\", \"argcount\": 1}}"
				},
				{
					"simStepId": "a6459dcb-5c28-401c-8e15-ff6ac8568d2b",
					"diagramNodeId": "ce828f6e-eb2c-47fa-98a0-b2df8bcde2be",
					"simStepLabel": "Code Visualization: Disassembly Data Returned to GUI",
					"simStepDescription": "The bridge layer returns the populated DISASM_INSTR structure, containing details like the mnemonic and operands, back to the DisassemblerGraphView.",
					"isEdge": 1,
					"sourceCodeMapping": {
						"filePath": "src/bridge/bridgemain.h",
						"startLine": "1173",
						"endLine": "1173",
						"relevantVariables": [
							"DbgDisasmAt"
						]
					},
					"inputDataExample": "{\"addr\": \"0x00401055\", \"instr\": {\"type\": \"instr_call\", \"mnemonic\": \"call\", \"op_str\": \"0x004010A0\", \"argcount\": 1}}",
					"outputDataExample": "{\"addr\": \"0x00401055\", \"instr\": {\"type\": \"instr_call\", \"mnemonic\": \"call\", \"op_str\": \"0x004010A0\", \"argcount\": 1}}"
				},
				{
					"simStepId": "983b4687-dac1-4fab-80a9-36e7f89874df",
					"diagramNodeId": "031ac155-af3f-4494-99b3-13bb6aebc694",
					"simStepLabel": "Code Visualization: GUI Renders the Control Flow Graph",
					"simStepDescription": "The DisassemblerGraphView uses the disassembly data to construct the visual representation of the function. The renderFunction computes the layout of basic blocks and edges, and the paintEvent handles the final drawing on the screen.",
					"isEdge": 0,
					"sourceCodeMapping": {
						"filePath": "src/gui/Src/Gui/DisassemblerGraphView.cpp",
						"startLine": "1545",
						"endLine": "1549",
						"relevantVariables": [
							"func",
							"DisassemblerGraphView::renderFunction"
						]
					},
					"inputDataExample": "{\"function\": {\"entry\": \"0x00401000\", \"blocks\": [{\"start\": \"0x00401000\", \"end\": \"0x00401025\"}, {\"start\": \"0x00401027\", \"end\": \"0x00401060\"}]}}",
					"outputDataExample": "{\"status\": \"Graph layout computed, viewport updated.\"}"
				},
				{
					"simStepId": "8733347f-1fd0-438c-9f09-9eedd6e5f84c",
					"diagramNodeId": "0235561d-90e5-4a13-970a-0dbc2c113d49",
					"simStepLabel": "Code Annotation: User Submits Label",
					"simStepDescription": "The user adds a label to an instruction. A dialog captures the text, and the GUI calls DbgSetLabelAt to send the address and the new label text to the debugger backend.",
					"isEdge": 1,
					"sourceCodeMapping": {
						"filePath": "src/gui/Src/Utils/CommonActions.cpp",
						"startLine": "269",
						"endLine": "270",
						"relevantVariables": [
							"va",
							"utf8data",
							"DbgSetLabelAt"
						]
					},
					"inputDataExample": "{\"va\": \"0x00401055\", \"text\": \"MyCustomLabel\"}",
					"outputDataExample": "{\"va\": \"0x00401055\", \"text\": \"MyCustomLabel\"}"
				},
				{
					"simStepId": "d969b9d2-bd55-4a93-ad59-d02f0eea09cf",
					"diagramNodeId": "1eeebdfb-1561-4d25-9f8f-605d36ff4c1c",
					"simStepLabel": "Code Annotation: Bridge Sets Label in Database",
					"simStepDescription": "The DbgSetLabelAt bridge function receives the label information. It communicates with the debugger core, which then stores the label in its user database, associating it with the specified address.",
					"isEdge": 0,
					"sourceCodeMapping": {
						"filePath": "src/bridge/bridgemain.cpp",
						"startLine": "609",
						"endLine": "613",
						"relevantVariables": [
							"addr",
							"text",
							"info",
							"_dbg_addrinfoset"
						]
					},
					"inputDataExample": "{\"addr\": \"0x00401055\", \"text\": \"MyCustomLabel\"}",
					"outputDataExample": "{\"result\": true}"
				},
				{
					"simStepId": "0e438326-12b0-4161-a630-e9d5adb2fdc7",
					"diagramNodeId": "776b2097-8f5d-4b2b-96c1-6e93f13467cd",
					"simStepLabel": "Code Annotation: UI Refresh Signal",
					"simStepDescription": "To ensure the new label is displayed immediately, the setLabelSlot function calls GuiUpdateAllViews, which signals all relevant UI components, including the graph view, to refresh their content.",
					"isEdge": 1,
					"sourceCodeMapping": {
						"filePath": "src/gui/Src/Utils/CommonActions.cpp",
						"startLine": "272",
						"endLine": "272",
						"relevantVariables": [
							"GuiUpdateAllViews"
						]
					},
					"inputDataExample": "{\"action\": \"GuiUpdateAllViews\"}",
					"outputDataExample": "{\"action\": \"GuiUpdateAllViews\"}"
				},
				{
					"simStepId": "5e93b9f2-d335-4432-9d90-124d8a0784e9",
					"diagramNodeId": "4670e13b-864b-4fae-88ff-c52ca0401b54",
					"simStepLabel": "Code Annotation: Graph View Refreshes with New Label",
					"simStepDescription": "The DisassemblerGraphView receives the update signal and triggers its updateGraphSlot. This causes the graph to be re-rendered, fetching the newly set label from the database and displaying it at the correct location.",
					"isEdge": 0,
					"sourceCodeMapping": {
						"filePath": "src/gui/Src/Gui/DisassemblerGraphView.cpp",
						"startLine": "2172",
						"endLine": "2175",
						"relevantVariables": [
							"DisassemblerGraphView::updateGraphSlot",
							"loadCurrentGraphSlot"
						]
					},
					"inputDataExample": "{}",
					"outputDataExample": "{\"status\": \"Graph view refreshed to display new label.\"}"
				},
				{
					"simStepId": "d3cdfad8-cae6-4d17-9829-24890b24e62f",
					"diagramNodeId": "17ae6a4e-0bcb-4ec6-bfa6-158edd6b0174",
					"simStepLabel": "Code Annotation: User Submits Comment",
					"simStepDescription": "Similarly to adding a label, the user adds a comment to an instruction. The GUI captures the text and calls DbgSetCommentAt to send the information to the backend.",
					"isEdge": 1,
					"sourceCodeMapping": {
						"filePath": "src/gui/Src/Utils/CommonActions.cpp",
						"startLine": "293",
						"endLine": "294",
						"relevantVariables": [
							"va",
							"comment",
							"DbgSetCommentAt"
						]
					},
					"inputDataExample": "{\"va\": \"0x00401055\", \"text\": \"This is an important call\"}",
					"outputDataExample": "{\"va\": \"0x00401055\", \"text\": \"This is an important call\"}"
				},
				{
					"simStepId": "c9d05359-0cd8-4179-9367-c8384cb2e7cc",
					"diagramNodeId": "ad9bb212-4e47-411e-974b-d8b76876d5ba",
					"simStepLabel": "Code Annotation: Bridge Sets Comment in Database",
					"simStepDescription": "The DbgSetCommentAt bridge function receives the comment information. It sends a message to the debugger core to store the comment in its user database at the specified address.",
					"isEdge": 0,
					"sourceCodeMapping": {
						"filePath": "src/bridge/bridgemain.cpp",
						"startLine": "641",
						"endLine": "645",
						"relevantVariables": [
							"addr",
							"text",
							"info",
							"_dbg_addrinfoset"
						]
					},
					"inputDataExample": "{\"addr\": \"0x00401055\", \"text\": \"This is an important call\"}",
					"outputDataExample": "{\"result\": true}"
				},
				{
					"simStepId": "43161348-31c5-4531-bca0-00e51d2f26b3",
					"diagramNodeId": "e79671d4-d899-408c-86d3-1cdc55d1e249",
					"simStepLabel": "Code Annotation: Updated Data Available for Refresh",
					"simStepDescription": "After the bridge call returns, the comment is saved in the database. The data is now available to be fetched by the GUI during the next repaint or refresh cycle.",
					"isEdge": 1,
					"sourceCodeMapping": {
						"filePath": "src/bridge/bridgemain.h",
						"startLine": "1141",
						"endLine": "1141",
						"relevantVariables": [
							"DbgSetCommentAt"
						]
					},
					"inputDataExample": "{\"success\": true, \"addr\": \"0x00401055\"}",
					"outputDataExample": "{\"success\": true, \"addr\": \"0x00401055\"}"
				},
				{
					"simStepId": "3df9f127-1dd6-47c5-b9a7-d1141090264b",
					"diagramNodeId": "a4239586-326a-4db6-b9af-7d70e7aa076c",
					"simStepLabel": "Code Annotation: Graph View Displays New Comment",
					"simStepDescription": "During a subsequent refresh (triggered by another action or manually), the DisassemblerGraphView re-renders its content. It fetches the new comment from the database and displays it next to the corresponding instruction, completing the annotation process.",
					"isEdge": 0,
					"sourceCodeMapping": {
						"filePath": "src/gui/Src/Gui/DisassemblerGraphView.cpp",
						"startLine": "2172",
						"endLine": "2175",
						"relevantVariables": [
