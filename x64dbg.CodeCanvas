		"17616057-f8d8-4e2c-8ebd-3a6eb2209bc8": {
			"path": "17616057-f8d8-4e2c-8ebd-3a6eb2209bc8",
			"cellName": "Logging: GUI Buffers Log Message - LogView.cpp:L257-366",
			"cellId": "17616057-f8d8-4e2c-8ebd-3a6eb2209bc8",
			"visible": true,
			"parentCellId": "ab9fa530-b123-4a8a-9794-ec68cc859aa8"
		},
		"src/gui/Src/Gui/LogView.cpp-simstep-fe1aa067-438e-4fb2-99b7-29e5d83a6b4e": {
			"path": "src/gui/Src/Gui/LogView.cpp-simstep-fe1aa067-438e-4fb2-99b7-29e5d83a6b4e",
			"fileName": "LogView.cpp",
			"wiki": "The `LogView` widget in the GUI has a slot connected to the bridge's signal. To prevent the UI from freezing due to a high volume of messages, it adds the incoming message to a temporary buffer (`logBuffer`) instead of rendering it immediately.",
			"cellName": "Logging: GUI Buffers Log Message - LogView.cpp:L257-366",
			"cellId": "17616057-f8d8-4e2c-8ebd-3a6eb2209bc8",
			"visible": true,
			"startLine": 257,
			"endLine": 366,
			"parentCellId": "ab9fa530-b123-4a8a-9794-ec68cc859aa8",
			"parentPath": "src/gui/Src/Gui/LogView.cpp",
			"simSteps": [
				{
					"simulationKey": "Execution Tracing and Logging",
					"simStepId": "fe1aa067-438e-4fb2-99b7-29e5d83a6b4e"
				}
			]
		},
		"bd7cd074-fdfd-41a5-b5bf-ba05edcfee82": {
			"path": "bd7cd074-fdfd-41a5-b5bf-ba05edcfee82",
			"cellName": "Logging: GUI Renders Buffered Logs - LogView.cpp:L572-597",
			"cellId": "bd7cd074-fdfd-41a5-b5bf-ba05edcfee82",
			"visible": true,
			"parentCellId": "ab9fa530-b123-4a8a-9794-ec68cc859aa8"
		},
		"src/gui/Src/Gui/LogView.cpp-simstep-e9aa1e85-4fc3-47e7-9451-90c4a9ed7ec8": {
			"path": "src/gui/Src/Gui/LogView.cpp-simstep-e9aa1e85-4fc3-47e7-9451-90c4a9ed7ec8",
			"fileName": "LogView.cpp",
			"wiki": "The flush timer's slot takes all the messages accumulated in `logBuffer`, appends them in a single operation to the `QTextBrowser` widget, and clears the buffer. This batch update strategy improves performance significantly.",
			"cellName": "Logging: GUI Renders Buffered Logs - LogView.cpp:L572-597",
			"cellId": "bd7cd074-fdfd-41a5-b5bf-ba05edcfee82",
			"visible": true,
