		"src/dbg/commands/cmd-debug-control.cpp-simstep-1d2b30d4-b3b4-4396-96c5-8e9123347574": {
			"path": "src/dbg/commands/cmd-debug-control.cpp-simstep-1d2b30d4-b3b4-4396-96c5-8e9123347574",
			"fileName": "cmd-debug-control.cpp",
			"wiki": "The cbDebugContinue command handler executes. It parses the argument '0' and determines that the user wants the debugger to handle the exception. It then calls dbgsetcontinuestatus with DBG_CONTINUE, overriding the default.",
			"cellName": "Runtime Flow: Continue Command is Processed - cmd-debug-control.cpp:L438-442",
