					"simulationKey": "Scripting and Automation via Commands",
					"simStepId": "abcc0ed9-67b8-4218-af5b-c1c2094a969e"
				}
			]
		},
		"47bbaadd-4e02-4a1c-9432-e72d36071b06": {
			"path": "47bbaadd-4e02-4a1c-9432-e72d36071b06",
			"cellName": "Backend: Command Received by Command Loop - x64dbg.cpp:L508-517",
			"cellId": "47bbaadd-4e02-4a1c-9432-e72d36071b06",
			"visible": true,
			"parentCellId": "bc840efc-2373-4dda-94f3-4ea3f06f73c9"
		},
		"src/dbg/x64dbg.cpp-simstep-70cdea0e-833e-4fb6-885f-e2755c888c93": {
			"path": "src/dbg/x64dbg.cpp-simstep-70cdea0e-833e-4fb6-885f-e2755c888c93",
			"fileName": "x64dbg.cpp",
			"wiki": "A dedicated command processing thread in the debugger backend continuously runs `cmdloop()`. Inside this loop, `cbCommandProvider` waits for and retrieves the next command string from a message queue, which was sent by the GUI via the bridge.",
			"cellName": "Backend: Command Received by Command Loop - x64dbg.cpp:L508-517",
			"cellId": "47bbaadd-4e02-4a1c-9432-e72d36071b06",
			"visible": true,
			"startLine": 508,
			"endLine": 517,
			"parentCellId": "bc840efc-2373-4dda-94f3-4ea3f06f73c9",
			"parentPath": "src/dbg/x64dbg.cpp",
			"simSteps": [
				{
					"simulationKey": "Scripting and Automation via Commands",
					"simStepId": "70cdea0e-833e-4fb6-885f-e2755c888c93"
				}
			]
		},
		"dcfc3b35-e1be-49c3-938b-60d54342a83e": {
			"path": "dcfc3b35-e1be-49c3-938b-60d54342a83e",
			"cellName": "Backend: Command Handler Lookup - command.cpp:L296-297",
			"cellId": "dcfc3b35-e1be-49c3-938b-60d54342a83e",
			"visible": true,
			"parentCellId": "dddaa3b4-2709-4c35-91ad-40cfb30eac22"
		},
		"src/dbg/command.cpp-simstep-1765271b-8671-42f9-996a-2d0fd40f7e96": {
			"path": "src/dbg/command.cpp-simstep-1765271b-8671-42f9-996a-2d0fd40f7e96",
			"fileName": "command.cpp",
			"wiki": "The `cmdloop` function takes the command string and uses `cmdget` to search through a globally registered list of `COMMAND` structures. It looks for a structure whose name matches the command ('run'). This list is populated at startup by functions like `dbgcmdnew`.",
			"cellName": "Backend: Command Handler Lookup - command.cpp:L296-297",
			"cellId": "dcfc3b35-e1be-49c3-938b-60d54342a83e",
			"visible": true,
			"startLine": 296,
			"endLine": 297,
			"parentCellId": "dddaa3b4-2709-4c35-91ad-40cfb30eac22",
			"parentPath": "src/dbg/command.cpp",
			"simSteps": [
				{
					"simulationKey": "Scripting and Automation via Commands",
					"simStepId": "1765271b-8671-42f9-996a-2d0fd40f7e96"
				}
			]
		},
		"3d88bcb6-9da5-420d-bfc6-65d66bd44a8a": {
			"path": "3d88bcb6-9da5-420d-bfc6-65d66bd44a8a",
			"cellName": "Backend: Command Execution - command.cpp:L255-274",
			"cellId": "3d88bcb6-9da5-420d-bfc6-65d66bd44a8a",
			"visible": true,
			"parentCellId": "dddaa3b4-2709-4c35-91ad-40cfb30eac22"
		},
		"src/dbg/command.cpp-simstep-f30cce4b-bd11-4120-b416-d029b1e22f53": {
			"path": "src/dbg/command.cpp-simstep-f30cce4b-bd11-4120-b416-d029b1e22f53",
			"fileName": "command.cpp",
			"wiki": "The `cmdexeccallback` function parses the command string into arguments (argc, argv format) and then invokes the `cbCommand` function pointer that was retrieved in the lookup step. This executes the specific logic for the 'run' command, which in this case is handled by `cbDebugRunInternal`.",
			"cellName": "Backend: Command Execution - command.cpp:L255-274",
			"cellId": "3d88bcb6-9da5-420d-bfc6-65d66bd44a8a",
			"visible": true,
			"startLine": 255,
			"endLine": 274,
			"parentCellId": "dddaa3b4-2709-4c35-91ad-40cfb30eac22",
			"parentPath": "src/dbg/command.cpp",
			"simSteps": [
				{
					"simulationKey": "Scripting and Automation via Commands",
					"simStepId": "f30cce4b-bd11-4120-b416-d029b1e22f53"
				}
			]
		},
