							"info.loadSymbols"
						]
					},
					"inputDataExample": "{\"pdbPath\": \"C:\\\\symbols\\\\ntdll.pdb\\\\A427C13595224527941D32F49BB3A2F11\\\\ntdll.pdb\", \"bForceLoadSymbols\": false}",
					"outputDataExample": "{\"result\": true}"
				},
				{
					"simStepId": "fd5bdf00-d8ae-46af-b751-ea1acd55bc60",
