		"549e11c4-72dd-46ca-8635-210aab0924c0": {
			"path": "549e11c4-72dd-46ca-8635-210aab0924c0",
			"cellName": "User Issues 'Step Into' Command - cmd-debug-control.cpp:L453-461",
			"cellId": "549e11c4-72dd-46ca-8635-210aab0924c0",
			"visible": true,
			"parentCellId": "b8fdb92e-9a99-467c-a487-1af9ad7b7b56"
		},
		"src/dbg/commands/cmd-debug-control.cpp-simstep-0c2483ee-b7b3-44c9-8ff1-db8f3042700e": {
			"path": "src/dbg/commands/cmd-debug-control.cpp-simstep-0c2483ee-b7b3-44c9-8ff1-db8f3042700e",
			"fileName": "cmd-debug-control.cpp",
			"wiki": "The user executes the 'StepInto' command, either by clicking the 'Step Into' button in the GUI or by typing 'StepInto' in the command bar. The command system dispatches this to the `cbDebugStepInto` function.",
			"cellName": "User Issues 'Step Into' Command - cmd-debug-control.cpp:L453-461",
			"cellId": "549e11c4-72dd-46ca-8635-210aab0924c0",
			"visible": true,
			"startLine": 453,
			"endLine": 461,
			"parentCellId": "b8fdb92e-9a99-467c-a487-1af9ad7b7b56",
			"parentPath": "src/dbg/commands/cmd-debug-control.cpp",
			"simSteps": [
				{
					"simulationKey": "Core Dynamic Analysis: Interactive Program Execution and State Inspection",
					"simStepId": "0c2483ee-b7b3-44c9-8ff1-db8f3042700e"
				}
			]
		},
		"9dc27ba2-b51e-44db-a85f-e8bd87ca6247": {
			"path": "9dc27ba2-b51e-44db-a85f-e8bd87ca6247",
			"cellName": "Executing 'StepInto' via TitanEngine - debugger.cpp:L3118-3143",
			"cellId": "9dc27ba2-b51e-44db-a85f-e8bd87ca6247",
			"visible": true,
			"parentCellId": "abf8f82a-7554-4436-b28a-1a87bbf5d7c0"
		},
		"src/dbg/debugger.cpp-simstep-c5733e0b-1b42-48f0-a586-0b8613308f4e": {
			"path": "src/dbg/debugger.cpp-simstep-c5733e0b-1b42-48f0-a586-0b8613308f4e",
			"fileName": "debugger.cpp",
			"wiki": "The `StepIntoWow64` wrapper function calls the `StepInto` function from the TitanEngine API. This function is responsible for setting the trap flag on the debugged thread's context to enable single-stepping and then resuming the thread.",
			"cellName": "Executing 'StepInto' via TitanEngine - debugger.cpp:L3118-3143",
			"cellId": "9dc27ba2-b51e-44db-a85f-e8bd87ca6247",
			"visible": true,
			"startLine": 3118,
			"endLine": 3143,
			"parentCellId": "abf8f82a-7554-4436-b28a-1a87bbf5d7c0",
			"parentPath": "src/dbg/debugger.cpp",
			"simSteps": [
				{
					"simulationKey": "Core Dynamic Analysis: Interactive Program Execution and State Inspection",
					"simStepId": "c5733e0b-1b42-48f0-a586-0b8613308f4e"
				}
			]
		},
		"6f61ea39-5f1d-460b-99f5-d0124e8439c2": {
			"path": "6f61ea39-5f1d-460b-99f5-d0124e8439c2",
			"cellName": "Debug Loop Processes Exception - debugger.cpp:L2795-2984",
			"cellId": "6f61ea39-5f1d-460b-99f5-d0124e8439c2",
			"visible": true,
			"parentCellId": "abf8f82a-7554-4436-b28a-1a87bbf5d7c0"
		},
		"src/dbg/debugger.cpp-simstep-14b996b0-1ab2-4423-bde3-aa26a27815cb": {
			"path": "src/dbg/debugger.cpp-simstep-14b996b0-1ab2-4423-bde3-aa26a27815cb",
			"fileName": "debugger.cpp",
			"wiki": "The main `debugLoopFunction` receives and processes the single-step exception. The TitanEngine core identifies this event and invokes the callback function (`cbStep`) that was originally provided to `StepInto`.",
			"cellName": "Debug Loop Processes Exception - debugger.cpp:L2795-2984",
			"cellId": "6f61ea39-5f1d-460b-99f5-d0124e8439c2",
			"visible": true,
			"startLine": 2795,
			"endLine": 2984,
			"parentCellId": "abf8f82a-7554-4436-b28a-1a87bbf5d7c0",
			"parentPath": "src/dbg/debugger.cpp",
			"simSteps": [
				{
					"simulationKey": "Core Dynamic Analysis: Interactive Program Execution and State Inspection",
					"simStepId": "14b996b0-1ab2-4423-bde3-aa26a27815cb"
				}
			]
		},
		"06485482-89c2-461c-9e7f-d8c5adb60acc": {
			"path": "06485482-89c2-461c-9e7f-d8c5adb60acc",
			"cellName": "Step Completion and State Update - debugger.cpp:L1394-1422",
			"cellId": "06485482-89c2-461c-9e7f-d8c5adb60acc",
			"visible": true,
			"parentCellId": "abf8f82a-7554-4436-b28a-1a87bbf5d7c0"
		},
		"src/dbg/debugger.cpp-simstep-207cecc9-4b82-4bc7-ac79-d53dc5fc354d": {
			"path": "src/dbg/debugger.cpp-simstep-207cecc9-4b82-4bc7-ac79-d53dc5fc354d",
			"fileName": "debugger.cpp",
			"wiki": "The `cbStep` function executes. It retrieves the new instruction pointer (CIP), updates the GUI to reflect the new program state (registers, memory, disassembly), pauses the debuggee by locking the run event, and triggers plugin callbacks before waiting for the next command.",
			"cellName": "Step Completion and State Update - debugger.cpp:L1394-1422",
			"cellId": "06485482-89c2-461c-9e7f-d8c5adb60acc",
			"visible": true,
			"startLine": 1394,
			"endLine": 1422,
			"parentCellId": "abf8f82a-7554-4436-b28a-1a87bbf5d7c0",
			"parentPath": "src/dbg/debugger.cpp",
			"simSteps": [
				{
					"simulationKey": "Core Dynamic Analysis: Interactive Program Execution and State Inspection",
					"simStepId": "207cecc9-4b82-4bc7-ac79-d53dc5fc354d"
				}
			]
		},
		"9282e764-94d6-41fd-9020-2036d94d7b89": {
			"path": "9282e764-94d6-41fd-9020-2036d94d7b89",
			"cellName": "User Modifies Register Value - value.cpp:L1152-1402",
			"cellId": "9282e764-94d6-41fd-9020-2036d94d7b89",
			"visible": true,
			"parentCellId": "20370299-c788-449e-9583-84fc0346d516"
		},
		"src/dbg/value.cpp-simstep-ae0261b6-1bfa-4bd3-86ae-13572d70632c": {
			"path": "src/dbg/value.cpp-simstep-ae0261b6-1bfa-4bd3-86ae-13572d70632c",
			"fileName": "value.cpp",
			"wiki": "When a user modifies a register in the GUI or via a command like 'mov eax, 1337', the `setregister` function is ultimately called. It parses the register name and prepares to call the underlying debug engine function.",
			"cellName": "User Modifies Register Value - value.cpp:L1152-1402",
			"cellId": "9282e764-94d6-41fd-9020-2036d94d7b89",
			"visible": true,
			"startLine": 1152,
			"endLine": 1402,
			"parentCellId": "20370299-c788-449e-9583-84fc0346d516",
			"parentPath": "src/dbg/value.cpp",
			"simSteps": [
				{
					"simulationKey": "Core Dynamic Analysis: Interactive Program Execution and State Inspection",
					"simStepId": "ae0261b6-1bfa-4bd3-86ae-13572d70632c"
				}
			]
		},
		"369d59c4-ab3c-4466-8aa6-622b64bfad77": {
			"path": "369d59c4-ab3c-4466-8aa6-622b64bfad77",
			"cellName": "TitanEngine Core Context Update - TitanEngine.h:L334",
			"cellId": "369d59c4-ab3c-4466-8aa6-622b64bfad77",
			"visible": true,
			"parentCellId": "18fcc18b-9571-4ee2-8c1a-fecb5466dd41"
		},
		"src/dbg/TitanEngine/TitanEngine.h-simstep-c1f29436-7db5-40d2-8f93-ed52f2b0c5cd": {
			"path": "src/dbg/TitanEngine/TitanEngine.h-simstep-c1f29436-7db5-40d2-8f93-ed52f2b0c5cd",
			"fileName": "TitanEngine.h",
			"wiki": "The `SetContextDataEx` function in TitanEngine handles the low-level details. It uses the Windows API functions `GetThreadContext`, modifies the appropriate field in the `CONTEXT` structure, and then applies the changes with `SetThreadContext`.",
			"cellName": "TitanEngine Core Context Update - TitanEngine.h:L334",
			"cellId": "369d59c4-ab3c-4466-8aa6-622b64bfad77",
			"visible": true,
			"startLine": 334,
			"endLine": 334,
			"parentCellId": "18fcc18b-9571-4ee2-8c1a-fecb5466dd41",
			"parentPath": "src/dbg/TitanEngine/TitanEngine.h",
			"simSteps": [
				{
					"simulationKey": "Core Dynamic Analysis: Interactive Program Execution and State Inspection",
					"simStepId": "c1f29436-7db5-40d2-8f93-ed52f2b0c5cd"
				}
			]
		},
		"3f443e22-c9a9-48cd-8440-295b79b14f70": {
			"path": "3f443e22-c9a9-48cd-8440-295b79b14f70",
			"cellName": "GUI Displays Updated Value - CPURegistersView.cpp:L322-332",
