		"src/gui/Src/Gui/CPUDisassembly.cpp-simstep-f08df488-9eef-4381-8a68-284a47de7294": {
			"path": "src/gui/Src/Gui/CPUDisassembly.cpp-simstep-f08df488-9eef-4381-8a68-284a47de7294",
			"fileName": "CPUDisassembly.cpp",
			"wiki": "Various components in the debugger backend generate messages to inform the user of events (e.g., breakpoint hit, module loaded, errors). These components call the `GuiAddLogMessage` bridge function.",
			"cellName": "Logging: Backend Generates Log Message - CPUDisassembly.cpp:L1932",
