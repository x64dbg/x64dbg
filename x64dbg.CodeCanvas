		"src/gui/Src/Gui/DisassemblerGraphView.cpp-simstep-9e778864-e196-4e2b-abb2-e4f68c1b2419": {
			"path": "src/gui/Src/Gui/DisassemblerGraphView.cpp-simstep-9e778864-e196-4e2b-abb2-e4f68c1b2419",
			"fileName": "DisassemblerGraphView.cpp",
			"wiki": "The user initiates the code visualization process by requesting a control flow graph for a specific address. This is often done by using the 'graph' command or a menu option, which triggers the graphAtSlot in the DisassemblerGraphView.",
			"cellName": "Code Visualization: User Requests Control Flow Graph - DisassemblerGraphView.cpp:L2164-2167",
			"cellId": "2d46360c-26ec-40f9-91f5-1c9107f0514f",
			"visible": true,
			"startLine": 2164,
			"endLine": 2167,
