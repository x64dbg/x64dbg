						]
					},
					"inputDataExample": "{\"path\": \"C:\\\\symbols\\\\ntdll.pdb\\\\...\\\\ntdll.pdb\", \"modname\": \"ntdll.dll\", \"imageBase\": \"0x77000000\", \"imageSize\": \"0x180000\", \"validationData\": {\"guid\": \"{C135A427-...}\", \"signature\": 0, \"age\": 1}}",
					"outputDataExample": "{\"_isOpen\": true, \"_symbolsThread\": \"0x...\", \"_linesThread\": \"0x...\"}"
				},
				{
					"simStepId": "9cbe84b7-f4c4-4715-903e-a450afa5f98a",
					"diagramNodeId": "efc54042-7255-4835-99ec-7ab1e9733e8a",
					"simStepLabel": "[Auto-load] PDB Info to PDBDiaFile::open",
					"simStepDescription": "The file path and validation data are passed to the low-level `PDBDiaFile::open` function to interact with the DIA SDK.",
					"isEdge": 1,
					"sourceCodeMapping": {
						"filePath": "src/dbg/symbolsourcedia.cpp",
						"startLine": "46",
						"endLine": "46",
						"relevantVariables": [
							"pdb.open",
							"path",
							"validationData"
						]
					},
					"inputDataExample": "{\"file\": \"C:\\\\symbols\\\\ntdll.pdb\\\\...\\\\ntdll.pdb\", \"validationData\": {\"guid\": \"{C135A427-...}\", \"signature\": 0, \"age\": 1}}",
					"outputDataExample": "{\"file\": \"C:\\\\symbols\\\\ntdll.pdb\\\\...\\\\ntdll.pdb\", \"validationData\": {\"guid\": \"{C135A427-...}\", \"signature\": 0, \"age\": 1}}"
				},
				{
					"simStepId": "237b20a4-0a0c-4748-889f-37be9c06f145",
					"diagramNodeId": "182e539d-4372-44d0-a698-e7134dc09040",
					"simStepLabel": "[Auto-load] Core DIA SDK Interaction",
					"simStepDescription": "The `PDBDiaFile::open` function performs the core interaction with the Microsoft DIA SDK. It initializes COM, creates a DIA data source, loads the PDB file, opens a DIA session, and crucially, validates that the PDB's GUID and age match the data from the executable, ensuring the correct symbols are loaded.",
					"isEdge": 0,
					"sourceCodeMapping": {
						"filePath": "src/dbg/pdbdiafile.cpp",
						"startLine": "239",
						"endLine": "384",
						"relevantVariables": [
							"CoCreateInstance",
							"m_dataSource",
							"m_dataSource->loadDataFromIStream",
							"m_dataSource->openSession",
							"m_session",
							"globalSym->get_guid",
							"globalSym->get_age"
						]
					},
					"inputDataExample": "{\"file\": \"C:\\\\symbols\\\\ntdll.pdb\\\\...\\\\ntdll.pdb\", \"validationData\": {\"guid\": \"{C135A427-...}\", \"signature\": 0, \"age\": 1}}",
					"outputDataExample": "{\"m_session\": \"0x...\", \"result\": true}"
				},
				{
					"simStepId": "d088ccfd-1b16-4a67-b919-9fe8709dfe0b",
					"diagramNodeId": "ca8708af-fc4d-4ef6-8284-ae67079dc1a4",
					"simStepLabel": "[Auto-load] PDB Session Ready for Parsing",
					"simStepDescription": "Once the DIA session is successfully opened and validated, the `SymbolSourceDIA` object is ready for the background threads to begin parsing symbols.",
					"isEdge": 1,
					"sourceCodeMapping": {
						"filePath": "src/dbg/symbolsourcedia.cpp",
						"startLine": "51",
						"endLine": "52",
						"relevantVariables": [
							"SymbolsThread",
							"this"
						]
					},
					"inputDataExample": "{\"this\": \"SymbolSourceDIA instance with open PDB session\"}",
					"outputDataExample": "{\"this\": \"SymbolSourceDIA instance with open PDB session\"}"
				},
				{
					"simStepId": "9ee3235f-15e2-4baf-821e-07b8b1a69777",
					"diagramNodeId": "5283f8dd-ca2d-41e5-8682-687b84aaabfc",
					"simStepLabel": "[Auto-load] Asynchronous Symbol Parsing",
					"simStepDescription": "In a background thread, the `loadSymbolsAsync` function re-opens the PDB and calls `enumerateLexicalHierarchy`. This traverses the entire symbol tree within the PDB file, and a callback function processes each symbol, adding it to the debugger's internal data structures.",
					"isEdge": 0,
					"sourceCodeMapping": {
						"filePath": "src/dbg/symbolsourcedia.cpp",
						"startLine": "113",
						"endLine": "169",
						"relevantVariables": [
							"loadSymbolsAsync",
							"pdb.enumerateLexicalHierarchy",
							"query.callback",
							"_symData"
						]
					},
					"inputDataExample": "{\"_path\": \"C:\\\\symbols\\\\ntdll.pdb\\\\...\\\\ntdll.pdb\"}",
					"outputDataExample": "{\"_symData\": [{\"name\": \"NtCreateFile\", \"rva\": \"0x...\"}, ...]}"
				},
				{
					"simStepId": "18ee414a-ebf4-47a9-b11e-38ca04d6fda6",
					"diagramNodeId": "0d195f71-e4ee-453f-aee4-2028efd5941e",
					"simStepLabel": "[Manual-download] User Initiates Symbol Download",
					"simStepDescription": "The user initiates a symbol download, either via a context menu in the GUI or by executing the `symdownload` command. This invokes the `cbDebugDownloadSymbol` command handler.",
					"isEdge": 0,
					"sourceCodeMapping": {
						"filePath": "src/dbg/commands/cmd-analysis.cpp",
						"startLine": "199",
						"endLine": "204",
						"relevantVariables": [
							"cbDebugDownloadSymbol",
							"modbase",
							"szSymbolStore",
							"SymDownloadSymbol"
						]
					},
					"inputDataExample": "{\"argc\": 2, \"argv\": [\"symdownload\", \"ntdll.dll\"]}",
					"outputDataExample": "{\"modbase\": \"0x77000000\", \"szSymbolStore\": \"https://msdl.microsoft.com/download/symbols\"}"
				},
				{
					"simStepId": "71818e11-a295-4b70-aa21-bfeca3ab8030",
					"diagramNodeId": "309741f6-eec6-416d-bdcd-1a1b060ca13e",
					"simStepLabel": "[Manual-download] Module Info to SymDownloadSymbol",
					"simStepDescription": "The module's base address and the configured symbol store URL are passed to the `SymDownloadSymbol` function to orchestrate the download.",
					"isEdge": 1,
					"sourceCodeMapping": {
						"filePath": "src/dbg/commands/cmd-analysis.cpp",
						"startLine": "201",
						"endLine": "201",
						"relevantVariables": [
							"SymDownloadSymbol"
						]
					},
					"inputDataExample": "{\"Base\": \"0x77000000\", \"SymbolStore\": \"https://msdl.microsoft.com/download/symbols\"}",
					"outputDataExample": "{\"Base\": \"0x77000000\", \"SymbolStore\": \"https://msdl.microsoft.com/download/symbols\"}"
				},
				{
					"simStepId": "79467cad-8a1f-4dd5-8d97-21990fb17e25",
					"diagramNodeId": "4c30affa-9710-4196-a33d-61639814a2c7",
					"simStepLabel": "[Manual-download] Prepare Download URL and Cache Path",
					"simStepDescription": "The `SymDownloadSymbol` function retrieves the PDB signature and filename for the specified module. It then constructs the full download URL and the corresponding local cache path according to the standard symbol server layout (`CachePath\\PDBName\\Signature\\PDBName`).",
					"isEdge": 0,
					"sourceCodeMapping": {
						"filePath": "src/dbg/symbolinfo.cpp",
						"startLine": "206",
						"endLine": "290",
						"relevantVariables": [
							"pdbSignature",
							"pdbFile",
							"szSymbolCachePath",
							"symbolPath",
							"symbolUrl"
						]
					},
					"inputDataExample": "{\"Base\": \"0x77000000\", \"SymbolStore\": \"https://msdl.microsoft.com/download/symbols\"}",
					"outputDataExample": "{\"symbolUrl\": \"https://msdl.microsoft.com/download/symbols/ntdll.pdb/A427C13595224527941D32F49BB3A2F11/ntdll.pdb\", \"symbolPath\": \"C:\\\\symbols\\\\ntdll.pdb\\\\A427C13595224527941D32F49BB3A2F11\\\\ntdll.pdb\"}"
				},
				{
					"simStepId": "7910d8e6-a94f-419d-ab8b-1f9cd3696103",
					"diagramNodeId": "5e3c4e3c-a4fb-424e-ae80-39c37e8ea63d",
					"simStepLabel": "[Manual-download] URL and Path to Downloader",
					"simStepDescription": "The constructed download URL and local destination path are passed to the `downslib_download` function.",
					"isEdge": 1,
					"sourceCodeMapping": {
						"filePath": "src/dbg/symbolinfo.cpp",
						"startLine": "292",
						"endLine": "292",
						"relevantVariables": [
							"downslib_download",
							"symbolUrl",
							"symbolPath"
						]
					},
					"inputDataExample": "{\"url\": \"https://msdl.microsoft.com/download/symbols/ntdll.pdb/A427C13595224527941D32F49BB3A2F11/ntdll.pdb\", \"filename\": \"C:\\\\symbols\\\\ntdll.pdb\\\\A427C13595224527941D32F49BB3A2F11\\\\ntdll.pdb\"}",
					"outputDataExample": "{\"url\": \"https://msdl.microsoft.com/download/symbols/ntdll.pdb/A427C13595224527941D32F49BB3A2F11/ntdll.pdb\", \"filename\": \"C:\\\\symbols\\\\ntdll.pdb\\\\A427C13595224527941D32F49BB3A2F11\\\\ntdll.pdb\"}"
				},
				{
					"simStepId": "be96ea26-2f99-4183-841e-a86e39f84745",
					"diagramNodeId": "66751612-9c58-478e-a069-541f7d3437f2",
					"simStepLabel": "[Manual-download] Download PDB File",
					"simStepDescription": "The `downslib_download` function uses the WinINet API to handle the HTTP download. It connects to the symbol server, requests the file, reads the response in chunks, and writes the data to the destination file in the local symbol cache. A callback provides progress updates to the GUI.",
					"isEdge": 0,
					"sourceCodeMapping": {
						"filePath": "src/dbg/WinInet-Downloader/downslib.cpp",
						"startLine": "18",
						"endLine": "150",
						"relevantVariables": [
							"downslib_download",
							"InternetOpenA",
							"InternetOpenUrlA",
							"HttpQueryInfoA",
							"CreateFileW",
							"InternetReadFile",
							"WriteFile"
						]
					},
					"inputDataExample": "{\"url\": \"https://msdl.microsoft.com/download/symbols/ntdll.pdb/A427C13595224527941D32F49BB3A2F11/ntdll.pdb\", \"filename\": \"C:\\\\symbols\\\\ntdll.pdb\\\\A427C13595224527941D32F49BB3A2F11\\\\ntdll.pdb\"}",
					"outputDataExample": "{\"result\": \"ok\"}"
				},
				{
					"simStepId": "d194811d-0d3f-49a5-a893-824eee863593",
					"diagramNodeId": "73ce5bb5-1e67-47a5-936f-135f5748fd7f",
					"simStepLabel": "[Manual-download] Path of Downloaded PDB to Symbol Loader",
					"simStepDescription": "After a successful download, the local path of the newly acquired PDB file is passed back to the symbol loading logic.",
					"isEdge": 1,
					"sourceCodeMapping": {
						"filePath": "src/dbg/symbolinfo.cpp",
						"startLine": "343",
						"endLine": "347",
						"relevantVariables": [
							"szSymbolPath",
							"info->loadSymbols"
						]
					},
					"inputDataExample": "{\"szSymbolPath\": \"C:\\\\symbols\\\\ntdll.pdb\\\\A427C13595224527941D32F49BB3A2F11\\\\ntdll.pdb\"}",
					"outputDataExample": "{\"szSymbolPath\": \"C:\\\\symbols\\\\ntdll.pdb\\\\A427C13595224527941D32F49BB3A2F11\\\\ntdll.pdb\"}"
				},
				{
					"simStepId": "d5cd8ada-8518-4c6d-b418-bd8fdb28b7db",
					"diagramNodeId": "288a3c3b-37d8-41b6-9832-60de239334da",
					"simStepLabel": "[Manual-download] Trigger Symbol Loading",
					"simStepDescription": "The `SymDownloadSymbol` function now calls `info->loadSymbols` with the path to the downloaded PDB file. This merges the manual download flow with the automatic loading flow, proceeding to validate and parse the local PDB file as described in the previous steps.",
					"isEdge": 0,
					"sourceCodeMapping": {
						"filePath": "src/dbg/symbolinfo.cpp",
						"startLine": "343",
						"endLine": "347",
						"relevantVariables": [
							"info",
							"loadSymbols",
							"szSymbolPath"
						]
					},
					"inputDataExample": "{\"szSymbolPath\": \"C:\\\\symbols\\\\ntdll.pdb\\\\A427C13595224527941D32F49BB3A2F11\\\\ntdll.pdb\", \"forceLoad\": true}",
					"outputDataExample": "{\"result\": true}"
				}
			],
			"description": "<ul><li>Using symbols turns a sea of raw addresses into meaningful, human-readable code</li><li>- View all modules (DLLs and EXEs) loaded by the debugged process</li><li>- Automatically load and parse Program Database (PDB) files to resolve function and variable names</li><li>- Download missing symbol files from public symbol servers, such as Microsoft's</li><li>- Inspect a module's import and export tables to understand its dependencies and provided functionalities</li></ul>",
			"simulationNodesAndEdges": {
