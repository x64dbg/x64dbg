							"Info.pdbSignature",
							"Info.pdbFile",
							"Info.pdbValidation",
							"Info.pdbPaths"
						]
					},
					"inputDataExample": "{\"base\": \"0x77000000\", \"size\": 1, \"FullPath\": \"C:\\\\Windows\\\\System32\\\\ntdll.dll\", \"loadSymbols\": true}",
					"outputDataExample": "{\"Info.pdbSignature\": \"A427C13595224527941D32F49BB3A2F11\", \"Info.pdbFile\": \"ntdll.pdb\", \"Info.pdbPaths\": [\"C:\\\\symbols\\\\ntdll.pdb\\\\A427C13595224527941D32F49BB3A2F11\\\\ntdll.pdb\", \"C:\\\\Windows\\\\System32\\\\ntdll.pdb\"]}"
				},
				{
					"simStepId": "c2e29dd4-ca28-4b0b-8572-b2f0063073bb",
					"diagramNodeId": "45f504e0-e2cb-404f-bf3b-8ce1436b8b7b",
					"simStepLabel": "[Auto-load] Pass PDB Paths to Symbol Loader",
					"simStepDescription": "A list of potential local paths for the PDB file is constructed and passed to the symbol loading logic, which will try each path in order.",
					"isEdge": 1,
					"sourceCodeMapping": {
						"filePath": "src/dbg/module.cpp",
						"startLine": "968",
						"endLine": "971",
						"relevantVariables": [
							"info.pdbPaths"
						]
					},
					"inputDataExample": "{\"pdbPaths\": [\"C:\\\\symbols\\\\ntdll.pdb\\\\A427C13595224527941D32F49BB3A2F11\\\\ntdll.pdb\", \"C:\\\\Windows\\\\System32\\\\ntdll.pdb\"]}",
					"outputDataExample": "{\"pdbPaths\": [\"C:\\\\symbols\\\\ntdll.pdb\\\\A427C13595224527941D32F49BB3A2F11\\\\ntdll.pdb\", \"C:\\\\Windows\\\\System32\\\\ntdll.pdb\"]}"
				},
				{
					"simStepId": "4b7a6ba2-c871-433a-bf4c-9e7facb3f2d8",
