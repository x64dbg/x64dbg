		"Extensibility via Plugins": {
			"name": "Extensibility via Plugins",
			"simSteps": [
				{
					"simStepId": "8c477022-e7f7-4b07-ae98-08c17a423bae",
					"diagramNodeId": "ee9fb2cf-ee95-4880-9eab-80fcb6b097f6",
					"simStepLabel": "User Executes `plugload` Command",
					"simStepDescription": "The user initiates the plugin loading process by executing the `plugload` command in the debugger's command interface, specifying the name of the plugin to be loaded.",
					"isEdge": 0,
					"sourceCodeMapping": {
						"filePath": "src/dbg/commands/cmd-plugins.cpp",
						"startLine": "48",
						"endLine": "52",
						"relevantVariables": [
							"cbInstrPluginLoad"
						]
					},
					"inputDataExample": "{\"command\": \"plugload MyPlugin.dp64\"}",
					"outputDataExample": "{\"argc\": 2, \"argv\": [\"plugload\", \"MyPlugin.dp64\"]}"
				},
				{
					"simStepId": "143a4974-e010-4390-9ea7-c31dbbab2771",
					"diagramNodeId": "778aefaf-d0cf-4bd3-b3fc-b23c832d6afe",
					"simStepLabel": "Command to Function Call",
					"simStepDescription": "The command handler `cbInstrPluginLoad` receives the parsed arguments and passes the plugin name to the core `pluginload` function to handle the loading logic.",
					"isEdge": 1,
					"sourceCodeMapping": {
						"filePath": "src/dbg/commands/cmd-plugins.cpp",
						"startLine": "51",
						"endLine": "51",
						"relevantVariables": [
							"pluginload",
							"argv[1]"
						]
					},
					"inputDataExample": "{\"pluginName\": \"MyPlugin.dp64\"}",
					"outputDataExample": "{\"pluginName\": \"MyPlugin.dp64\"}"
				},
				{
					"simStepId": "ea042377-8e5d-4dab-a51a-c3147a3bc0e4",
					"diagramNodeId": "d86add35-6e01-4e5c-9c8a-9d49236f608d",
					"simStepLabel": "Load Plugin DLL",
					"simStepDescription": "The `pluginload` function resolves the full path to the plugin's DLL file and loads it into the debugger's process space using the Windows `LoadLibraryExW` API.",
					"isEdge": 0,
					"sourceCodeMapping": {
						"filePath": "src/dbg/plugin_loader.cpp",
						"startLine": "157",
						"endLine": "214",
						"relevantVariables": [
							"pluginload",
							"LoadLibraryExW",
							"gLoadingPlugin.hPlugin"
						]
					},
					"inputDataExample": "{\"pluginName\": \"MyPlugin.dp64\", \"loadall\": false}",
					"outputDataExample": "{\"hPlugin\": \"0x00007FF8B2A10000\"}"
				},
				{
					"simStepId": "4993425d-3665-4e6e-91ee-ed1fa35e96e0",
					"diagramNodeId": "b83cd871-0224-45cc-87f0-bab1bfff7e04",
					"simStepLabel": "Retrieve `pluginit` Function Address",
					"simStepDescription": "After successfully loading the DLL, the debugger needs to find the mandatory `pluginit` exported function to begin the initialization handshake. This is done using `GetProcAddress`.",
					"isEdge": 1,
					"sourceCodeMapping": {
						"filePath": "src/dbg/plugin_loader.cpp",
						"startLine": "215",
						"endLine": "215",
						"relevantVariables": [
							"GetProcAddress",
							"gLoadingPlugin.hPlugin",
							"gLoadingPlugin.pluginit"
						]
					},
					"inputDataExample": "{\"hPlugin\": \"0x00007FF8B2A10000\", \"functionName\": \"pluginit\"}",
					"outputDataExample": "{\"functionPointer\": \"0x00007FF8B2A111A0\"}"
				},
				{
					"simStepId": "8c2d3bf0-7342-48a1-bb5a-43da3f5586d5",
					"diagramNodeId": "38430e55-e541-4904-84c0-d1b457e3e6bf",
					"simStepLabel": "Initialize Plugin",
					"simStepDescription": "The debugger calls the retrieved `pluginit` function from the plugin. It passes a `PLUG_INITSTRUCT` structure that the plugin must fill with its information, such as its name and version. The plugin performs its initial setup and returns `true` on success.",
					"isEdge": 0,
					"sourceCodeMapping": {
						"filePath": "src/dbg/plugin_loader.cpp",
						"startLine": "232",
						"endLine": "239",
						"relevantVariables": [
							"gLoadingPlugin.pluginit",
							"gLoadingPlugin.initStruct"
						]
					},
					"inputDataExample": "{\"initStruct\": {\"pluginHandle\": 1, \"sdkVersion\": 0, \"pluginVersion\": 0, \"pluginName\": \"\"}}",
					"outputDataExample": "{\"success\": true}"
				},
				{
					"simStepId": "8b89d25b-9d7b-4005-9b47-3720da372d07",
					"diagramNodeId": "4373fd2a-9c58-42f2-9c75-aa3746f0bd25",
					"simStepLabel": "Plugin Metadata Exchange",
					"simStepDescription": "The `PLUG_INITSTRUCT` acts as a data exchange mechanism. The debugger provides a handle, and the plugin fills in its metadata. This confirms a successful initialization.",
					"isEdge": 1,
					"sourceCodeMapping": {
						"filePath": "src/dbg/_plugins.h",
						"startLine": "32",
						"endLine": "40",
						"relevantVariables": [
							"PLUG_INITSTRUCT"
						]
					},
					"inputDataExample": "{\"pluginHandle\": 1, \"sdkVersion\": 1, \"pluginVersion\": 0, \"pluginName\": \"\"}",
					"outputDataExample": "{\"pluginHandle\": 1, \"sdkVersion\": 1, \"pluginVersion\": 1, \"pluginName\": \"MyPlugin\"}"
				},
				{
					"simStepId": "fcdcb2c8-8203-45ad-a811-0500a0833e62",
					"diagramNodeId": "0cfede9c-66a4-4763-9916-f994967c46c5",
					"simStepLabel": "Register Event Callbacks",
					"simStepDescription": "Upon successful initialization, plugins can register callback functions for various debugger events. The debugger may auto-discover exported callbacks (e.g., `CBBREAKPOINT`) or the plugin can explicitly call `_plugin_registercallback` to subscribe to events like breakpoint hits, process creation, etc.",
					"isEdge": 0,
					"sourceCodeMapping": {
						"filePath": "src/dbg/plugin_loader.cpp",
						"startLine": "647",
						"endLine": "653",
						"relevantVariables": [
							"pluginregistercallback",
							"cbStruct",
							"gPluginCallbackList"
						]
					},
					"inputDataExample": "{\"pluginHandle\": 1, \"cbType\": \"CB_BREAKPOINT\", \"cbPlugin\": \"0x00007FF8B2A112B0\"}",
					"outputDataExample": "{\"status\": \"Callback for CB_BREAKPOINT registered for handle 1\"}"
				},
				{
					"simStepId": "7c61e50d-6ace-4479-a29d-16bc338e2aa1",
					"diagramNodeId": "0f8bf2d1-17b1-4802-8875-98a221eb4b1e",
					"simStepLabel": "Callback Registration Data",
					"simStepDescription": "To register a callback, the plugin's handle, the type of event (`CBTYPE`), and a pointer to the callback function are added to the debugger's central list of plugin callbacks.",
					"isEdge": 1,
					"sourceCodeMapping": {
						"filePath": "src/dbg/_plugins.cpp",
						"startLine": "14",
						"endLine": "17",
						"relevantVariables": [
							"_plugin_registercallback",
							"pluginregistercallback"
						]
					},
					"inputDataExample": "{\"pluginHandle\": 1, \"cbType\": 11, \"cbPlugin\": \"0x00007FF8B2A112B0\"}",
					"outputDataExample": "{\"pluginHandle\": 1, \"cbType\": 11, \"cbPlugin\": \"0x00007FF8B2A112B0\"}"
				},
				{
					"simStepId": "1cff6d4e-8b7f-4a28-90e8-c98849345c96",
					"diagramNodeId": "d114a722-f2f8-4373-8fb2-7fc0a71dd89a",
					"simStepLabel": "Debugger Hits Breakpoint",
					"simStepDescription": "During a debugging session, the debuggee executes an instruction that triggers a breakpoint. The debugger's main event loop catches this event and begins processing it.",
					"isEdge": 0,
					"sourceCodeMapping": {
						"filePath": "src/dbg/debugger.cpp",
						"startLine": "958",
						"endLine": "966",
						"relevantVariables": [
							"cbInstructionBreakpoint",
							"PLUG_CB_BREAKPOINT",
							"bpInfo"
						]
					},
					"inputDataExample": "{\"DebugEvent\": {\"dwDebugEventCode\": \"EXCEPTION_DEBUG_EVENT\", \"Exception\": {\"ExceptionRecord\": {\"ExceptionCode\": \"STATUS_BREAKPOINT\"}}}}",
					"outputDataExample": "{\"breakpoint\": {\"addr\": \"0x7FF6B4AD1337\", \"type\": \"UD2\"}}"
				},
				{
					"simStepId": "7c4493f2-e0f5-41cb-bfea-a789c456f88e",
					"diagramNodeId": "cc90d98a-9cbe-4fa6-aea2-9f1959d03e6d",
					"simStepLabel": "Dispatch Breakpoint Event",
					"simStepDescription": "The debugger's breakpoint handler determines that a plugin callback needs to be invoked. It prepares a `PLUG_CB_BREAKPOINT` structure with details about the event and calls `plugincbcall`.",
					"isEdge": 1,
					"sourceCodeMapping": {
						"filePath": "src/dbg/debugger.cpp",
						"startLine": "967",
						"endLine": "967",
						"relevantVariables": [
							"plugincbcall",
							"CB_BREAKPOINT",
							"bpInfo"
						]
					},
					"inputDataExample": "{\"cbType\": \"CB_BREAKPOINT\", \"callbackInfo\": {\"breakpoint\": {\"addr\": \"0x7FF6B4AD1337\", \"enabled\": true, \"type\": \"UD2\"}}}",
					"outputDataExample": "{\"cbType\": \"CB_BREAKPOINT\", \"callbackInfo\": {\"breakpoint\": {\"addr\": \"0x7FF6B4AD1337\", \"enabled\": true, \"type\": \"UD2\"}}}"
				},
				{
					"simStepId": "88f8bb66-bde7-4559-8328-bc31d190543b",
					"diagramNodeId": "b8964ec8-5a31-42de-86ea-636704f048ca",
					"simStepLabel": "Invoke Registered Callbacks",
					"simStepDescription": "The `plugincbcall` function looks up the list of registered callbacks for the given event type (`CB_BREAKPOINT`). It then iterates through this list and invokes each plugin's registered handler function.",
					"isEdge": 0,
					"sourceCodeMapping": {
						"filePath": "src/dbg/plugin_loader.cpp",
						"startLine": "664",
						"endLine": "678",
						"relevantVariables": [
							"plugincbcall",
							"gPluginCallbackList",
							"cbPlugin"
						]
					},
					"inputDataExample": "{\"cbType\": 11, \"callbackInfo\": {\"breakpoint\": {\"addr\": \"0x7FF6B4AD1337\"}}}",
					"outputDataExample": "{}"
				},
				{
					"simStepId": "909c3fa2-00d3-4c80-bf83-2801001a646f",
					"diagramNodeId": "47023762-c274-47a5-bdfe-e7a2b680c97e",
					"simStepLabel": "Deliver Breakpoint Data to Plugin",
					"simStepDescription": "The `PLUG_CB_BREAKPOINT` data structure, containing the address and other properties of the triggered breakpoint, is passed as an argument to the plugin's callback function.",
					"isEdge": 1,
					"sourceCodeMapping": {
						"filePath": "src/dbg/plugin_loader.cpp",
						"startLine": "672",
						"endLine": "672",
						"relevantVariables": [
							"cbPlugin",
							"cbType",
							"callbackInfo"
						]
					},
					"inputDataExample": "{\"breakpoint\": {\"addr\": \"0x7FF6B4AD1337\", \"enabled\": true, \"type\": \"UD2\", \"name\": \"MyBP\"}}",
					"outputDataExample": "{\"breakpoint\": {\"addr\": \"0x7FF6B4AD1337\", \"enabled\": true, \"type\": \"UD2\", \"name\": \"MyBP\"}}"
				},
				{
					"simStepId": "1c78db3d-6db7-48a8-af8b-c262e763376f",
					"diagramNodeId": "fa626c17-3b7d-4e45-9d27-4cc6d20c2244",
					"simStepLabel": "Plugin Executes Custom Logic",
					"simStepDescription": "The code inside the plugin's callback function is now executed. The plugin can use the provided event data to perform any number of custom actions, such as logging information, modifying registers or memory, adding GUI elements, or automating analysis tasks.",
					"isEdge": 0,
					"sourceCodeMapping": {
						"filePath": "docs/developers/plugins/basics.md",
						"startLine": "26",
						"endLine": "31",
						"relevantVariables": [
							"CBINITDEBUG",
							"CBSTOPDEBUG",
							"CBEXCEPTION",
							"CBDEBUGEVENT",
							"CBMENUENTRY"
						]
					},
					"inputDataExample": "{\"breakpoint\": {\"addr\": \"0x7FF6B4AD1337\", \"enabled\": true, \"type\": \"UD2\", \"name\": \"MyBP\"}}",
					"outputDataExample": "{\"logMessage\": \"Breakpoint 'MyBP' hit at 0x7FF6B4AD1337\"}"
				}
			],
			"description": "<ul><li>A powerful plugin system allows the community to extend the debugger's capabilities for specialized tasks</li><li>- Load and manage third-party or custom-developed plugins</li><li>- Plugins can add new GUI tabs and windows, custom data viewers, and analysis capabilities</li><li>- New commands can be registered by plugins to integrate seamlessly with the scripting engine</li><li>- Plugins can register for callbacks on various debugging events (e</li><li>g</li><li>, breakpoint hit, process creation) to perform custom actions</li></ul>",
			"simulationNodesAndEdges": {
