							"commandParsed",
							"argv",
							"cmd->cbCommand"
						]
					},
					"inputDataExample": "{\"command\": \"run\", \"argcount\": 0}",
					"outputDataExample": "{\"success\": true}"
				}
			],
			"description": "<ul><li>Automation through scripting dramatically speeds up repetitive and complex reverse engineering tasks</li><li>- Execute a wide variety of commands from the command bar at the bottom of the main window</li><li>- Write and run scripts using the debugger's built-in command language to automate analysis</li><li>- Scripts can set breakpoints, read/write memory, check conditions, and log information, creating powerful analysis tools</li><li>- Integrate with external tools by calling them from the command line</li></ul>",
