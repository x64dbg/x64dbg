			]
		},
		"78fefa8a-77e5-4053-a8f8-bf29ddf18af1": {
			"path": "78fefa8a-77e5-4053-a8f8-bf29ddf18af1",
			"cellName": "GUI: User Action Initiates Command - MainWindow.cpp:L1353-1358",
			"cellId": "78fefa8a-77e5-4053-a8f8-bf29ddf18af1",
			"visible": true,
			"parentCellId": "ed21533f-5732-4f5d-8721-37e04a6a471f"
		},
		"src/gui/Src/Gui/MainWindow.cpp-simstep-abcc0ed9-67b8-4218-af5b-c1c2094a969e": {
			"path": "src/gui/Src/Gui/MainWindow.cpp-simstep-abcc0ed9-67b8-4218-af5b-c1c2094a969e",
			"fileName": "MainWindow.cpp",
			"wiki": "A user interaction within the GUI, such as clicking a menu item or a button, triggers a function call that prepares to execute a command. In this example, selecting 'Run' from the debug menu calls the `runSlot` function which then executes the 'run' command.",
			"cellName": "GUI: User Action Initiates Command - MainWindow.cpp:L1353-1358",
			"cellId": "78fefa8a-77e5-4053-a8f8-bf29ddf18af1",
