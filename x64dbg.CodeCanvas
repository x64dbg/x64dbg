			]
		},
		"279c1d9c-df35-4e4c-bf7a-c3d685b15b3b": {
			"path": "279c1d9c-df35-4e4c-bf7a-c3d685b15b3b",
			"cellName": "Hardware Breakpoint: Command Registration - x64dbg.cpp:L171",
			"cellId": "279c1d9c-df35-4e4c-bf7a-c3d685b15b3b",
			"visible": true,
			"parentCellId": "bc840efc-2373-4dda-94f3-4ea3f06f73c9"
		},
		"src/dbg/x64dbg.cpp-simstep-47f9d19d-b518-4577-8ece-462aad663bd3": {
			"path": "src/dbg/x64dbg.cpp-simstep-47f9d19d-b518-4577-8ece-462aad663bd3",
			"fileName": "x64dbg.cpp",
			"wiki": "The debugger registers the `SetHardwareBreakpoint` command (aliases `bph`, `bphws`) and links it to the `cbDebugSetHardwareBreakpoint` callback function during initialization.",
			"cellName": "Hardware Breakpoint: Command Registration - x64dbg.cpp:L171",
			"cellId": "279c1d9c-df35-4e4c-bf7a-c3d685b15b3b",
			"visible": true,
			"startLine": 171,
			"endLine": 171,
			"parentCellId": "bc840efc-2373-4dda-94f3-4ea3f06f73c9",
