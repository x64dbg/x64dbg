		"ed55160f-a8a7-444a-85f3-7b71a1e26b36": {
			"path": "ed55160f-a8a7-444a-85f3-7b71a1e26b36",
			"cellName": "Memory Map Flow: User Initiates Memory Edit - CPUStack.cpp:L892-901",
			"cellId": "ed55160f-a8a7-444a-85f3-7b71a1e26b36",
