					},
					"inputDataExample": "{\"base\": \"0x77000000\", \"size\": 1, \"FullPath\": \"C:\\\\Windows\\\\System32\\\\ntdll.dll\", \"loadSymbols\": true}",
					"outputDataExample": "{\"base\": \"0x77000000\", \"size\": 1, \"FullPath\": \"C:\\\\Windows\\\\System32\\\\ntdll.dll\", \"loadSymbols\": true}"
				},
				{
					"simStepId": "f4f09be9-6c6a-487c-8947-6977ff4de74f",
					"diagramNodeId": "e82cc255-156c-40be-9e09-09efcf306f77",
					"simStepLabel": "[Auto-load] Parse PE Header and Find PDB Info",
					"simStepDescription": "The `ModLoad` function reads the loaded module's PE header to find the debug directory. It then parses the CodeView debug information (CV_INFO_PDB70 structure) to extract the PDB filename, its unique signature (GUID), and age. This information is used to identify and validate the correct symbol file.",
					"isEdge": 0,
					"sourceCodeMapping": {
						"filePath": "src/dbg/module.cpp",
						"startLine": "588",
						"endLine": "665",
						"relevantVariables": [
