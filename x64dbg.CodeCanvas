		},
		"src/dbg/x64dbg.cpp-simstep-d592c91c-8f0d-4210-99c3-d5705be0db2c": {
			"path": "src/dbg/x64dbg.cpp-simstep-d592c91c-8f0d-4210-99c3-d5705be0db2c",
			"fileName": "x64dbg.cpp",
			"wiki": "The debugger registers the `SetMemoryBPX` command (aliases `membp`, `bpm`) and maps it to the `cbDebugSetMemoryBpx` callback for handling memory breakpoint requests.",
			"cellName": "Memory Breakpoint: Command Registration - x64dbg.cpp:L175",
			"cellId": "d25cad8c-fae6-49f9-9c76-8950905bc4c8",
