				}
			]
		},
		"0e225205-f0b3-4e60-bc32-9444a690ec6d": {
			"path": "0e225205-f0b3-4e60-bc32-9444a690ec6d",
			"cellName": "Config Flow: Backend Receives Update and Reads Settings - _exports.cpp:L1101-1103",
			"cellId": "0e225205-f0b3-4e60-bc32-9444a690ec6d",
			"visible": true,
			"parentCellId": "1aca0727-220e-4e86-9f51-5f817495d75b"
		},
		"src/dbg/_exports.cpp-simstep-00d3408e-5903-429b-9c09-d396735bcb05": {
			"path": "src/dbg/_exports.cpp-simstep-00d3408e-5903-429b-9c09-d396735bcb05",
			"fileName": "_exports.cpp",
			"wiki": "The debugger backend's message handler receives the DBG_SETTINGS_UPDATED message. It then calls BridgeSettingGet to read the serialized exception filter string from the configuration.",
			"cellName": "Config Flow: Backend Receives Update and Reads Settings - _exports.cpp:L1101-1103",
			"cellId": "0e225205-f0b3-4e60-bc32-9444a690ec6d",
