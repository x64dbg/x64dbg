		"4c30affa-9710-4196-a33d-61639814a2c7": {
			"path": "4c30affa-9710-4196-a33d-61639814a2c7",
			"cellName": "[Manual-download] Prepare Download URL and Cache Path - symbolinfo.cpp:L206-290",
			"cellId": "4c30affa-9710-4196-a33d-61639814a2c7",
