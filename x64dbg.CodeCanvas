					"simulationKey": "Binary Patching and In-Memory Modification",
					"simStepId": "f12d75be-9e3d-4205-9ea0-24222da97009"
				}
			]
		},
		"1820918c-48e6-4b34-8a8f-f05bda7d0397": {
			"path": "1820918c-48e6-4b34-8a8f-f05bda7d0397",
			"cellName": "Memory is Modified and UI is Refreshed - bridgemain.cpp:L532-547",
