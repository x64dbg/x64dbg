		},
		"fb7f6990-088d-4f5d-b489-ea0c87306ffc": {
			"path": "fb7f6990-088d-4f5d-b489-ea0c87306ffc",
			"cellName": "Stack Flow: Update Stack View on Pause - CPUStack.cpp:L563-570",
			"cellId": "fb7f6990-088d-4f5d-b489-ea0c87306ffc",
