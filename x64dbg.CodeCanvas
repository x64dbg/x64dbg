					"outputDataExample": "{\"pdbPath\": \"C:\\\\symbols\\\\ntdll.pdb\\\\A427C13595224527941D32F49BB3A2F11\\\\ntdll.pdb\", \"forceLoad\": false}"
				},
				{
					"simStepId": "bbfea96f-f356-4a38-9a67-c629762e0756",
