		"ea88f3fc-316f-45ef-b1c6-5310f7c82ea6": {
			"path": "ea88f3fc-316f-45ef-b1c6-5310f7c82ea6",
			"cellName": "[Auto-load] Module Loading Detected - debugger.cpp:L1844",
			"cellId": "ea88f3fc-316f-45ef-b1c6-5310f7c82ea6",
			"visible": true,
			"parentCellId": "abf8f82a-7554-4436-b28a-1a87bbf5d7c0"
		},
		"src/dbg/debugger.cpp-simstep-4795ab07-0889-4e0e-b416-0ed2b4aa1abc": {
			"path": "src/dbg/debugger.cpp-simstep-4795ab07-0889-4e0e-b416-0ed2b4aa1abc",
			"fileName": "debugger.cpp",
			"wiki": "The debugger engine detects that a new module (DLL) has been loaded into the debugged process. This triggers the `cbLoadDll` callback function, which is the entry point for processing the new module and attempting to load its symbols.",
			"cellName": "[Auto-load] Module Loading Detected - debugger.cpp:L1844",
			"cellId": "ea88f3fc-316f-45ef-b1c6-5310f7c82ea6",
			"visible": true,
			"startLine": 1844,
			"endLine": 1844,
			"parentCellId": "abf8f82a-7554-4436-b28a-1a87bbf5d7c0",
			"parentPath": "src/dbg/debugger.cpp",
			"simSteps": [
				{
					"simulationKey": "Symbol and Module Management",
					"simStepId": "4795ab07-0889-4e0e-b416-0ed2b4aa1abc"
				}
			]
		},
		"e82cc255-156c-40be-9e09-09efcf306f77": {
			"path": "e82cc255-156c-40be-9e09-09efcf306f77",
			"cellName": "[Auto-load] Parse PE Header and Find PDB Info - module.cpp:L588-665",
			"cellId": "e82cc255-156c-40be-9e09-09efcf306f77",
			"visible": true,
			"parentCellId": "f068423f-825e-49db-ab3f-9988853535ef"
		},
		"src/dbg/module.cpp-simstep-f4f09be9-6c6a-487c-8947-6977ff4de74f": {
			"path": "src/dbg/module.cpp-simstep-f4f09be9-6c6a-487c-8947-6977ff4de74f",
			"fileName": "module.cpp",
			"wiki": "The `ModLoad` function reads the loaded module's PE header to find the debug directory. It then parses the CodeView debug information (CV_INFO_PDB70 structure) to extract the PDB filename, its unique signature (GUID), and age. This information is used to identify and validate the correct symbol file.",
			"cellName": "[Auto-load] Parse PE Header and Find PDB Info - module.cpp:L588-665",
			"cellId": "e82cc255-156c-40be-9e09-09efcf306f77",
			"visible": true,
			"startLine": 588,
			"endLine": 665,
			"parentCellId": "f068423f-825e-49db-ab3f-9988853535ef",
			"parentPath": "src/dbg/module.cpp",
			"simSteps": [
				{
					"simulationKey": "Symbol and Module Management",
					"simStepId": "f4f09be9-6c6a-487c-8947-6977ff4de74f"
				}
			]
		},
		"b1d1b96c-b6a2-4d27-90a0-ae09de736c4c": {
			"path": "b1d1b96c-b6a2-4d27-90a0-ae09de736c4c",
			"cellName": "[Auto-load] Attempt to Load Symbols - module.cpp:L968-971",
			"cellId": "b1d1b96c-b6a2-4d27-90a0-ae09de736c4c",
			"visible": true,
			"parentCellId": "f068423f-825e-49db-ab3f-9988853535ef"
		},
		"src/dbg/module.cpp-simstep-4b7a6ba2-c871-433a-bf4c-9e7facb3f2d8": {
			"path": "src/dbg/module.cpp-simstep-4b7a6ba2-c871-433a-bf4c-9e7facb3f2d8",
			"fileName": "module.cpp",
			"wiki": "Inside `ModLoad`, the code iterates through the list of potential PDB file locations and calls the `MODINFO::loadSymbols` method for each path, stopping once the symbols are successfully loaded.",
			"cellName": "[Auto-load] Attempt to Load Symbols - module.cpp:L968-971",
			"cellId": "b1d1b96c-b6a2-4d27-90a0-ae09de736c4c",
