		"Scripting and Automation via Commands": {
			"name": "Scripting and Automation via Commands",
			"simSteps": [
				{
					"simStepId": "d51b3c69-dbb7-4b1b-af24-959adccefbaa",
					"diagramNodeId": "b1d82962-10f0-45b8-96b6-d830462ccf27",
					"simStepLabel": "GUI: User Action Initiates Command",
					"simStepDescription": "A user interaction within the GUI, such as clicking a menu item or a button, triggers a function call that prepares to execute a command. In this example, selecting 'Run' from the debug menu calls the `runSlot` function.",
					"isEdge": 0,
					"sourceCodeMapping": {
						"filePath": "src/gui/Src/Gui/MainWindow.cpp",
						"startLine": "1353",
						"endLine": "1358",
						"relevantVariables": [
