		"Symbol and Module Management": {
			"name": "Symbol and Module Management",
			"simSteps": [
				{
					"simStepId": "4795ab07-0889-4e0e-b416-0ed2b4aa1abc",
					"diagramNodeId": "ea88f3fc-316f-45ef-b1c6-5310f7c82ea6",
					"simStepLabel": "[Auto-load] Module Loading Detected",
					"simStepDescription": "The debugger engine detects that a new module (DLL) has been loaded into the debugged process. This triggers the `cbLoadDll` callback function, which is the entry point for processing the new module and attempting to load its symbols.",
					"isEdge": 0,
					"sourceCodeMapping": {
						"filePath": "src/dbg/debugger.cpp",
						"startLine": "1844",
						"endLine": "1844",
						"relevantVariables": [
							"cbLoadDll",
							"base",
							"DLLDebugFileName",
							"ModLoad"
						]
					},
					"inputDataExample": "{\"DebugEvent\": {\"dwDebugEventCode\": \"LOAD_DLL_DEBUG_EVENT\", \"dwProcessId\": 1234, \"dwThreadId\": 5678, \"u\": {\"LoadDll\": {\"lpBaseOfDll\": \"0x77000000\", \"lpImageName\": \"...\", \"fUnicode\": 1}}}}",
					"outputDataExample": "{\"base\": \"0x77000000\", \"size\": 1, \"DLLDebugFileName\": \"C:\\\\Windows\\\\System32\\\\ntdll.dll\"}"
				},
				{
					"simStepId": "5802aa0c-5f5c-4a7c-89d3-eef1c7aec7c4",
					"diagramNodeId": "c17bb321-381d-4584-9d29-9f7638a26ca6",
					"simStepLabel": "[Auto-load] Pass Module Info to ModLoad",
					"simStepDescription": "The base address and path of the newly loaded module are passed to the `ModLoad` function to begin analysis and symbol loading.",
					"isEdge": 1,
					"sourceCodeMapping": {
						"filePath": "src/dbg/debugger.cpp",
						"startLine": "1844",
						"endLine": "1844",
						"relevantVariables": [
