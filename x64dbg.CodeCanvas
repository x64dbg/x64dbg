			]
		},
		"b842b705-bbb1-4ac9-89af-e3ba5f7852b6": {
			"path": "b842b705-bbb1-4ac9-89af-e3ba5f7852b6",
			"cellName": "Code Visualization: Bridge Handles Disassembly Request - bridgemain.cpp:L1149-1152",
			"cellId": "b842b705-bbb1-4ac9-89af-e3ba5f7852b6",
			"visible": true,
			"parentCellId": "c68504b2-9bf3-445f-9bb1-6f5a0254ebff"
		},
		"src/bridge/bridgemain.cpp-simstep-70ce2c08-d15d-4d7b-9427-3fbdf57fdf65": {
			"path": "src/bridge/bridgemain.cpp-simstep-70ce2c08-d15d-4d7b-9427-3fbdf57fdf65",
			"fileName": "bridgemain.cpp",
			"wiki": "The DbgDisasmAt function in the bridge layer receives the request from the GUI. It acts as an intermediary, sending a message (DBG_DISASM_AT) to the main debugger engine to perform the actual disassembly.",
			"cellName": "Code Visualization: Bridge Handles Disassembly Request - bridgemain.cpp:L1149-1152",
			"cellId": "b842b705-bbb1-4ac9-89af-e3ba5f7852b6",
