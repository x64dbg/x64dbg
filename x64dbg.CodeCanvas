		"src/gui/Src/Gui/DisassemblerGraphView.cpp-simstep-983b4687-dac1-4fab-80a9-36e7f89874df": {
			"path": "src/gui/Src/Gui/DisassemblerGraphView.cpp-simstep-983b4687-dac1-4fab-80a9-36e7f89874df",
			"fileName": "DisassemblerGraphView.cpp",
			"wiki": "The DisassemblerGraphView uses the disassembly data to construct the visual representation of the function. The renderFunction computes the layout of basic blocks and edges, and the paintEvent handles the final drawing on the screen.",
			"cellName": "Code Visualization: GUI Renders the Control Flow Graph - DisassemblerGraphView.cpp:L1545-1549",
			"cellId": "031ac155-af3f-4494-99b3-13bb6aebc694",
