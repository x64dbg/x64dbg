		"61cfaeb0-7858-4548-b6a9-cc2b6e16698a": {
			"path": "61cfaeb0-7858-4548-b6a9-cc2b6e16698a",
			"cellName": "Memory Map Flow: Render Memory Regions - MemoryMapView.cpp:L476-477",
			"cellId": "61cfaeb0-7858-4548-b6a9-cc2b6e16698a",
			"visible": true,
			"parentCellId": "50c9e9f1-9d0e-4fff-90f7-dc6fc6140bca"
		},
		"src/gui/Src/Gui/MemoryMapView.cpp-simstep-77173b87-fd5c-4ffc-a429-f6320819aafd": {
			"path": "src/gui/Src/Gui/MemoryMapView.cpp-simstep-77173b87-fd5c-4ffc-a429-f6320819aafd",
			"fileName": "MemoryMapView.cpp",
			"wiki": "The `MemoryMapView` receives the populated `MEMMAP` structure and uses the data to render the table of memory regions, showing their base addresses, sizes, permissions, and other information.",
			"cellName": "Memory Map Flow: Render Memory Regions - MemoryMapView.cpp:L476-477",
