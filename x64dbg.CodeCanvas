		"89392fe4-0a2a-4520-8b46-1ee66982f03b": {
			"path": "89392fe4-0a2a-4520-8b46-1ee66982f03b",
			"cellName": "Software Breakpoint: Command Registration - x64dbg.cpp:L167",
			"cellId": "89392fe4-0a2a-4520-8b46-1ee66982f03b",
			"visible": true,
			"parentCellId": "bc840efc-2373-4dda-94f3-4ea3f06f73c9"
		},
		"src/dbg/x64dbg.cpp-simstep-742542f7-e7a5-44f7-9293-8e3a368ef7fb": {
			"path": "src/dbg/x64dbg.cpp-simstep-742542f7-e7a5-44f7-9293-8e3a368ef7fb",
			"fileName": "x64dbg.cpp",
			"wiki": "At application startup, the debugger registers the 'SetBPX' command (with aliases 'bp', 'bpx') and associates it with the `cbDebugSetBPX` callback function. This sets up the command handling for software breakpoints.",
			"cellName": "Software Breakpoint: Command Registration - x64dbg.cpp:L167",
			"cellId": "89392fe4-0a2a-4520-8b46-1ee66982f03b",
			"visible": true,
			"startLine": 167,
			"endLine": 167,
			"parentCellId": "bc840efc-2373-4dda-94f3-4ea3f06f73c9",
			"parentPath": "src/dbg/x64dbg.cpp",
			"simSteps": [
				{
					"simulationKey": "Advanced Breakpoint Management",
					"simStepId": "742542f7-e7a5-44f7-9293-8e3a368ef7fb"
				}
			]
		},
		"29b6611a-5a8a-4bd2-9e49-0557ce72499a": {
			"path": "29b6611a-5a8a-4bd2-9e49-0557ce72499a",
			"cellName": "Software Breakpoint: Command Handling - cmd-breakpoint-control.cpp:L105-151",
			"cellId": "29b6611a-5a8a-4bd2-9e49-0557ce72499a",
			"visible": true,
			"parentCellId": "ba99272b-eb91-4c4f-a611-d18a633ce338"
		},
		"src/dbg/commands/cmd-breakpoint-control.cpp-simstep-ce1f9fb6-b89f-4148-ac2c-0aacc7137000": {
			"path": "src/dbg/commands/cmd-breakpoint-control.cpp-simstep-ce1f9fb6-b89f-4148-ac2c-0aacc7137000",
			"fileName": "cmd-breakpoint-control.cpp",
			"wiki": "The registered callback `cbDebugSetBPX` is executed. It parses the command arguments (address and name), reads the original bytes at the target address, creates an internal data structure for the breakpoint, and then calls the debugging engine to place the physical breakpoint.",
			"cellName": "Software Breakpoint: Command Handling - cmd-breakpoint-control.cpp:L105-151",
			"cellId": "29b6611a-5a8a-4bd2-9e49-0557ce72499a",
			"visible": true,
			"startLine": 105,
			"endLine": 151,
			"parentCellId": "ba99272b-eb91-4c4f-a611-d18a633ce338",
			"parentPath": "src/dbg/commands/cmd-breakpoint-control.cpp",
			"simSteps": [
				{
					"simulationKey": "Advanced Breakpoint Management",
					"simStepId": "ce1f9fb6-b89f-4148-ac2c-0aacc7137000"
				}
			]
		},
		"0afaab41-5a89-442a-8eaa-2a9d34927c03": {
			"path": "0afaab41-5a89-442a-8eaa-2a9d34927c03",
			"cellName": "Software Breakpoint: Store Metadata - breakpoint.cpp:L105-170",
			"cellId": "0afaab41-5a89-442a-8eaa-2a9d34927c03",
			"visible": true,
			"parentCellId": "04b9d7e9-ebbe-482e-88d4-73f824f2c04b"
		},
		"src/dbg/breakpoint.cpp-simstep-10099a29-5677-496c-bb58-f5164e0cb444": {
			"path": "src/dbg/breakpoint.cpp-simstep-10099a29-5677-496c-bb58-f5164e0cb444",
			"fileName": "breakpoint.cpp",
			"wiki": "The `BpNew` function creates a `BREAKPOINT` structure, populates it with details like address, type, and name, and adds it to a global map that tracks all active breakpoints.",
			"cellName": "Software Breakpoint: Store Metadata - breakpoint.cpp:L105-170",
			"cellId": "0afaab41-5a89-442a-8eaa-2a9d34927c03",
			"visible": true,
			"startLine": 105,
			"endLine": 170,
			"parentCellId": "04b9d7e9-ebbe-482e-88d4-73f824f2c04b",
			"parentPath": "src/dbg/breakpoint.cpp",
			"simSteps": [
				{
					"simulationKey": "Advanced Breakpoint Management",
					"simStepId": "10099a29-5677-496c-bb58-f5164e0cb444"
				}
			]
		},
		"ac0c0dcc-d2af-4942-a673-fa7ccf6f2d15": {
			"path": "ac0c0dcc-d2af-4942-a673-fa7ccf6f2d15",
			"cellName": "Software Breakpoint: Write INT3 Instruction - cmd-breakpoint-control.cpp:L140-145",
			"cellId": "ac0c0dcc-d2af-4942-a673-fa7ccf6f2d15",
			"visible": true,
			"parentCellId": "ba99272b-eb91-4c4f-a611-d18a633ce338"
		},
		"src/dbg/commands/cmd-breakpoint-control.cpp-simstep-ffceb9d9-ad5f-4a9f-98e9-7e12a8bc3e8f": {
			"path": "src/dbg/commands/cmd-breakpoint-control.cpp-simstep-ffceb9d9-ad5f-4a9f-98e9-7e12a8bc3e8f",
			"fileName": "cmd-breakpoint-control.cpp",
			"wiki": "The `SetBPX` function writes a `0xCC` (INT3) byte at the specified address in the debugged process's memory. When the CPU executes this instruction, it triggers an exception that pauses the process and transfers control to the debugger.",
			"cellName": "Software Breakpoint: Write INT3 Instruction - cmd-breakpoint-control.cpp:L140-145",
			"cellId": "ac0c0dcc-d2af-4942-a673-fa7ccf6f2d15",
			"visible": true,
			"startLine": 140,
			"endLine": 145,
			"parentCellId": "ba99272b-eb91-4c4f-a611-d18a633ce338",
			"parentPath": "src/dbg/commands/cmd-breakpoint-control.cpp",
			"simSteps": [
				{
					"simulationKey": "Advanced Breakpoint Management",
					"simStepId": "ffceb9d9-ad5f-4a9f-98e9-7e12a8bc3e8f"
				}
			]
		},
		"53cb0c62-1d24-4db6-b3d6-b2b195fc49f2": {
			"path": "53cb0c62-1d24-4db6-b3d6-b2b195fc49f2",
			"cellName": "Software Breakpoint: Refresh UI - BreakpointsView.cpp:L212-265",
			"cellId": "53cb0c62-1d24-4db6-b3d6-b2b195fc49f2",
			"visible": true,
			"parentCellId": "584bba2c-1e2a-420d-9fbe-83f091c78e06"
		},
		"src/gui/Src/Gui/BreakpointsView.cpp-simstep-843d21ed-6be5-42ca-a450-8b900e814454": {
			"path": "src/gui/Src/Gui/BreakpointsView.cpp-simstep-843d21ed-6be5-42ca-a450-8b900e814454",
			"fileName": "BreakpointsView.cpp",
			"wiki": "The `BreakpointsView` widget handles the update signal by fetching the latest list of breakpoints and repainting its view, making the new breakpoint visible to the user.",
			"cellName": "Software Breakpoint: Refresh UI - BreakpointsView.cpp:L212-265",
			"cellId": "53cb0c62-1d24-4db6-b3d6-b2b195fc49f2",
