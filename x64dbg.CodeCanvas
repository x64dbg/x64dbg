		"3a154fc7-aabe-4b92-bb52-ba8280d633ad": {
			"path": "3a154fc7-aabe-4b92-bb52-ba8280d633ad",
			"cellName": "Trace Viewing: File Parsing and Display - TraceFileReader.cpp:L26-33",
			"cellId": "3a154fc7-aabe-4b92-bb52-ba8280d633ad",
			"visible": true,
			"parentCellId": "13a09bf8-e588-4022-9e3a-e3351e738394"
