		"Memory and State Inspection and Editing": {
			"name": "Memory and State Inspection and Editing",
			"simSteps": [
				{
					"simStepId": "9172b2a8-bca0-4f0c-802f-77a2e360a2f3",
					"diagramNodeId": "aff14f86-4f1d-4860-972a-bec59831afa6",
					"simStepLabel": "Memory Map Flow: Display Memory Map",
					"simStepDescription": "When the debugger is paused, the Memory Map view is updated. The `refreshMapSlot` function is called, which initiates the process of fetching the memory layout of the debugged application.",
					"isEdge": 0,
					"sourceCodeMapping": {
						"filePath": "src/gui/Src/Gui/MemoryMapView.cpp",
						"startLine": "473",
						"endLine": "475",
						"relevantVariables": [
							"refreshMapSlot",
							"memoryMap",
							"DbgMemMap"
						]
					},
					"inputDataExample": "{\"debug_state\": \"paused\"}",
					"outputDataExample": "{\"request\": \"DbgMemMap\"}"
				},
				{
					"simStepId": "c109d63b-14f0-48eb-8164-5f81edd20db9",
					"diagramNodeId": "b7e97f7f-f417-40a4-8df0-f42962b2f84e",
					"simStepLabel": "Memory Map Flow: Fetch Memory Map Data",
					"simStepDescription": "The `DbgMemMap` function is called to query the debugger core for the list of memory regions in the target process. The core populates a `MEMMAP` structure with this information.",
					"isEdge": 1,
					"sourceCodeMapping": {
						"filePath": "src/gui/Src/Gui/MemoryMapView.cpp",
						"startLine": "474",
						"endLine": "474",
						"relevantVariables": [
							"DbgMemMap",
							"memoryMap"
						]
					},
					"inputDataExample": "{\"map_entries_pointer\": \"&memoryMap\"}",
					"outputDataExample": "{\"map_entries_pointer\": \"&memoryMap\", \"data\": [{\"base\": \"0x00400000\", \"size\": \"0x1000\", \"protection\": \"RWX\", \"info\": \"main_module\"}, {\"base\": \"0x7C800000\", \"size\": \"0x100000\", \"protection\": \"R-X\", \"info\": \"kernel32.dll\"}]}"
				},
				{
					"simStepId": "77173b87-fd5c-4ffc-a429-f6320819aafd",
					"diagramNodeId": "61cfaeb0-7858-4548-b6a9-cc2b6e16698a",
					"simStepLabel": "Memory Map Flow: Render Memory Regions",
					"simStepDescription": "The `MemoryMapView` receives the populated `MEMMAP` structure and uses the data to render the table of memory regions, showing their base addresses, sizes, permissions, and other information.",
					"isEdge": 0,
					"sourceCodeMapping": {
						"filePath": "src/gui/Src/Gui/MemoryMapView.cpp",
						"startLine": "476",
						"endLine": "477",
						"relevantVariables": [
							"reloadData",
							"fixSelectionRangeSlot"
						]
					},
					"inputDataExample": "{\"data\": [{\"base\": \"0x00400000\", \"size\": \"0x1000\", \"protection\": \"RWX\", \"info\": \"main_module\"}, {\"base\": \"0x7C800000\", \"size\": \"0x100000\", \"protection\": \"R-X\", \"info\": \"kernel32.dll\"}]}",
					"outputDataExample": "{\"ui_state\": \"memory_map_displayed\"}"
				},
				{
					"simStepId": "48d2e5eb-bb32-4574-a14e-fe0de5146d29",
					"diagramNodeId": "99b16914-5fc2-4e3b-8c26-835e659a878e",
					"simStepLabel": "Memory Map Flow: User Selects Memory Region",
					"simStepDescription": "A user interested in a specific memory region (e.g., the main executable's code section) double-clicks on the corresponding row in the Memory Map view to inspect it.",
					"isEdge": 1,
					"sourceCodeMapping": {
						"filePath": "src/gui/Src/Gui/MemoryMapView.cpp",
						"startLine": "607",
						"endLine": "607",
						"relevantVariables": [
							"doubleClickedSlot"
						]
					},
					"inputDataExample": "{\"user_action\": \"double_click\", \"selected_row\": {\"address\": \"0x00401000\"}}",
					"outputDataExample": "{\"user_action\": \"double_click\", \"selected_row\": {\"address\": \"0x00401000\"}}"
				},
				{
					"simStepId": "087b8105-db4a-4b92-889f-e04988846347",
					"diagramNodeId": "374bdb70-ade6-4bdc-8115-bc1cf9a4d1a8",
					"simStepLabel": "Memory Map Flow: Handle Memory Inspection Request",
					"simStepDescription": "The `doubleClickedSlot` function handles the user's action by constructing and executing a `dump` command, which instructs the debugger to open the selected address in a hex dump view.",
					"isEdge": 0,
					"sourceCodeMapping": {
						"filePath": "src/gui/Src/Gui/MemoryMapView.cpp",
						"startLine": "608",
						"endLine": "608",
						"relevantVariables": [
							"DbgCmdExecDirect",
							"getSelectionText"
						]
					},
					"inputDataExample": "{\"selected_address_text\": \"00401000\"}",
					"outputDataExample": "{\"command\": \"dump 00401000\"}"
				},
				{
					"simStepId": "7a063358-7653-4814-87c8-fd8240ef0215",
					"diagramNodeId": "6f27ca8e-8c3b-46c0-b5c2-d139a85ded06",
					"simStepLabel": "Memory Map Flow: Open Hex Dump and Request Data",
					"simStepDescription": "The `dump` command opens a `CPUDump` view. To display its content, the view requests to read a chunk of memory from the target address by calling the `DbgMemRead` bridge function.",
					"isEdge": 1,
					"sourceCodeMapping": {
						"filePath": "src/gui/Src/Memory/MemoryPage.cpp",
						"startLine": "10",
						"endLine": "13",
						"relevantVariables": [
							"MemoryPage::read",
							"DbgMemRead"
						]
					},
					"inputDataExample": "{\"address\": \"0x00401000\", \"size\": 256}",
					"outputDataExample": "{\"address\": \"0x00401000\", \"size\": 256}"
				},
				{
					"simStepId": "b97167e8-06e2-426a-95fe-e8a58ea36b52",
					"diagramNodeId": "bae7d0b8-acd4-4274-b94d-016afb937d83",
					"simStepLabel": "Memory Map Flow: Read Memory from Target Process",
					"simStepDescription": "The `DbgMemRead` function in the bridge layer receives the request. It communicates with the debugger core to read the specified number of bytes from the debugged process's memory.",
					"isEdge": 0,
					"sourceCodeMapping": {
						"filePath": "src/bridge/bridgemain.cpp",
						"startLine": "511",
						"endLine": "522",
						"relevantVariables": [
							"DbgMemRead",
							"va",
							"dest",
							"size"
						]
					},
					"inputDataExample": "{\"va\": \"0x00401000\", \"dest\": \"0x... (buffer address)\", \"size\": 256}",
					"outputDataExample": "{\"success\": true, \"bytes_read\": 256}"
				},
				{
					"simStepId": "1c046f6e-7438-41bd-bfd0-e0446b3a3c98",
					"diagramNodeId": "eca76740-a6d2-4720-ba7c-abbada04a474",
					"simStepLabel": "Memory Map Flow: Return Raw Memory Data",
					"simStepDescription": "The raw memory bytes read from the target process are returned through the bridge to the `CPUDump` view.",
					"isEdge": 1,
					"sourceCodeMapping": {
						"filePath": "src/gui/Src/Gui/CPUDump.cpp",
						"startLine": "393",
						"endLine": "394",
						"relevantVariables": [
							"DbgMemRead"
						]
					},
					"inputDataExample": "{\"bytes\": \"4D 5A 90 00 03 00 00 00 04 00 00 00 FF FF 00 00...\"}",
					"outputDataExample": "{\"bytes\": \"4D 5A 90 00 03 00 00 00 04 00 00 00 FF FF 00 00...\"}"
				},
				{
					"simStepId": "5bbce1cf-764f-4513-bf53-a62eb3329a3b",
					"diagramNodeId": "ed55160f-a8a7-444a-85f3-7b71a1e26b36",
					"simStepLabel": "Memory Map Flow: User Initiates Memory Edit",
					"simStepDescription": "After inspecting the memory, the user decides to alter a value. They right-click in the `CPUStack` view and select 'Modify', which brings up a dialog to enter the new value.",
					"isEdge": 0,
					"sourceCodeMapping": {
						"filePath": "src/gui/Src/Gui/CPUStack.cpp",
						"startLine": "892",
						"endLine": "901",
						"relevantVariables": [
							"modifySlot",
							"WordEditDialog",
							"getInitialSelection"
						]
					},
					"inputDataExample": "{\"user_action\": \"right_click_modify\", \"address\": \"0x0019FF00\", \"current_value\": \"0x7C816FD7\"}",
					"outputDataExample": "{\"new_value\": \"0xDEADBEEF\"}"
				},
				{
					"simStepId": "2e134612-f508-4e80-9a06-1f96acd97150",
					"diagramNodeId": "420c4afb-4deb-4768-881a-451a159a45a9",
					"simStepLabel": "Memory Map Flow: Call Memory Write Function",
					"simStepDescription": "Once the user confirms the new value, the `modifySlot` function calls `mMemPage->write`, passing the target address and the new data to be written.",
					"isEdge": 1,
					"sourceCodeMapping": {
						"filePath": "src/gui/Src/Gui/CPUStack.cpp",
						"startLine": "904",
						"endLine": "904",
						"relevantVariables": [
							"mMemPage",
							"write",
							"value",
							"addr"
						]
					},
					"inputDataExample": "{\"address\": \"0x0019FF00\", \"value\": \"0xDEADBEEF\"}",
					"outputDataExample": "{\"address\": \"0x0019FF00\", \"value\": \"0xDEADBEEF\"}"
				},
				{
					"simStepId": "4542eaed-33a0-4b35-b5d2-31d945e6eb3a",
					"diagramNodeId": "8158e3f0-1cd4-4af4-a4a8-806d36f7af07",
					"simStepLabel": "Memory Map Flow: Write Memory to Target Process",
					"simStepDescription": "The `mMemPage->write` call propagates to the `DbgMemWrite` bridge function. This function interfaces with the debugger core to write the new byte sequence into the target process's memory space.",
					"isEdge": 0,
					"sourceCodeMapping": {
						"filePath": "src/bridge/bridgemain.cpp",
						"startLine": "532",
						"endLine": "543",
						"relevantVariables": [
							"DbgMemWrite",
							"va",
							"src",
							"size"
						]
					},
					"inputDataExample": "{\"va\": \"0x0019FF00\", \"src\": \"&0xDEADBEEF\", \"size\": 4}",
					"outputDataExample": "{\"success\": true, \"bytes_written\": 4}"
				},
				{
					"simStepId": "5dc89a01-7b37-4cd2-9503-d0dcbc6029b6",
					"diagramNodeId": "f123e61c-9eb3-42e8-95ef-a38827cda027",
					"simStepLabel": "Memory Map Flow: Trigger UI Refresh",
					"simStepDescription": "After successfully writing the memory, `GuiUpdateAllViews()` is called. This broadcasts a signal to all relevant UI components, including the hex dump and stack views, to refresh their content and reflect the change.",
					"isEdge": 1,
					"sourceCodeMapping": {
						"filePath": "src/gui/Src/Gui/CPUStack.cpp",
						"startLine": "905",
						"endLine": "905",
						"relevantVariables": [
							"GuiUpdateAllViews"
						]
					},
					"inputDataExample": "{\"event\": \"GuiUpdateAllViews\"}",
					"outputDataExample": "{\"event\": \"GuiUpdateAllViews\"}"
				},
				{
					"simStepId": "078083eb-822d-4a38-82f4-697fc99396e1",
					"diagramNodeId": "fb7f6990-088d-4f5d-b489-ea0c87306ffc",
					"simStepLabel": "Stack Flow: Update Stack View on Pause",
					"simStepDescription": "When the debugger pauses execution, the `CPUStack` view is automatically updated to reflect the current state of the stack. The `stackDumpAt` function is called with the current stack pointer's address (`csp`).",
					"isEdge": 0,
					"sourceCodeMapping": {
						"filePath": "src/gui/Src/Gui/CPUStack.cpp",
						"startLine": "563",
						"endLine": "570",
						"relevantVariables": [
							"stackDumpAt",
							"addr",
							"csp"
						]
					},
					"inputDataExample": "{\"debug_state\": \"paused\", \"registers\": {\"csp\": \"0x0019FF00\"}}",
					"outputDataExample": "{\"request\": \"render_stack\", \"address\": \"0x0019FF00\"}"
				},
				{
					"simStepId": "6acc975e-3be6-4ba3-9f8d-4f684dbf4a06",
					"diagramNodeId": "d6c9c6d7-0fd1-4e06-a68c-12e57d0ab6b3",
					"simStepLabel": "Stack Flow: Request Stack Memory for Rendering",
					"simStepDescription": "To display the stack's contents, the `CPUStack` view needs to read from the target process's memory. During rendering, it calls `DbgMemRead` to fetch the raw bytes from the stack region.",
					"isEdge": 1,
					"sourceCodeMapping": {
						"filePath": "src/gui/Src/Memory/MemoryPage.cpp",
						"startLine": "10",
						"endLine": "13",
						"relevantVariables": [
							"MemoryPage::read",
							"DbgMemRead"
						]
					},
					"inputDataExample": "{\"address\": \"0x0019FF00\", \"size\": 256}",
					"outputDataExample": "{\"address\": \"0x0019FF00\", \"size\": 256}"
				},
				{
					"simStepId": "00b73c8f-d4fe-4e87-afe1-8c3720c17361",
					"diagramNodeId": "338ad0e1-9ef4-4da8-ac30-dd5f1f2467ef",
					"simStepLabel": "Stack Flow: Interpret and Display Stack Contents",
					"simStepDescription": "The `getColumnRichText` function processes the raw stack bytes. It interprets each value, checking if it is a pointer to code or data, resolving symbols, identifying stack frame boundaries, and formatting the output for a rich, user-friendly display.",
					"isEdge": 0,
					"sourceCodeMapping": {
						"filePath": "src/gui/Src/Gui/CPUStack.cpp",
						"startLine": "316",
						"endLine": "371",
						"relevantVariables": [
							"getColumnRichText",
							"va",
							"richText",
							"DbgGetLabelAt"
						]
					},
					"inputDataExample": "{\"raw_stack_data\": \"D7 6F 81 7C 00 F0 19 00...\"}",
					"outputDataExample": "{\"formatted_row\": {\"address\": \"0x0019FF00\", \"value\": \"0x7C816FD7\", \"comment\": \"Return to kernel32.BaseThreadInitThunk+12\"}}"
				},
				{
					"simStepId": "a85c03f9-0dc7-444c-8ccd-0935c2f8e84a",
					"diagramNodeId": "8cdfabfc-7c5b-4875-b2d3-e3708a0985e3",
					"simStepLabel": "Stack Flow: User Follows a Pointer",
					"simStepDescription": "The user double-clicks on a stack entry that contains a pointer to another location in memory, triggering the `mouseDoubleClickEvent`.",
					"isEdge": 1,
					"sourceCodeMapping": {
						"filePath": "src/gui/Src/Gui/CPUStack.cpp",
						"startLine": "484",
						"endLine": "490",
						"relevantVariables": [
							"mouseDoubleClickEvent"
						]
					},
					"inputDataExample": "{\"user_action\": \"double_click\", \"stack_address\": \"0x0019FEF8\", \"pointer_value\": \"0x00403000\"}",
					"outputDataExample": "{\"user_action\": \"double_click\", \"stack_address\": \"0x0019FEF8\", \"pointer_value\": \"0x00403000\"}"
				},
				{
					"simStepId": "caef6f25-30be-447e-acd5-fd4092db106d",
					"diagramNodeId": "48c8699e-d899-4b6a-b39c-d942ebbad929",
					"simStepLabel": "Stack Flow: Read Pointer Value from Stack",
					"simStepDescription": "The event handler calls `followDisasmSlot`, which first reads the pointer's value from the selected stack address to confirm it's a valid address to navigate to.",
					"isEdge": 0,
					"sourceCodeMapping": {
						"filePath": "src/gui/Src/Gui/CPUStack.cpp",
						"startLine": "752",
						"endLine": "755",
						"relevantVariables": [
							"followDisasmSlot",
							"selectedData",
							"mMemPage->read",
							"DbgMemIsValidReadPtr"
						]
					},
					"inputDataExample": "{\"address_to_read\": \"0x0019FEF8\", \"size\": 4}",
					"outputDataExample": "{\"read_value\": \"0x00403000\"}"
				},
				{
					"simStepId": "a4ca7d9b-16ff-4b8b-8537-04774939e9a6",
					"diagramNodeId": "",
					"simStepLabel": "Stack Flow: Navigate to Pointer Address",
					"simStepDescription": "After validating the pointer, the `followDisasmSlot` function executes a `disasm` command, instructing the Disassembly view to navigate to and display the code at the pointer's target address.",
					"isEdge": 1,
					"sourceCodeMapping": {
						"filePath": "src/gui/Src/Gui/CPUStack.cpp",
						"startLine": "760",
						"endLine": "762",
						"relevantVariables": [
							"DbgCmdExec",
							"addrText"
						]
					},
					"inputDataExample": "{\"command\": \"disasm 0x403000\"}",
					"outputDataExample": "{\"command\": \"disasm 0x403000\"}"
				}
			],
			"description": "<ul><li>Understanding and manipulating a program's memory is essential for reverse engineering and malware analysis</li><li>- View a comprehensive map of the process's virtual memory, showing allocated regions, their sizes, permissions (read/write/execute), and associated modules</li><li>- Inspect and edit raw memory in multiple hexadecimal dump views</li><li>- Analyze the stack in a dedicated view to understand function arguments, return addresses, and local variables</li><li>- Follow pointers in memory or on the stack with a single click to navigate data structures</li></ul>",
			"simulationNodesAndEdges": {
