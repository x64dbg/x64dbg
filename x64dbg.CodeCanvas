			]
		},
		"d35163c0-dc71-413f-9ef2-5554329adbb9": {
			"path": "d35163c0-dc71-413f-9ef2-5554329adbb9",
			"cellName": "Config Flow: Debugger Core Stores Exception Filters - debugger.cpp:L356-359",
			"cellId": "d35163c0-dc71-413f-9ef2-5554329adbb9",
			"visible": true,
			"parentCellId": "abf8f82a-7554-4436-b28a-1a87bbf5d7c0"
		},
		"src/dbg/debugger.cpp-simstep-e6a43a3c-ea50-4ec4-bc77-733bc39a8fdb": {
			"path": "src/dbg/debugger.cpp-simstep-e6a43a3c-ea50-4ec4-bc77-733bc39a8fdb",
			"fileName": "debugger.cpp",
			"wiki": "The dbgaddexceptionfilter function appends the provided filter to the debugger's internal static vector of exception filters. This list is now active and will be used to handle subsequent exceptions in the debuggee.",
			"cellName": "Config Flow: Debugger Core Stores Exception Filters - debugger.cpp:L356-359",
			"cellId": "d35163c0-dc71-413f-9ef2-5554329adbb9",
			"visible": true,
			"startLine": 356,
			"endLine": 359,
			"parentCellId": "abf8f82a-7554-4436-b28a-1a87bbf5d7c0",
			"parentPath": "src/dbg/debugger.cpp",
			"simSteps": [
				{
					"simulationKey": "Exception Handling Control",
					"simStepId": "e6a43a3c-ea50-4ec4-bc77-733bc39a8fdb"
				}
			]
		},
		"9db3b47b-ed80-426b-bd1f-60b30ab58269": {
			"path": "9db3b47b-ed80-426b-bd1f-60b30ab58269",
			"cellName": "Runtime Flow: Exception Details Extracted - debugger.cpp:L2089-2094",
			"cellId": "9db3b47b-ed80-426b-bd1f-60b30ab58269",
			"visible": true,
			"parentCellId": "abf8f82a-7554-4436-b28a-1a87bbf5d7c0"
		},
		"src/dbg/debugger.cpp-simstep-e858e6f7-9a26-42b0-b734-9016be250747": {
			"path": "src/dbg/debugger.cpp-simstep-e858e6f7-9a26-42b0-b734-9016be250747",
			"fileName": "debugger.cpp",
			"wiki": "The cbException handler extracts key information from the debug event, such as the exception code and whether it is a first-chance or second-chance exception. This information will be used to find the appropriate filter.",
			"cellName": "Runtime Flow: Exception Details Extracted - debugger.cpp:L2089-2094",
			"cellId": "9db3b47b-ed80-426b-bd1f-60b30ab58269",
			"visible": true,
			"startLine": 2089,
			"endLine": 2094,
			"parentCellId": "abf8f82a-7554-4436-b28a-1a87bbf5d7c0",
			"parentPath": "src/dbg/debugger.cpp",
			"simSteps": [
				{
					"simulationKey": "Exception Handling Control",
					"simStepId": "e858e6f7-9a26-42b0-b734-9016be250747"
				}
			]
		},
		"39ec2033-2da2-47af-aed2-95fe1e962bd1": {
			"path": "39ec2033-2da2-47af-aed2-95fe1e962bd1",
			"cellName": "Runtime Flow: Filter is Looked Up - debugger.cpp:L361-389",
			"cellId": "39ec2033-2da2-47af-aed2-95fe1e962bd1",
			"visible": true,
			"parentCellId": "abf8f82a-7554-4436-b28a-1a87bbf5d7c0"
		},
		"src/dbg/debugger.cpp-simstep-9f7f64c3-e30f-4a36-a956-d0064b1fc86c": {
			"path": "src/dbg/debugger.cpp-simstep-9f7f64c3-e30f-4a36-a956-d0064b1fc86c",
			"fileName": "debugger.cpp",
			"wiki": "The dbggetexceptionfilter function iterates through the stored exceptionFilters vector, checking the range of each filter to find one that contains the current exception code. If no specific filter is found, a default catch-all filter is returned.",
			"cellName": "Runtime Flow: Filter is Looked Up - debugger.cpp:L361-389",
			"cellId": "39ec2033-2da2-47af-aed2-95fe1e962bd1",
			"visible": true,
			"startLine": 361,
			"endLine": 389,
			"parentCellId": "abf8f82a-7554-4436-b28a-1a87bbf5d7c0",
			"parentPath": "src/dbg/debugger.cpp",
			"simSteps": [
				{
					"simulationKey": "Exception Handling Control",
					"simStepId": "9f7f64c3-e30f-4a36-a956-d0064b1fc86c"
				}
			]
		},
		"ed7cd245-17e9-486d-83d4-5ac936f508b0": {
			"path": "ed7cd245-17e9-486d-83d4-5ac936f508b0",
			"cellName": "Runtime Flow: Debugger Decides Action Based on Filter - debugger.cpp:L2139-2147",
			"cellId": "ed7cd245-17e9-486d-83d4-5ac936f508b0",
			"visible": true,
			"parentCellId": "abf8f82a-7554-4436-b28a-1a87bbf5d7c0"
		},
		"src/dbg/debugger.cpp-simstep-2da6d10e-3a64-40ec-abe5-cc9f92070f9b": {
			"path": "src/dbg/debugger.cpp-simstep-2da6d10e-3a64-40ec-abe5-cc9f92070f9b",
			"fileName": "debugger.cpp",
			"wiki": "The cbException handler inspects the returned filter. In this scenario, it's a first-chance exception and the filter is set to 'Break on First Chance'. The logic determines that a break is required and sets the default continuation status based on the filter's 'handledBy' property.",
			"cellName": "Runtime Flow: Debugger Decides Action Based on Filter - debugger.cpp:L2139-2147",
			"cellId": "ed7cd245-17e9-486d-83d4-5ac936f508b0",
			"visible": true,
			"startLine": 2139,
			"endLine": 2147,
			"parentCellId": "abf8f82a-7554-4436-b28a-1a87bbf5d7c0",
			"parentPath": "src/dbg/debugger.cpp",
			"simSteps": [
				{
					"simulationKey": "Exception Handling Control",
					"simStepId": "2da6d10e-3a64-40ec-abe5-cc9f92070f9b"
				}
			]
		},
		"4231a8e5-569b-43f2-a860-b908a4d4f4d9": {
			"path": "4231a8e5-569b-43f2-a860-b908a4d4f4d9",
			"cellName": "Runtime Flow: Debugger Pauses and Awaits User Input - debugger.cpp:L2163-2171",
			"cellId": "4231a8e5-569b-43f2-a860-b908a4d4f4d9",
			"visible": true,
			"parentCellId": "abf8f82a-7554-4436-b28a-1a87bbf5d7c0"
		},
		"src/dbg/debugger.cpp-simstep-d8881b54-3c96-4ca7-a002-903e131b9bdc": {
			"path": "src/dbg/debugger.cpp-simstep-d8881b54-3c96-4ca7-a002-903e131b9bdc",
			"fileName": "debugger.cpp",
			"wiki": "Since the filter conditions for a break were met, the handler sets a flag indicating a pause on exception and calls dbgpause(), which halts the debuggee and updates the GUI to reflect the paused state, waiting for the user's command.",
			"cellName": "Runtime Flow: Debugger Pauses and Awaits User Input - debugger.cpp:L2163-2171",
			"cellId": "4231a8e5-569b-43f2-a860-b908a4d4f4d9",
			"visible": true,
			"startLine": 2163,
			"endLine": 2171,
			"parentCellId": "abf8f82a-7554-4436-b28a-1a87bbf5d7c0",
			"parentPath": "src/dbg/debugger.cpp",
			"simSteps": [
				{
					"simulationKey": "Exception Handling Control",
					"simStepId": "d8881b54-3c96-4ca7-a002-903e131b9bdc"
				}
			]
		},
		"0f9dc73c-6242-4bcb-bbf6-03efdb814b5b": {
			"path": "0f9dc73c-6242-4bcb-bbf6-03efdb814b5b",
			"cellName": "Runtime Flow: Continue Command is Processed - cmd-debug-control.cpp:L438-442",
			"cellId": "0f9dc73c-6242-4bcb-bbf6-03efdb814b5b",
