		"Exception Handling Control": {
			"name": "Exception Handling Control",
			"simSteps": [
				{
					"simStepId": "923044f5-e271-48fb-abf2-a6c57b5d1420",
					"diagramNodeId": "025a9a5c-2355-47e6-b091-ee4fb34ed045",
					"simStepLabel": "Config Flow: User Modifies Exception Filter",
					"simStepDescription": "The user interacts with the settings dialog to add a new exception filter. The dialog's logic adds the new filter to an in-memory list, merging it with any existing overlapping ranges and then refreshes the UI.",
					"isEdge": 0,
					"sourceCodeMapping": {
						"filePath": "src/gui/Src/Gui/SettingsDialog.cpp",
						"startLine": "508",
						"endLine": "531",
						"relevantVariables": [
							"filter",
							"settings.exceptionFilters",
							"UpdateExceptionListWidget"
						]
					},
					"inputDataExample": "{\"filter\": {\"range\": {\"start\": 3221225477, \"end\": 3221225477}, \"breakOn\": \"SecondChance\", \"logException\": true, \"handledBy\": \"Debuggee\"}}",
					"outputDataExample": "{\"status\": \"UI updated with new filter for exception 0xC0000005\"}"
				},
				{
					"simStepId": "e4c565d0-a3a3-4a14-bf5d-9e265c74e750",
					"diagramNodeId": "a8b9d8d7-7abd-4e69-81f4-79bcb01d6277",
					"simStepLabel": "Config Flow: Settings Data Prepared for Saving",
					"simStepDescription": "When the user clicks 'Save & Close', the settings dialog prepares to save the configuration. The list of exception filters is retrieved from the dialog's internal state to be serialized.",
					"isEdge": 1,
					"sourceCodeMapping": {
						"filePath": "src/gui/Src/Gui/SettingsDialog.cpp",
						"startLine": "409",
						"endLine": "410",
						"relevantVariables": [
							"settings.exceptionFilters"
						]
					},
					"inputDataExample": "{\"exceptionFilters\": [{\"range\": {\"start\": 0, \"end\": 0}, \"breakOn\": \"FirstChance\", \"logException\": true, \"handledBy\": \"Debuggee\"}, {\"range\": {\"start\": 3221225477, \"end\": 3221225477}, \"breakOn\": \"SecondChance\", \"logException\": true, \"handledBy\": \"Debuggee\"}]}",
					"outputDataExample": "{\"exceptionFilters\": [{\"range\": {\"start\": 0, \"end\": 0}, \"breakOn\": \"FirstChance\", \"logException\": true, \"handledBy\": \"Debuggee\"}, {\"range\": {\"start\": 3221225477, \"end\": 3221225477}, \"breakOn\": \"SecondChance\", \"logException\": true, \"handledBy\": \"Debuggee\"}]}"
				},
				{
					"simStepId": "31da5905-9136-48e9-acfe-030f36fd4616",
					"diagramNodeId": "ddaf5636-8f59-4f8f-a14d-2f70738d6749",
					"simStepLabel": "Config Flow: Exception Filters Serialized to String",
					"simStepDescription": "The list of ExceptionFilter objects is iterated, and each filter's properties (range, break-on chance, logging, handled-by status) are formatted into a single comma-separated string for storage in the configuration file.",
					"isEdge": 0,
					"sourceCodeMapping": {
						"filePath": "src/gui/Src/Gui/SettingsDialog.cpp",
						"startLine": "410",
						"endLine": "417",
						"relevantVariables": [
							"exceptionRange",
							"filter",
							"BridgeSettingSet"
						]
					},
					"inputDataExample": "{\"exceptionFilters\": [{\"range\": {\"start\": 0, \"end\": 0}, \"breakOn\": \"FirstChance\", \"logException\": true, \"handledBy\": \"Debuggee\"}, {\"range\": {\"start\": 3221225477, \"end\": 3221225477}, \"breakOn\": \"SecondChance\", \"logException\": true, \"handledBy\": \"Debuggee\"}]}",
					"outputDataExample": "{\"exceptionRangeString\": \"00000000-00000000:first:log:debuggee,C0000005-C0000005:second:log:debuggee,\"}"
				},
				{
					"simStepId": "302a3d1f-ad1e-49e1-9c53-2c9af033572c",
					"diagramNodeId": "c94315f8-126d-47a9-9755-5c6a08855ecf",
					"simStepLabel": "Config Flow: Configuration Update Signal Sent",
					"simStepDescription": "After the settings are written to the configuration file, a global update signal, DbgSettingsUpdated(), is dispatched to notify the debugger backend that it needs to reload its configuration.",
					"isEdge": 1,
					"sourceCodeMapping": {
						"filePath": "src/gui/Src/Gui/SettingsDialog.cpp",
						"startLine": "504",
						"endLine": "504",
						"relevantVariables": [
							"DbgSettingsUpdated"
						]
					},
					"inputDataExample": "{}",
					"outputDataExample": "{}"
				},
				{
					"simStepId": "00d3408e-5903-429b-9c09-d396735bcb05",
					"diagramNodeId": "0e225205-f0b3-4e60-bc32-9444a690ec6d",
					"simStepLabel": "Config Flow: Backend Receives Update and Reads Settings",
					"simStepDescription": "The debugger backend's message handler receives the DBG_SETTINGS_UPDATED message. It then calls BridgeSettingGet to read the serialized exception filter string from the configuration.",
					"isEdge": 0,
					"sourceCodeMapping": {
						"filePath": "src/dbg/_exports.cpp",
						"startLine": "1101",
						"endLine": "1103",
						"relevantVariables": [
							"DBG_SETTINGS_UPDATED",
							"BridgeSettingGet",
							"settingText"
						]
					},
					"inputDataExample": "{\"type\": \"DBG_SETTINGS_UPDATED\"}",
					"outputDataExample": "{\"settingText\": \"00000000-00000000:first:log:debuggee,C0000005-C0000005:second:log:debuggee,\"}"
				},
				{
					"simStepId": "0cb52207-5ecf-4355-b8ba-88a4025fc395",
					"diagramNodeId": "d810cc18-cddc-4c73-9186-9a2f4ff2afe8",
					"simStepLabel": "Config Flow: Serialized String Passed to Parser",
					"simStepDescription": "The raw string containing the exception filter data is passed to the parsing logic, which uses strtok_s to split it into individual filter entries.",
					"isEdge": 1,
					"sourceCodeMapping": {
						"filePath": "src/dbg/_exports.cpp",
						"startLine": "1104",
						"endLine": "1104",
						"relevantVariables": [
							"settingText",
							"entry",
							"strtok_s"
						]
					},
					"inputDataExample": "{\"settingText\": \"00000000-00000000:first:log:debuggee,C0000005-C0000005:second:log:debuggee,\"}",
					"outputDataExample": "{\"settingText\": \"00000000-00000000:first:log:debuggee,C0000005-C0000005:second:log:debuggee,\"}"
				},
				{
					"simStepId": "d4ec81fd-91b4-438a-ba5e-45d29b70204d",
					"diagramNodeId": "f225cc3e-0917-4292-90f0-6ea5bb5fbc95",
					"simStepLabel": "Config Flow: Backend Deserializes String into Filter Objects",
					"simStepDescription": "The backend code iterates through each entry in the serialized string, using sscanf_s and string comparisons to parse the values and construct structured ExceptionFilter objects.",
					"isEdge": 0,
					"sourceCodeMapping": {
						"filePath": "src/dbg/_exports.cpp",
						"startLine": "1105",
						"endLine": "1133",
						"relevantVariables": [
							"entry",
							"sscanf_s",
							"filter"
						]
					},
					"inputDataExample": "{\"entry\": \"C0000005-C0000005:second:nolog:debuggee\"}",
					"outputDataExample": "{\"filter\": {\"range\": {\"start\": 3221225477, \"end\": 3221225477}, \"breakOn\": \"SecondChance\", \"logException\": false, \"handledBy\": \"Debuggee\"}}"
				},
				{
					"simStepId": "68779466-be79-4bc8-9705-c7a494456230",
					"diagramNodeId": "b54ebabc-bbc3-47ef-80fc-a248c0d13c26",
					"simStepLabel": "Config Flow: Filter Object Sent to Debugger Core",
					"simStepDescription": "Each newly created ExceptionFilter object is passed to the debugger core via the dbgaddexceptionfilter function to be added to the active list of filters.",
					"isEdge": 1,
					"sourceCodeMapping": {
						"filePath": "src/dbg/_exports.cpp",
						"startLine": "1129",
						"endLine": "1129",
						"relevantVariables": [
							"dbgaddexceptionfilter",
							"filter"
						]
					},
					"inputDataExample": "{\"filter\": {\"range\": {\"start\": 3221225477, \"end\": 3221225477}, \"breakOn\": \"SecondChance\", \"logException\": false, \"handledBy\": \"Debuggee\"}}",
					"outputDataExample": "{\"filter\": {\"range\": {\"start\": 3221225477, \"end\": 3221225477}, \"breakOn\": \"SecondChance\", \"logException\": false, \"handledBy\": \"Debuggee\"}}"
				},
				{
					"simStepId": "e6a43a3c-ea50-4ec4-bc77-733bc39a8fdb",
					"diagramNodeId": "d35163c0-dc71-413f-9ef2-5554329adbb9",
					"simStepLabel": "Config Flow: Debugger Core Stores Exception Filters",
					"simStepDescription": "The dbgaddexceptionfilter function appends the provided filter to the debugger's internal static vector of exception filters. This list is now active and will be used to handle subsequent exceptions in the debuggee.",
					"isEdge": 0,
					"sourceCodeMapping": {
						"filePath": "src/dbg/debugger.cpp",
						"startLine": "356",
						"endLine": "359",
						"relevantVariables": [
							"exceptionFilters",
							"filter"
						]
					},
					"inputDataExample": "{\"filter\": {\"range\": {\"start\": 3221225477, \"end\": 3221225477}, \"breakOn\": \"SecondChance\", \"logException\": false, \"handledBy\": \"Debuggee\"}}",
					"outputDataExample": "{\"exceptionFilters\": [{\"range\": {...}}, {\"range\": {...}}]}"
				},
				{
					"simStepId": "c45fceea-f0f3-44dd-a2cb-3d1e9aa9a8e0",
					"diagramNodeId": "c47e1225-d66a-4d2c-aa40-79d17f7d74d3",
					"simStepLabel": "Runtime Flow: Exception Debug Event Received",
					"simStepDescription": "The operating system reports an exception in the debugged process. The debugger engine receives this as an EXCEPTION_DEBUG_EVENT and passes the event data to the main exception callback handler.",
					"isEdge": 1,
					"sourceCodeMapping": {
						"filePath": "src/dbg/debugger.cpp",
						"startLine": "2174",
						"endLine": "2182",
						"relevantVariables": [
							"cbDebugEvent",
							"DebugEvent",
							"cbException"
						]
					},
					"inputDataExample": "{\"DebugEvent\": {\"EventType\": \"EXCEPTION_DEBUG_EVENT\", \"dwProcessId\": 4812, \"dwThreadId\": 7340, \"Exception\": {\"ExceptionRecord\": {\"ExceptionCode\": \"0xC0000005\", \"ExceptionAddress\": \"0x00401500\"}, \"dwFirstChance\": 1}}}",
					"outputDataExample": "{\"DebugEvent\": {\"EventType\": \"EXCEPTION_DEBUG_EVENT\", \"dwProcessId\": 4812, \"dwThreadId\": 7340, \"Exception\": {\"ExceptionRecord\": {\"ExceptionCode\": \"0xC0000005\", \"ExceptionAddress\": \"0x00401500\"}, \"dwFirstChance\": 1}}}"
				},
				{
					"simStepId": "e858e6f7-9a26-42b0-b734-9016be250747",
					"diagramNodeId": "9db3b47b-ed80-426b-bd1f-60b30ab58269",
					"simStepLabel": "Runtime Flow: Exception Details Extracted",
					"simStepDescription": "The cbException handler extracts key information from the debug event, such as the exception code and whether it is a first-chance or second-chance exception. This information will be used to find the appropriate filter.",
					"isEdge": 0,
					"sourceCodeMapping": {
						"filePath": "src/dbg/debugger.cpp",
						"startLine": "2089",
						"endLine": "2094",
						"relevantVariables": [
							"ExceptionData",
							"ExceptionCode",
							"FirstChance"
						]
					},
					"inputDataExample": "{\"ExceptionData\": {\"ExceptionRecord\": {\"ExceptionCode\": \"0xC0000005\", \"ExceptionAddress\": \"0x00401500\"}, \"dwFirstChance\": 1}}",
					"outputDataExample": "{\"ExceptionCode\": \"0xC0000005\", \"isFirstChance\": true}"
				},
				{
					"simStepId": "72228888-e055-49c1-91ce-1636b2b0fd80",
					"diagramNodeId": "ac3ff52e-5685-4487-9b70-1249dc7bc832",
					"simStepLabel": "Runtime Flow: Exception Code Passed for Filtering",
					"simStepDescription": "The extracted exception code is passed to the dbggetexceptionfilter function to look up the corresponding handling rule from the list of configured filters.",
					"isEdge": 1,
					"sourceCodeMapping": {
						"filePath": "src/dbg/debugger.cpp",
						"startLine": "2102",
						"endLine": "2102",
						"relevantVariables": [
							"dbggetexceptionfilter",
							"ExceptionCode"
						]
					},
					"inputDataExample": "{\"ExceptionCode\": \"0xC0000005\"}",
					"outputDataExample": "{\"ExceptionCode\": \"0xC0000005\"}"
				},
				{
					"simStepId": "9f7f64c3-e30f-4a36-a956-d0064b1fc86c",
					"diagramNodeId": "39ec2033-2da2-47af-aed2-95fe1e962bd1",
					"simStepLabel": "Runtime Flow: Filter is Looked Up",
					"simStepDescription": "The dbggetexceptionfilter function iterates through the stored exceptionFilters vector, checking the range of each filter to find one that contains the current exception code. If no specific filter is found, a default catch-all filter is returned.",
					"isEdge": 0,
					"sourceCodeMapping": {
						"filePath": "src/dbg/debugger.cpp",
						"startLine": "361",
						"endLine": "389",
						"relevantVariables": [
							"exceptionFilters",
							"exception",
							"filter"
						]
					},
					"inputDataExample": "{\"exception\": \"0xC0000005\"}",
					"outputDataExample": "{\"filter\": {\"range\": {\"start\": 3221225477, \"end\": 3221225477}, \"breakOn\": \"FirstChance\", \"logException\": true, \"handledBy\": \"Debuggee\"}}"
				},
				{
					"simStepId": "8f8985fc-9d10-4bc1-af23-0ac2caaa02b6",
					"diagramNodeId": "880b100c-6cf4-4e2a-b4e6-5f5c602441ab",
					"simStepLabel": "Runtime Flow: Matching Filter Configuration Returned",
					"simStepDescription": "The ExceptionFilter object that matches the exception code is returned to the main exception handler.",
					"isEdge": 1,
					"sourceCodeMapping": {
						"filePath": "src/dbg/debugger.cpp",
						"startLine": "370",
						"endLine": "370",
						"relevantVariables": [
							"return filter"
						]
					},
					"inputDataExample": "{\"filter\": {\"range\": {\"start\": 3221225477, \"end\": 3221225477}, \"breakOn\": \"FirstChance\", \"logException\": true, \"handledBy\": \"Debuggee\"}}",
					"outputDataExample": "{\"filter\": {\"range\": {\"start\": 3221225477, \"end\": 3221225477}, \"breakOn\": \"FirstChance\", \"logException\": true, \"handledBy\": \"Debuggee\"}}"
				},
				{
					"simStepId": "2da6d10e-3a64-40ec-abe5-cc9f92070f9b",
					"diagramNodeId": "ed7cd245-17e9-486d-83d4-5ac936f508b0",
					"simStepLabel": "Runtime Flow: Debugger Decides Action Based on Filter",
					"simStepDescription": "The cbException handler inspects the returned filter. In this scenario, it's a first-chance exception and the filter is set to 'Break on First Chance'. The logic determines that a break is required and sets the default continuation status based on the filter's 'handledBy' property.",
					"isEdge": 0,
					"sourceCodeMapping": {
						"filePath": "src/dbg/debugger.cpp",
						"startLine": "2139",
						"endLine": "2147",
						"relevantVariables": [
							"filter",
							"FirstChance",
							"dbgsetcontinuestatus",
							"DBG_EXCEPTION_NOT_HANDLED"
						]
					},
					"inputDataExample": "{\"filter\": {\"breakOn\": \"FirstChance\", \"handledBy\": \"Debuggee\"}, \"isFirstChance\": true}",
					"outputDataExample": "{\"action\": \"break\", \"continueStatus\": \"DBG_EXCEPTION_NOT_HANDLED\"}"
				},
				{
					"simStepId": "174405f1-6684-4bc7-8df4-aa15c552e625",
					"diagramNodeId": "474c8f65-6417-4c89-ab71-c50258cae589",
					"simStepLabel": "Runtime Flow: Default Continue Status is Set",
					"simStepDescription": "The dbgsetcontinuestatus function is called to set the initial continuation status. This value will be used if the user resumes execution without explicitly overriding it. 'DBG_EXCEPTION_NOT_HANDLED' means the exception will be passed to the application's handlers.",
					"isEdge": 1,
					"sourceCodeMapping": {
						"filePath": "src/dbg/debugger.cpp",
						"startLine": "2145",
						"endLine": "2145",
						"relevantVariables": [
							"dbgsetcontinuestatus"
						]
					},
					"inputDataExample": "{\"status\": \"DBG_EXCEPTION_NOT_HANDLED\"}",
					"outputDataExample": "{\"status\": \"DBG_EXCEPTION_NOT_HANDLED\"}"
				},
				{
					"simStepId": "d8881b54-3c96-4ca7-a002-903e131b9bdc",
					"diagramNodeId": "4231a8e5-569b-43f2-a860-b908a4d4f4d9",
					"simStepLabel": "Runtime Flow: Debugger Pauses and Awaits User Input",
					"simStepDescription": "Since the filter conditions for a break were met, the handler sets a flag indicating a pause on exception and calls dbgpause(), which halts the debuggee and updates the GUI to reflect the paused state, waiting for the user's command.",
					"isEdge": 0,
					"sourceCodeMapping": {
						"filePath": "src/dbg/debugger.cpp",
						"startLine": "2163",
						"endLine": "2171",
						"relevantVariables": [
							"bPausedOnException",
							"dbgpause"
						]
					},
					"inputDataExample": "{\"filterDecision\": \"break\"}",
					"outputDataExample": "{\"debuggerState\": \"paused\", \"reason\": \"First chance exception 0xC0000005\"}"
				},
				{
					"simStepId": "b6cefdb3-cfa7-4783-9a7e-49e943eb4c89",
					"diagramNodeId": "184155d4-634a-4ccf-bb4e-5af884f72663",
					"simStepLabel": "Runtime Flow: User Issues Command to Swallow Exception",
					"simStepDescription": "The user decides to prevent the application from seeing the exception and types 'DebugContinue 0' in the command bar. This command is sent to the debugger's command processor.",
					"isEdge": 1,
					"sourceCodeMapping": {
						"filePath": "src/dbg/x64dbg.cpp",
						"startLine": "135",
						"endLine": "135",
						"relevantVariables": [
							"dbgcmdnew",
							"cbDebugContinue"
						]
					},
					"inputDataExample": "{\"command\": \"DebugContinue\", \"args\": [\"0\"]}",
					"outputDataExample": "{\"command\": \"DebugContinue\", \"args\": [\"0\"]}"
				},
				{
					"simStepId": "1d2b30d4-b3b4-4396-96c5-8e9123347574",
					"diagramNodeId": "0f9dc73c-6242-4bcb-bbf6-03efdb814b5b",
					"simStepLabel": "Runtime Flow: Continue Command is Processed",
					"simStepDescription": "The cbDebugContinue command handler executes. It parses the argument '0' and determines that the user wants the debugger to handle the exception. It then calls dbgsetcontinuestatus with DBG_CONTINUE, overriding the default.",
					"isEdge": 0,
					"sourceCodeMapping": {
						"filePath": "src/dbg/commands/cmd-debug-control.cpp",
						"startLine": "438",
						"endLine": "442",
						"relevantVariables": [
							"cbDebugContinue",
							"dbgsetcontinuestatus",
							"DBG_CONTINUE"
						]
					},
					"inputDataExample": "{\"argc\": 2, \"argv\": [\"DebugContinue\", \"0\"]}",
					"outputDataExample": "{\"newContinueStatus\": \"DBG_CONTINUE\"}"
				},
				{
					"simStepId": "7cd9e211-adb2-45cd-b794-983a1c9abee7",
					"diagramNodeId": "",
					"simStepLabel": "Runtime Flow: Final Continue Status Propagated",
					"simStepDescription": "The call to dbgsetcontinuestatus updates the global 'nextContinueStatus' variable to DBG_CONTINUE. This is the final status that will be sent to the operating system upon resuming the debuggee.",
					"isEdge": 1,
					"sourceCodeMapping": {
						"filePath": "src/dbg/commands/cmd-debug-control.cpp",
						"startLine": "441",
						"endLine": "441",
						"relevantVariables": [
							"dbgsetcontinuestatus"
						]
					},
					"inputDataExample": "{\"status\": \"DBG_CONTINUE\"}",
					"outputDataExample": "{\"status\": \"DBG_CONTINUE\"}"
				}
			],
			"description": "<ul><li>Malware and protected applications often use exceptions for anti-debugging or control flow</li><li>This feature gives the analyst control over them</li><li>- View the application's Structured Exception Handling (SEH) chain</li><li>- Configure the debugger to ignore specific exception codes or entire ranges of codes</li><li>- Set breakpoints that trigger on first-chance or second-chance exceptions</li><li>- Choose whether to pass an exception on to the application or have the debugger handle it, effectively swallowing it</li></ul>",
