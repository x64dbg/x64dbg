							"cmdget",
							"found"
						]
					},
					"inputDataExample": "{\"commandToFind\": \"run\"}",
					"outputDataExample": "{\"foundCommand\": {\"name\": \"run\", \"cbCommand\": \"0x00401234\", \"debugonly\": true}}"
				},
				{
					"simStepId": "0f823e8a-1529-4b40-91de-4ed9c76a9413",
					"diagramNodeId": "886774e3-9254-44e1-a76c-2bdc07322889",
					"simStepLabel": "Data Flow: Command Details to Executor",
					"simStepDescription": "Once the appropriate command handler (callback function) is found, the full command string is passed to an execution wrapper function that will parse its arguments and invoke the callback.",
					"isEdge": 1,
					"sourceCodeMapping": {
						"filePath": "src/dbg/command.cpp",
						"startLine": "255",
						"endLine": "257",
						"relevantVariables": [
							"cmdexeccallback",
							"cmd",
							"command"
						]
					},
					"inputDataExample": "{\"foundCommand\": {\"name\": \"run\", \"cbCommand\": \"0x00401234\", \"debugonly\": true}, \"fullCommandString\": \"run\"}",
					"outputDataExample": "{\"foundCommand\": {\"name\": \"run\", \"cbCommand\": \"0x00401234\", \"debugonly\": true}, \"fullCommandString\": \"run\"}"
				},
				{
					"simStepId": "f30cce4b-bd11-4120-b416-d029b1e22f53",
					"diagramNodeId": "3d88bcb6-9da5-420d-bfc6-65d66bd44a8a",
					"simStepLabel": "Backend: Command Execution",
					"simStepDescription": "The `cmdexeccallback` function parses the command string into arguments (argc, argv format) and then invokes the `cbCommand` function pointer that was retrieved in the lookup step. This executes the specific logic for the 'run' command, which in this case is handled by `cbDebugRunInternal`.",
					"isEdge": 0,
					"sourceCodeMapping": {
						"filePath": "src/dbg/command.cpp",
						"startLine": "255",
						"endLine": "274",
						"relevantVariables": [
