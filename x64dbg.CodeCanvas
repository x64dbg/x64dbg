					"inputDataExample": "{\"path\": \"C:\\\\symbols\\\\ntdll.pdb\\\\...\\\\ntdll.pdb\", \"modname\": \"ntdll.dll\", \"imageBase\": \"0x77000000\", \"imageSize\": \"0x180000\", \"validationData\": {\"guid\": \"{C135A427-...}\", \"signature\": 0, \"age\": 1}}",
					"outputDataExample": "{\"path\": \"C:\\\\symbols\\\\ntdll.pdb\\\\...\\\\ntdll.pdb\", \"modname\": \"ntdll.dll\", \"imageBase\": \"0x77000000\", \"imageSize\": \"0x180000\", \"validationData\": {\"guid\": \"{C135A427-...}\", \"signature\": 0, \"age\": 1}}"
				},
				{
					"simStepId": "300dd94c-342c-48e5-bf62-1cee735f5d0e",
					"diagramNodeId": "ea163a31-383d-4138-91dc-dec14cb167a5",
					"simStepLabel": "[Auto-load] Validate PDB and Start Async Parsing",
					"simStepDescription": "The `SymbolSourceDIA::loadPDB` function first validates that the provided PDB file matches the module using `PDBDiaFile::open`. If validation is successful, it creates background threads (`SymbolsThread`, `SourceLinesThread`) to parse the symbols and source line information asynchronously, preventing the UI from freezing.",
					"isEdge": 0,
					"sourceCodeMapping": {
