					"diagramNodeId": "78fefa8a-77e5-4053-a8f8-bf29ddf18af1",
					"simStepLabel": "GUI: User Action Initiates Command",
					"simStepDescription": "A user interaction within the GUI, such as clicking a menu item or a button, triggers a function call that prepares to execute a command. In this example, selecting 'Run' from the debug menu calls the `runSlot` function which then executes the 'run' command.",
					"isEdge": 0,
					"sourceCodeMapping": {
						"filePath": "src/gui/Src/Gui/MainWindow.cpp",
						"startLine": "1353",
